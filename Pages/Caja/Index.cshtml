@page
@model Wamani.Reservas.Pages.Caja.IndexModel
@{
    ViewData["Title"] = "Caja";
    var ci = System.Globalization.CultureInfo.GetCultureInfo("es-AR");
    string Money(decimal m) => "$ " + m.ToString("N0", ci);
}

<div class="toolbar">
    <div>
        <h1>Caja y patrimonio</h1>
        <p class="subtitle" style="margin:0">Todo lo que entró menos todo lo que salió, y lo que retiraron los socios.</p>
    </div>
</div>

<!-- Resumen -->
<div class="fin-cards">
    <div class="fin-card">
        <div class="fin-label">Ingresos (histórico)</div>
        <div class="fin-val">@Money(Model.Ingresos)</div>
    </div>
    <div class="fin-card">
        <div class="fin-label">Egresos (histórico)</div>
        <div class="fin-val" style="color:var(--warn)">@Money(Model.Egresos)</div>
    </div>
    <div class="fin-card">
        <div class="fin-label">Caja (ingresos − egresos)</div>
        <div class="fin-val">@Money(Model.Caja)</div>
    </div>
    <div class="fin-card fin-card-net">
        <div class="fin-label">Capital / Patrimonio</div>
        <div class="fin-val" style="color:var(--accent)">@Money(Model.Patrimonio)</div>
        @if (Model.RetirosTotal > 0)
        {
            <div class="fin-label" style="margin-top:4px">ya restados @Money(Model.RetirosTotal) de retiros</div>
        }
    </div>
</div>

<div class="card" style="margin-top:4px">
    <p style="margin:0;color:var(--ink-soft)">
        <strong>Capital / Patrimonio</strong> = lo que tiene la empresa hoy = Caja @Money(Model.Caja) − Retiros @Money(Model.RetirosTotal) =
        <strong style="color:var(--accent)">@Money(Model.Patrimonio)</strong>.
    </p>
</div>

@if (!string.IsNullOrEmpty(Model.Aviso))
{
    <div class="aviso-ok" style="margin-top:18px">@Model.Aviso</div>
}

<!-- Registrar un retiro -->
<div class="card" style="margin-top:18px">
    <h2>Registrar un retiro</h2>
    <p class="hint" style="margin:-8px 0 14px">Cuando un socio saca plata del capital de la empresa.</p>
    <form method="post" enctype="multipart/form-data" asp-page-handler="Agregar">
        <div class="form-grid">
            <div class="field"><label>Fecha</label><input asp-for="NuevoFecha" type="date" /></div>
            <div class="field"><label>Quién retiró</label><input asp-for="NuevoQuien" placeholder="Ej: Lautaro" /></div>
            <div class="field full"><label>Motivo / nota (opcional)</label><input asp-for="NuevoDescripcion" placeholder="Ej: Retiro de ganancias" /></div>
            <div class="field"><label>Monto</label><input asp-for="NuevoMonto" type="number" step="0.01" min="0" /></div>
            <div class="field"><label>Comprobante (opcional)</label><input asp-for="NuevoComprobante" type="file" accept="image/*,.pdf" /></div>
        </div>
        <div class="acciones-form" style="margin-top:12px">
            <button type="submit" class="btn btn-primary">+ Registrar retiro</button>
        </div>
    </form>
</div>

<!-- Lista de retiros -->
<div class="table-wrap" style="margin-top:18px">
    <table class="tabla">
        <thead>
            <tr><th>Fecha</th><th>Quién</th><th>Motivo</th><th class="num">Monto</th><th>Comprobante</th><th></th></tr>
        </thead>
        <tbody>
        @if (Model.Lista.Count == 0)
        {
            <tr><td colspan="6" style="text-align:center;color:var(--muted);padding:30px">Todavía no hay retiros registrados.</td></tr>
        }
        @foreach (var r in Model.Lista)
        {
            <tr>
                <td data-label="Fecha">@r.Fecha.ToString("dd/MM/yy")</td>
                <td data-label="Quién">@(string.IsNullOrEmpty(r.Quien) ? "—" : r.Quien)</td>
                <td data-label="Motivo">@(string.IsNullOrEmpty(r.Descripcion) ? "—" : r.Descripcion)</td>
                <td class="num" data-label="Monto" style="color:var(--warn)">@Money(r.Monto)</td>
                <td data-label="Comprobante">
                    @if (!string.IsNullOrEmpty(r.Comprobante))
                    {
                        <a href="@r.Comprobante" target="_blank" class="hint">✔ ver</a>
                    }
                    else
                    {
                        <span class="cliente-sub">—</span>
                    }
                </td>
                <td>
                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@r.Id" style="display:inline"
                          onsubmit="return confirm('¿Borrar este retiro?');">
                        <button type="submit" class="btn-mini btn-mini-danger">Quitar</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
        @if (Model.Lista.Count > 0)
        {
            <tfoot>
                <tr>
                    <td colspan="3"><strong>Total retirado</strong></td>
                    <td class="num"><strong style="color:var(--warn)">@Money(Model.RetirosTotal)</strong></td>
                    <td colspan="2"></td>
                </tr>
            </tfoot>
        }
    </table>
</div>
