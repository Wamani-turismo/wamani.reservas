@page
@model Wamani.Reservas.Pages.Compromisos.IndexModel
@{
    ViewData["Title"] = "Compromisos";
    var ci = System.Globalization.CultureInfo.GetCultureInfo("es-AR");
    string Money(decimal m) => "$ " + m.ToString("N0", ci);
    string Dia(DateTime d) => d.ToString("dd/MM/yy", ci);
    var chipEstimado = "display:inline-block;padding:1px 7px;border-radius:999px;font-size:11px;font-weight:600;color:#fff;background:var(--warn)";
    var chipArmado = "display:inline-block;padding:1px 7px;border-radius:999px;font-size:11px;font-weight:600;color:var(--ink-soft);border:1px solid var(--line)";
}

<div class="toolbar">
    <div>
        <h1>Compromisos</h1>
        <p class="subtitle" style="margin:0">
            Lo que Wamani tiene comprometido de acá en adelante: la plata que hay en caja hoy,
            más lo que falta cobrar de las salidas que todavía no salieron, menos lo que van a
            costar esas salidas.
        </p>
    </div>
</div>

<!-- Resumen -->
<div class="fin-cards">
    <div class="fin-card">
        <div class="fin-label">Caja hoy</div>
        <div class="fin-val">@Money(Model.CajaHoy)</div>
        <div class="fin-label" style="margin-top:4px">lo ya cobrado menos lo ya pagado</div>
    </div>
    <div class="fin-card">
        <div class="fin-label">+ Falta cobrar</div>
        <div class="fin-val" style="color:var(--ok)">@Money(Model.PorCobrar)</div>
        <div class="fin-label" style="margin-top:4px">@Model.Cobros.Count saldo(s) de reservas</div>
    </div>
    <div class="fin-card">
        <div class="fin-label">− Falta pagar</div>
        <div class="fin-val" style="color:var(--warn)">@Money(Model.PorPagar)</div>
        <details style="margin-top:4px">
            <summary class="fin-label" style="cursor:pointer">
                el teórico de @Model.Salidas.Count salida(s), menos lo ya pagado · ver de cuáles
            </summary>
            <div style="margin-top:8px;font-size:.82rem;color:var(--ink-soft)">
                <p style="margin:0 0 8px">
                    <strong>Es el teórico de la excursión</strong>, no lo cargado en el operativo:
                    la plantilla por los pasajeros de cada salida, menos lo que ya se pagó.
                </p>
                @foreach (var s in Model.Salidas)
                {
                    <div style="display:flex;justify-content:space-between;gap:10px;padding:3px 0;border-bottom:1px solid var(--line)">
                        <span>
                            @Dia(s.Fecha) · @s.Excursion
                            @if (s.OperativoVacio)
                            {
                                <span style="color:var(--warn)"> (sin armar)</span>
                            }
                        </span>
                        <strong style="white-space:nowrap">@Money(s.Falta)</strong>
                    </div>
                }
                <div style="display:flex;justify-content:space-between;gap:10px;padding:6px 0">
                    <span><strong>Total a pagar</strong></span>
                    <strong style="white-space:nowrap">@Money(Model.PorPagar)</strong>
                </div>
            </div>
        </details>
    </div>
    <div class="fin-card fin-card-net">
        <div class="fin-label">Plata neta proyectada</div>
        <div class="fin-val" style="color:var(--accent)">@Money(Model.Proyectado)</div>
        <div class="fin-label" style="margin-top:4px">cuando termines de cobrar y pagar todo</div>
    </div>
</div>

<div class="card" style="margin-top:4px">
    <p style="margin:0;color:var(--ink-soft)">
        <strong>Proyectado</strong> = Caja hoy @Money(Model.CajaHoy)
        + falta cobrar @Money(Model.PorCobrar)
        − falta pagar @Money(Model.PorPagar)
        = <strong>@Money(Model.Proyectado)</strong>.
    </p>
    <p style="margin:8px 0 0;color:var(--ink-soft)">
        El costo de cada salida se proyecta con <strong>el teórico de la excursión</strong> —la
        plantilla multiplicada por los pasajeros de esa salida, el mismo número de Rentabilidad—
        y recién después se le descuenta lo que ya se pagó. <strong>Que todavía no se haya
        elegido el guía o el hospedaje no significa que no haya que pagarlos:</strong> por eso no
        se usa lo cargado en el operativo, que puede estar a medio armar. Si en una salida se
        pagó más que el teórico, no falta nada: ese excedente se arregla en el operativo de la
        salida.
    </p>
    <p style="margin:8px 0 0;color:var(--ink-soft)">
        Acá <strong>no entra nada de la estructura</strong>: publicidad, agencia, contador,
        seguro y nafta no son un compromiso con nadie. Eso se paga con lo que quede.
    </p>
    @if (Model.SalidasSinOperativo > 0)
    {
        <p style="margin:8px 0 0;color:var(--ink-soft)">
            De lo que falta pagar, <strong>@Money(Model.FaltaEstimado)</strong> son
            @Model.SalidasSinOperativo salida(s) <strong>sin nada cargado en el operativo</strong>:
            ahí el número es íntegramente la estimación de la plantilla. A medida que cargues los
            proveedores de verdad el total casi no se va a mover, pero vas a saber a quién le debés
            cada peso.
        </p>
    }
    @if (Model.HistoricoIgnorado > 0)
    {
        <p style="margin:8px 0 0;color:var(--ink-soft)">
            No se cuentan @Money(Model.HistoricoIgnorado) de @Model.SalidasHistoricas salida(s)
            <strong>anteriores al sistema</strong> (las de "Reservas Históricas"): esas ya se
            pagaron en su momento, fuera del sistema.
        </p>
    }
</div>

@if (Model.CobrarVencido > 0 || Model.PagarVencido > 0)
{
    <div class="aviso-ok" style="background:var(--warn-bg,#fff4e5);border-color:var(--warn)">
        <strong>Colgado de salidas que ya pasaron.</strong>
        Esto <em>no</em> entra en la proyección de arriba —el compromiso es a futuro— pero conviene
        revisarlo en el operativo de cada salida:
        @if (Model.CobrarVencido > 0)
        {
            <span>hay <strong>@Money(Model.CobrarVencido)</strong> sin cobrar.</span>
        }
        @if (Model.PagarVencido > 0)
        {
            <span>
                Hay <strong>@Money(Model.PagarVencido)</strong> sin pagar en
                @Model.SalidasVencidas salida(s), que puede ser plata que falta de verdad o un
                tilde que quedó sin poner.
            </span>
        }
    </div>
}

<!-- Falta cobrar -->
<div class="card" style="margin-top:12px">
    <h2 style="margin-top:0">Falta cobrar (saldos de reservas)</h2>
    <p class="subtitle">Normalmente es el 50% que queda después de la seña.</p>

    @if (Model.Cobros.Count == 0)
    {
        <p style="color:var(--ink-soft)">No queda nada por cobrar de las salidas que vienen.</p>
    }
    else
    {
        <table class="tabla">
            <thead>
                <tr>
                    <th>Sale</th><th>Excursión</th><th>Pasajero</th>
                    <th style="text-align:right">Pers.</th>
                    <th style="text-align:right">Total</th>
                    <th style="text-align:right">Cobrado</th>
                    <th style="text-align:right">Falta cobrar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Cobros)
                {
                    <tr>
                        <td>@Dia(c.Fecha)</td>
                        <td>@c.Excursion</td>
                        <td>@c.Cliente</td>
                        <td style="text-align:right">@c.Personas</td>
                        <td style="text-align:right">@Money(c.Total)</td>
                        <td style="text-align:right">@Money(c.Cobrado)</td>
                        <td style="text-align:right"><strong>@Money(c.Falta)</strong></td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="6" style="text-align:right"><strong>Total a cobrar</strong></td>
                    <td style="text-align:right"><strong>@Money(Model.PorCobrar)</strong></td>
                </tr>
            </tfoot>
        </table>
    }
</div>

<!-- Falta pagar: salida por salida, al teórico -->
<div class="card" style="margin-top:12px">
    <h2 style="margin-top:0">Falta pagar (salida por salida)</h2>
    <p class="subtitle">
        Lo que va a costar cada salida según la plantilla de su excursión, menos la plata que ya
        salió por ella. El detalle ítem por ítem está en el operativo de cada salida.
    </p>

    @if (Model.Salidas.Count == 0)
    {
        <p style="color:var(--ink-soft)">No hay salidas vendidas de acá en adelante.</p>
    }
    else
    {
        <table class="tabla">
            <thead>
                <tr>
                    <th>Sale</th><th>Excursión</th>
                    <th style="text-align:right">Pers.</th>
                    <th style="text-align:right">Teórico</th>
                    <th style="text-align:right">Ya pagado</th>
                    <th style="text-align:right">Falta pagar</th>
                    <th>Operativo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Salidas)
                {
                    <tr>
                        <td>@Dia(s.Fecha)</td>
                        <td>@s.Excursion</td>
                        <td style="text-align:right">@s.Personas</td>
                        <td style="text-align:right">@Money(s.Teorico)</td>
                        <td style="text-align:right">@Money(s.Pagado)</td>
                        <td style="text-align:right"><strong>@Money(s.Falta)</strong></td>
                        <td>
                            @if (s.OperativoVacio)
                            {
                                <span style="@chipEstimado">sin armar</span>
                            }
                            else
                            {
                                <span style="@chipArmado">@Money(s.Cargado) cargado</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="5" style="text-align:right"><strong>Total a pagar</strong></td>
                    <td style="text-align:right"><strong>@Money(Model.PorPagar)</strong></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
        <p class="hint" style="margin-top:8px">
            <strong>Sin armar</strong> = esa salida no tiene ni un gasto ni un proveedor cargado,
            así que todo el costo es la estimación de la plantilla. Donde dice un monto cargado, es
            lo que hay en el operativo hoy: si es menor que el teórico, falta cargar la diferencia.
        </p>
    }
</div>

<!-- Detalle: proveedores con saldo -->
<div class="card" style="margin-top:12px">
    <h2 style="margin-top:0">De eso, los proveedores ya elegidos</h2>
    <p class="subtitle">
        Guías, hospedajes, restaurantes y autos de las salidas que vienen que ya tienen lugar
        tomado y precio acordado, y todavía deben saldo. <strong>No se suma aparte:</strong> ya
        está adentro del total de arriba. Sirve para saber cuánto de lo que falta pagar ya tiene
        nombre y apellido.
    </p>

    @if (Model.Pagos.Count == 0)
    {
        <p style="color:var(--ink-soft)">Ningún proveedor elegido con saldo pendiente.</p>
    }
    else
    {
        <table class="tabla">
            <thead>
                <tr>
                    <th>Sale</th><th>Excursión</th><th>Tipo</th><th>Proveedor</th>
                    <th style="text-align:right">Total</th>
                    <th style="text-align:right">Pagado</th>
                    <th style="text-align:right">Falta pagar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Pagos)
                {
                    <tr>
                        <td>@Dia(p.Fecha)</td>
                        <td>@p.Excursion</td>
                        <td>@p.Tipo</td>
                        <td>
                            @p.Proveedor
                            @if (!string.IsNullOrWhiteSpace(p.Lugar))
                            {
                                <span class="hint">(@p.Lugar)</span>
                            }
                        </td>
                        <td style="text-align:right">@Money(p.Total)</td>
                        <td style="text-align:right">@Money(p.Pagado)</td>
                        <td style="text-align:right"><strong>@Money(p.Falta)</strong></td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="6" style="text-align:right"><strong>Deuda con proveedores</strong></td>
                    <td style="text-align:right"><strong>@Money(Model.DeudaProveedores)</strong></td>
                </tr>
            </tfoot>
        </table>
    }
</div>
