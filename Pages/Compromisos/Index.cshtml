@page
@model Wamani.Reservas.Pages.Compromisos.IndexModel
@{
    ViewData["Title"] = "Compromisos";
    var ci = System.Globalization.CultureInfo.GetCultureInfo("es-AR");
    string Money(decimal m) => "$ " + m.ToString("N0", ci);
    string Dia(DateTime d) => d.ToString("dd/MM/yy", ci);
    var pasoChip = "display:inline-block;margin-left:6px;padding:1px 7px;border-radius:999px;font-size:11px;font-weight:600;color:#fff;background:var(--warn)";
}

<div class="toolbar">
    <div>
        <h1>Compromisos</h1>
        <p class="subtitle" style="margin:0">
            Cuánta plata neta queda de las salidas que ya tienen reservas: lo que hay en caja hoy,
            más lo que falta cobrar, menos todo lo que falta pagar.
        </p>
    </div>
</div>

<!-- Resumen -->
<div class="fin-cards">
    <div class="fin-card">
        <div class="fin-label">Caja hoy</div>
        <div class="fin-val">@Money(Model.CajaHoy)</div>
        <div class="fin-label" style="margin-top:4px">lo ya cobrado menos lo ya pagado</div>
    </div>
    <div class="fin-card">
        <div class="fin-label">+ Falta cobrar</div>
        <div class="fin-val" style="color:var(--ok)">@Money(Model.PorCobrar)</div>
        <div class="fin-label" style="margin-top:4px">@Model.Cobros.Count saldo(s) de reservas</div>
    </div>
    <div class="fin-card">
        <div class="fin-label">− Falta pagar</div>
        <div class="fin-val" style="color:var(--warn)">@Money(Model.PorPagar)</div>
        <div class="fin-label" style="margin-top:4px">
            @Money(Model.PorPagarGastos) gastos · @Money(Model.PorPagarProveedores) proveedores
        </div>
    </div>
    <div class="fin-card fin-card-net">
        <div class="fin-label">Plata neta proyectada</div>
        <div class="fin-val" style="color:var(--accent)">@Money(Model.Proyectado)</div>
        <div class="fin-label" style="margin-top:4px">cuando termines de cobrar y pagar todo</div>
    </div>
</div>

<div class="card" style="margin-top:4px">
    <p style="margin:0;color:var(--ink-soft)">
        <strong>Proyectado</strong> = Caja hoy @Money(Model.CajaHoy)
        + falta cobrar @Money(Model.PorCobrar)
        − gastos del operativo @Money(Model.PorPagarGastos)
        − proveedores @Money(Model.PorPagarProveedores)
        = <strong>@Money(Model.Proyectado)</strong>.
    </p>
    <p style="margin:8px 0 0;color:var(--ink-soft)">
        Los <strong>gastos del operativo</strong> salen de la plantilla de cada excursión: son una
        estimación hasta que los vas cargando y tildando. Los <strong>proveedores</strong> ya tienen
        lugar tomado y precio acordado, así que esa deuda es firme. Por eso van separados.
    </p>
</div>

@if (Model.CobrarVencido > 0 || Model.PagarVencido > 0)
{
    <div class="aviso-ok" style="background:var(--warn-bg,#fff4e5);border-color:var(--warn)">
        <strong>Ojo con lo vencido:</strong>
        @if (Model.CobrarVencido > 0)
        {
            <span>hay @Money(Model.CobrarVencido) sin cobrar de salidas que ya pasaron.</span>
        }
        @if (Model.PagarVencido > 0)
        {
            <span>Hay @Money(Model.PagarVencido) sin pagar de salidas que ya pasaron.</span>
        }
    </div>
}

<!-- Falta cobrar -->
<div class="card" style="margin-top:12px">
    <h2 style="margin-top:0">Falta cobrar (saldos de reservas)</h2>
    <p class="subtitle">Normalmente es el 50% que queda después de la seña.</p>

    @if (Model.Cobros.Count == 0)
    {
        <p style="color:var(--ink-soft)">No queda nada por cobrar. Todas las reservas están pagas.</p>
    }
    else
    {
        <table class="tabla">
            <thead>
                <tr>
                    <th>Sale</th><th>Excursión</th><th>Pasajero</th>
                    <th style="text-align:right">Pers.</th>
                    <th style="text-align:right">Total</th>
                    <th style="text-align:right">Cobrado</th>
                    <th style="text-align:right">Falta cobrar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Cobros)
                {
                    <tr>
                        <td>
                            @Dia(c.Fecha)
                            @if (c.YaPaso)
                            {
                                <span style="@pasoChip">ya pasó</span>
                            }
                        </td>
                        <td>@c.Excursion</td>
                        <td>@c.Cliente</td>
                        <td style="text-align:right">@c.Personas</td>
                        <td style="text-align:right">@Money(c.Total)</td>
                        <td style="text-align:right">@Money(c.Cobrado)</td>
                        <td style="text-align:right"><strong>@Money(c.Falta)</strong></td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="6" style="text-align:right"><strong>Total a cobrar</strong></td>
                    <td style="text-align:right"><strong>@Money(Model.PorCobrar)</strong></td>
                </tr>
            </tfoot>
        </table>
    }
</div>

<!-- Falta pagar: gastos del operativo -->
<div class="card" style="margin-top:12px">
    <h2 style="margin-top:0">Falta pagar · gastos del operativo</h2>
    <p class="subtitle">
        Nafta, entradas, comidas, viáticos y demás de cada salida: todo lo que todavía no está
        tildado como pagado. El detalle ítem por ítem está en el operativo de cada salida.
    </p>

    @if (Model.Gastos.Count == 0)
    {
        <p style="color:var(--ink-soft)">No queda ningún gasto del operativo sin pagar.</p>
    }
    else
    {
        <table class="tabla">
            <thead>
                <tr>
                    <th>Sale</th><th>Excursión</th>
                    <th style="text-align:right">Ítems</th>
                    <th style="text-align:right">Falta pagar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model.Gastos)
                {
                    <tr>
                        <td>
                            @Dia(g.Fecha)
                            @if (g.YaPaso)
                            {
                                <span style="@pasoChip">ya pasó</span>
                            }
                        </td>
                        <td>@g.Excursion</td>
                        <td style="text-align:right">@g.Items</td>
                        <td style="text-align:right"><strong>@Money(g.Falta)</strong></td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" style="text-align:right"><strong>Total en gastos</strong></td>
                    <td style="text-align:right"><strong>@Money(Model.PorPagarGastos)</strong></td>
                </tr>
            </tfoot>
        </table>
    }
</div>

<!-- Falta pagar: proveedores -->
<div class="card" style="margin-top:12px">
    <h2 style="margin-top:0">Falta pagar · proveedores</h2>
    <p class="subtitle">Guías, hospedajes, restaurantes y autos que ya tienen lugar tomado y todavía deben saldo.</p>

    @if (Model.Pagos.Count == 0)
    {
        <p style="color:var(--ink-soft)">No queda nada por pagar a proveedores.</p>
    }
    else
    {
        <table class="tabla">
            <thead>
                <tr>
                    <th>Sale</th><th>Excursión</th><th>Tipo</th><th>Proveedor</th>
                    <th style="text-align:right">Total</th>
                    <th style="text-align:right">Pagado</th>
                    <th style="text-align:right">Falta pagar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Pagos)
                {
                    <tr>
                        <td>
                            @Dia(p.Fecha)
                            @if (p.YaPaso)
                            {
                                <span style="@pasoChip">ya pasó</span>
                            }
                        </td>
                        <td>@p.Excursion</td>
                        <td>@p.Tipo</td>
                        <td>
                            @p.Proveedor
                            @if (!string.IsNullOrWhiteSpace(p.Lugar))
                            {
                                <span class="hint">(@p.Lugar)</span>
                            }
                        </td>
                        <td style="text-align:right">@Money(p.Total)</td>
                        <td style="text-align:right">@Money(p.Pagado)</td>
                        <td style="text-align:right"><strong>@Money(p.Falta)</strong></td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="6" style="text-align:right"><strong>Total a proveedores</strong></td>
                    <td style="text-align:right"><strong>@Money(Model.PorPagarProveedores)</strong></td>
                </tr>
            </tfoot>
        </table>
    }
</div>
