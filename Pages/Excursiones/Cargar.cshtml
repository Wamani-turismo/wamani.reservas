@page
@model Wamani.Reservas.Pages.Excursiones.CargarModel
@{
    ViewData["Title"] = Model.EsNueva ? "Nueva excursión" : "Editar excursión";
    string Num(decimal m) => m.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}

<h1>@(Model.EsNueva ? "Nueva excursión" : "Editar excursión")</h1>
<p class="subtitle">Precio en pesos argentinos ($), por persona.</p>

<form method="post">
    <input type="hidden" asp-for="Excursion.Id" />

    <div class="card">
        <div class="form-grid">
            <div class="field full">
                <label asp-for="Excursion.Nombre"></label>
                <input asp-for="Excursion.Nombre" placeholder="Ej: Serranías del Hornocal" />
                <span asp-validation-for="Excursion.Nombre" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Excursion.PrecioPorPersona"></label>
                <input asp-for="Excursion.PrecioPorPersona" type="number" step="0.01" min="0" />
                <span asp-validation-for="Excursion.PrecioPorPersona" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Excursion.MinimoPersonas"></label>
                <input asp-for="Excursion.MinimoPersonas" type="number" min="1" />
                <div class="hint">Mínimo para que la salida se realice.</div>
                <span asp-validation-for="Excursion.MinimoPersonas" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Excursion.MaximoPersonas"></label>
                <input asp-for="Excursion.MaximoPersonas" type="number" min="1" />
                <div class="hint">Máximo de pasajeros (ej: 8, o 15 en travesías).</div>
            </div>
            <div class="field full">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
                    <input asp-for="Excursion.EsTravesia" type="checkbox" style="width:auto" />
                    Es travesía (varios días) — el saldo se cobra 7 días antes en vez de 4
                </label>
            </div>
            <div class="field full">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
                    <input asp-for="Excursion.Activa" type="checkbox" style="width:auto" />
                    Activa (aparece para cargar reservas nuevas)
                </label>
            </div>
        </div>
    </div>

    <!-- ---------- Costos de la excursión ---------- -->
    <div class="card">
        <h2>Costos de la excursión</h2>
        <p class="hint" style="margin:-8px 0 14px">
            Cargá cada costo con su monto y <strong>cómo se cuenta</strong>: <em>por persona</em> (× pasajeros),
            <em>por auto (chofer-guía)</em> (× cantidad de autos, 1 cada @Wamani.Reservas.Models.Excursion.PersonasPorAuto —
            incluye al guía porque es el mismo chofer) o <em>fijo</em> (una vez por salida).
            Con esto se calcula la <strong>Rentabilidad</strong> y estos costos aparecen en el <strong>Operativo</strong> para pagarlos.
        </p>

        <table class="tabla" id="tablaGastos">
            <thead>
                <tr>
                    <th>Ítem / costo</th>
                    <th class="num" style="width:150px">Monto</th>
                    <th style="width:170px">Cómo se cuenta</th>
                    <th style="width:110px">¿Proveedor?</th>
                    <th style="width:60px"></th>
                </tr>
            </thead>
            <tbody id="gastosBody">
                @for (int i = 0; i < Model.Gastos.Count; i++)
                {
                    var gt = Model.Gastos[i].TipoCalculo;
                    var gp = Model.Gastos[i].EsProveedor;
                    <tr class="gasto-row">
                        <td data-label="Ítem"><input name="GastoNombres" value="@Model.Gastos[i].Nombre" placeholder="Ej: Nafta" /></td>
                        <td class="num" data-label="Monto"><input name="GastoPrecios" type="number" step="0.01" min="0" value="@Num(Model.Gastos[i].Precio)" /></td>
                        <td data-label="Cómo se cuenta">
                            <select name="GastoTipos">
                                @foreach (var t in Wamani.Reservas.Models.GastoExcursion.Tipos)
                                {
                                    <option value="@t" selected="@(gt == t)">@(t == "Por auto" ? "Por auto (chofer-guía)" : t)</option>
                                }
                            </select>
                        </td>
                        <td data-label="¿Proveedor?">
                            <label class="check-linea" title="Guía, auto, hospedaje o restaurante: cuenta en la Rentabilidad pero NO aparece en la lista del operativo (se paga en Proveedores).">
                                <input type="checkbox" onchange="this.nextElementSibling.value = this.checked ? '1' : '0'" @(gp ? "checked" : "") />
                                <input type="hidden" name="GastoEsProveedor" value="@(gp ? "1" : "0")" />
                            </label>
                        </td>
                        <td><button type="button" class="btn-mini btn-mini-danger" onclick="quitarGasto(this)">Quitar</button></td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="button" class="btn btn-ghost" style="margin-top:12px" onclick="agregarGasto()">+ Agregar costo</button>
    </div>

    <!-- ---------- Etapas de la travesía (dónde se duerme cada noche) ---------- -->
    @* Sólo tiene sentido en travesías de varios días: se muestra/esconde con la casilla
       "Es travesía" de arriba (ver el script al final). *@
    <div class="card" id="cardEtapas" style="@(Model.Excursion.EsTravesia ? "" : "display:none")">
        <h2>Dónde se duerme cada noche</h2>
        <p class="hint" style="margin:-8px 0 14px">
            Cargá una fila por cada NOCHE de la travesía, en orden. Elegí el refugio y listo:
            el resto se completa solo.
            <br />
            <strong>¿Para qué sirve, si el refugio ya está en Proveedores?</strong>
            En Proveedores está <em>quién es y cuánto cobra</em>. Acá se dice <em>en qué noche de
            esta travesía se usa</em>. Con eso, en el operativo de cada salida el hospedaje sale
            listo: <strong>una fila por noche con todo el grupo junto</strong> (personas × precio),
            en vez de tener que agregar a mano una fila por cada pasajero en cada refugio.
            <br />
            El <strong>lugar</strong> es opcional: si lo dejás vacío se usa el nombre del refugio.
            Conviene escribirlo cuando el lugar y el refugio no se llaman igual (por ejemplo lugar
            TILCARA con un hostel que tiene otro nombre), así el día que cambies de refugio la
            noche se sigue llamando igual.
            <br />
            El <strong>precio por persona</strong> también es opcional: sale de Proveedores. Se
            completa acá sólo si en esta travesía te cobran distinto.
        </p>

        <table class="tabla" id="tablaEtapas">
            <thead>
                <tr>
                    <th style="width:70px">Noche</th>
                    <th>Lugar <span class="hint" style="font-weight:400">(opcional)</span></th>
                    <th style="width:220px">Refugio / hospedaje habitual</th>
                    <th class="num" style="width:150px">Precio p/persona <span class="hint" style="font-weight:400">(opcional)</span></th>
                    <th>Comidas incluidas</th>
                    <th style="width:60px"></th>
                </tr>
            </thead>
            <tbody id="etapasBody">
                @for (int i = 0; i < Model.Etapas.Count; i++)
                {
                    var et = Model.Etapas[i];
                    <tr class="etapa-row">
                        <td data-label="Noche" class="etapa-nro">@(i + 1)</td>
                        <td data-label="Lugar"><input name="EtapaLugares" value="@et.Lugar" placeholder="(igual que el refugio)" /></td>
                        <td data-label="Refugio">
                            <select name="EtapaProveedorIds">
                                <option value="0">— sin asignar —</option>
                                @foreach (var h in Model.Hospedajes)
                                {
                                    <option value="@h.Id" selected="@(et.ProveedorId == h.Id)">@h.Nombre</option>
                                }
                            </select>
                        </td>
                        <td class="num" data-label="Precio por persona"><input name="EtapaPrecios" type="number" step="0.01" min="0" value="@Num(et.PrecioPorPersona)" /></td>
                        <td data-label="Incluye"><input name="EtapaIncluye" value="@et.Incluye" placeholder="Ej: merienda + cena + desayuno" /></td>
                        <td><button type="button" class="btn-mini btn-mini-danger" onclick="quitarEtapa(this)">Quitar</button></td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="button" class="btn btn-ghost" style="margin-top:12px" onclick="agregarEtapa()">+ Agregar noche</button>
    </div>

    <!-- ---------- Contenido para la Guía (PDF) ---------- -->
    <div class="card">
        <h2>Contenido para la Guía (PDF)</h2>
        <p class="hint" style="margin:-8px 0 14px">
            Esto se carga a mano por cada excursión y queda guardado. Después aparece en la Guía en PDF de cada salida.
        </p>
        <div class="form-grid">
            <div class="field full">
                <label asp-for="Excursion.GuiaBreve"></label>
                <textarea asp-for="Excursion.GuiaBreve" rows="4" placeholder="Contá brevemente de qué se trata la excursión / travesía…"></textarea>
            </div>
            <div class="field full">
                <label asp-for="Excursion.Recomendaciones"></label>
                <textarea asp-for="Excursion.Recomendaciones" rows="4" placeholder="Ej: calzado cómodo, protector solar, agua, abrigo, documento…"></textarea>
            </div>
            <div class="field full">
                <label asp-for="Excursion.LugaresVisitar"></label>
                <textarea asp-for="Excursion.LugaresVisitar" rows="4" placeholder="Ej: Salinas Grandes, Purmamarca, Cuesta de Lipán…"></textarea>
            </div>
        </div>
    </div>

    <div class="acciones-form">
        <button type="submit" class="btn btn-primary">💾 Guardar excursión</button>
        <a class="btn btn-ghost" asp-page="/Excursiones/Index">Cancelar</a>

        @if (!Model.EsNueva)
        {
            <button type="submit" class="btn btn-danger" style="margin-left:auto"
                    asp-page-handler="Eliminar" asp-route-id="@Model.Excursion.Id"
                    onclick="return confirm('¿Eliminar esta excursión? Si ya tiene reservas, se ocultará en vez de borrarse.');">
                🗑 Eliminar
            </button>
        }
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @{
        // Opciones del desplegable de refugios, para las filas de noche que se agregan
        // desde el botón. Se arma acá para no meter C# adentro del JavaScript.
        var sbHosp = new System.Text.StringBuilder("<option value=\"0\">— sin asignar —</option>");
        foreach (var h in Model.Hospedajes)
        {
            sbHosp.Append("<option value=\"").Append(h.Id).Append("\">")
                  .Append(System.Net.WebUtility.HtmlEncode(h.Nombre)).Append("</option>");
        }
        var opcionesHospedaje = sbHosp.ToString();
    }
    <script>
        function agregarGasto(nombre, precio) {
            var tr = document.createElement('tr');
            tr.className = 'gasto-row';
            tr.innerHTML =
                '<td data-label="Ítem"><input name="GastoNombres" placeholder="Ej: Nafta" value="' + (nombre || '') + '" /></td>' +
                '<td class="num" data-label="Monto"><input name="GastoPrecios" type="number" step="0.01" min="0" value="' + (precio || '') + '" /></td>' +
                '<td data-label="Cómo se cuenta"><select name="GastoTipos">' +
                '<option value="Por persona">Por persona</option>' +
                '<option value="Por auto">Por auto (chofer-guía)</option>' +
                '<option value="Fijo">Fijo</option>' +
                '</select></td>' +
                '<td data-label="¿Proveedor?"><label class="check-linea"><input type="checkbox" onchange="this.nextElementSibling.value = this.checked ? \'1\' : \'0\'" /><input type="hidden" name="GastoEsProveedor" value="0" /></label></td>' +
                '<td><button type="button" class="btn-mini btn-mini-danger" onclick="quitarGasto(this)">Quitar</button></td>';
            document.getElementById('gastosBody').appendChild(tr);
            tr.querySelector('input').focus();
        }
        function quitarGasto(btn) {
            btn.closest('tr').remove();
        }

        // ---- Etapas de la travesía (una fila por noche) ----
        var OPCIONES_HOSPEDAJE = '@Html.Raw(opcionesHospedaje)';

        function agregarEtapa() {
            var tr = document.createElement('tr');
            tr.className = 'etapa-row';
            tr.innerHTML =
                '<td data-label="Noche" class="etapa-nro"></td>' +
                '<td data-label="Lugar"><input name="EtapaLugares" placeholder="(igual que el refugio)" /></td>' +
                '<td data-label="Refugio"><select name="EtapaProveedorIds">' + OPCIONES_HOSPEDAJE + '</select></td>' +
                '<td class="num" data-label="Precio por persona"><input name="EtapaPrecios" type="number" step="0.01" min="0" /></td>' +
                '<td data-label="Incluye"><input name="EtapaIncluye" placeholder="Ej: merienda + cena + desayuno" /></td>' +
                '<td><button type="button" class="btn-mini btn-mini-danger" onclick="quitarEtapa(this)">Quitar</button></td>';
            document.getElementById('etapasBody').appendChild(tr);
            renumerarEtapas();
            tr.querySelector('input').focus();
        }
        function quitarEtapa(btn) {
            btn.closest('tr').remove();
            renumerarEtapas();
        }
        // La noche es la posición en la tabla: si se borra una del medio, se renumeran solas.
        function renumerarEtapas() {
            var filas = document.querySelectorAll('#etapasBody .etapa-row');
            for (var i = 0; i < filas.length; i++) {
                filas[i].querySelector('.etapa-nro').textContent = (i + 1);
            }
        }

        // Las noches sólo aplican a travesías: la sección aparece al tildar "Es travesía".
        (function () {
            var chk = document.getElementById('Excursion_EsTravesia');
            var card = document.getElementById('cardEtapas');
            if (!chk || !card) return;
            chk.addEventListener('change', function () {
                card.style.display = chk.checked ? '' : 'none';
            });
        })();
    </script>
}
