@page
@model Wamani.Reservas.Pages.Excursiones.CargarModel
@{
    ViewData["Title"] = Model.EsNueva ? "Nueva excursión" : "Editar excursión";
    string Num(decimal m) => m.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    // La sección "dónde se duerme cada noche" NO es sólo de las travesías: cualquier
    // excursión que duerma fuera la necesita. "Conociendo las Yungas" son 3 días y 2
    // noches y no es una travesía; antes, para poder cargar sus noches había que tildarla
    // como travesía, y eso cambia el negocio (el saldo se pasa a cobrar 7 días antes en
    // vez de 4). Ahora se muestra sola si la excursión es travesía o si ya tiene noches
    // cargadas, y si no, aparece un botón para abrirla. Las de un día siguen sin verla.
    var hayNoches = Model.Excursion.EsTravesia || Model.Etapas.Count > 0;
    var estiloCardNoches = hayNoches ? "" : "display:none";
    var estiloBotonNoches = hayNoches ? "display:none" : "";
}

<h1>@(Model.EsNueva ? "Nueva excursión" : "Editar excursión")</h1>
<p class="subtitle">Precio en pesos argentinos ($), por persona.</p>

@* Cartel al armar un viaje a medida. El sistema NO cuenta días: agregar días sólo crea
   renglones nuevos y NO alarga lo que la base cobraba por todo el viaje. Sin este aviso
   es fácil dejar el auto y los seguros con el precio del viaje corto. *@
@if (Model.AMedida)
{
    <div class="card" style="border-left:4px solid var(--naranja); background:var(--accent-soft)">
        <h2 style="margin-top:0">⚠️ Antes de guardar, revisá esto</h2>
        <p style="margin:-6px 0 14px">
            El viaje se copió de <strong>@(Model.Base ?? "la excursión de base")</strong>@(Model.Dias > 0 ? $" y se le agregaron {Model.Dias} día(s)." : ".")
            <strong>El sistema no cuenta los días:</strong> agregar días crea renglones nuevos, pero
            <strong>no alarga</strong> lo que la excursión de base cobraba por todo el viaje.
        </p>
        <p style="margin:0 0 8px"><strong>Lo que casi siempre hay que subir a mano:</strong></p>
        <ul style="margin:0 0 14px; padding-left:1.2em">
            <li><strong>El auto</strong> — está al precio de los días de la excursión original.</li>
            <li><strong>La nafta</strong> — más días son más kilómetros.</li>
            <li><strong>Los seguros</strong>, del pasajero y del guía: se cobran por día de cobertura.</li>
            <li><strong>El chofer y guía</strong> de la base, si venía como un monto por todo el viaje.</li>
        </ul>
        @if (Model.Etapas.Count > 0)
        {
            <p style="margin:0 0 14px">
                <strong>Ojo, esta es una travesía con noches cargadas.</strong> Los días del guía, de los
                arrieros y de los caballos se copiaron como estaban. Subilos ahí abajo
                <strong>o</strong> cargalos en los renglones del día extra, pero
                <strong>no en los dos lados</strong>, o se cuenta doble.
            </p>
        }
        <p style="margin:0">
            Y antes de guardar, <strong>recorré la lista completa de costos</strong>: puede haber
            renglones de la base que en este viaje no van y conviene borrar, o que cambien de precio.
            Los días agregados están en $0 y se llaman «Día extra».
        </p>
    </div>
}

@if (Model.Guardado)
{
    <div class="aviso-ok">Guardado ✔</div>
}

<form method="post">
    <input type="hidden" asp-for="Excursion.Id" />
    @* Se pone en "true" cuando se guarda desde la ventanita de una nota, para volver acá
       mismo en vez de irse al listado de excursiones. *@
    <input type="hidden" name="SeguirAca" id="seguirAca" value="false" />

    <div class="card">
        <div class="form-grid">
            <div class="field full">
                <label asp-for="Excursion.Nombre"></label>
                <input asp-for="Excursion.Nombre" placeholder="Ej: Serranías del Hornocal" />
                <span asp-validation-for="Excursion.Nombre" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Excursion.PrecioPorPersona"></label>
                <input asp-for="Excursion.PrecioPorPersona" type="number" step="0.01" min="0" />
                <span asp-validation-for="Excursion.PrecioPorPersona" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Excursion.MinimoPersonas"></label>
                <input asp-for="Excursion.MinimoPersonas" type="number" min="1" />
                <div class="hint">Mínimo para que la salida se realice.</div>
                <span asp-validation-for="Excursion.MinimoPersonas" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Excursion.MaximoPersonas"></label>
                <input asp-for="Excursion.MaximoPersonas" type="number" min="1" />
                <div class="hint">Máximo de pasajeros (ej: 8, o 15 en travesías).</div>
            </div>
            <div class="field full">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
                    <input asp-for="Excursion.EsTravesia" type="checkbox" style="width:auto" />
                    Es travesía (varios días) — el saldo se cobra 7 días antes en vez de 4
                </label>
            </div>
            <div class="field full">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
                    <input asp-for="Excursion.Activa" type="checkbox" style="width:auto" />
                    Activa (aparece para cargar reservas nuevas)
                </label>
            </div>
        </div>
    </div>

    <!-- ---------- Costos de la excursión ---------- -->
    <div class="card">
        <h2>Costos de la excursión</h2>
        <p class="hint" style="margin:-8px 0 14px">
            Cargá cada costo con su monto y <strong>cómo se cuenta</strong>: <em>por persona</em> (× pasajeros),
            <em>por auto (chofer-guía)</em> (× cantidad de autos, 1 cada @Wamani.Reservas.Models.Excursion.PersonasPorAuto —
            incluye al guía porque es el mismo chofer) o <em>fijo</em> (una vez por salida).
            Con esto se calcula la <strong>Rentabilidad</strong> y estos costos aparecen en el <strong>Operativo</strong> para pagarlos.
        </p>

        <div class="tabla-wrap">
        <table class="tabla" id="tablaGastos">
            <thead>
                <tr>
                    <th>Ítem / costo</th>
                    <th class="num" style="width:120px">Monto</th>
                    <th style="width:190px">Cómo se cuenta</th>
                    <th class="num" style="width:80px">Cantidad</th>
                    <th style="width:110px">¿Proveedor?</th>
                    <th style="width:60px">Nota</th>
                    <th style="width:60px"></th>
                </tr>
            </thead>
            <tbody id="gastosBody">
                @for (int i = 0; i < Model.Gastos.Count; i++)
                {
                    var gt = Model.Gastos[i].TipoCalculo;
                    var gp = Model.Gastos[i].EsProveedor;
                    // Precalculado acá a propósito: dentro de un atributo, las expresiones
                    // de Razor con comillas adentro son un dolor de cabeza.
                    var gcVal = Model.Gastos[i].Cantidad?.ToString() ?? "";
                    var gcEstilo = gt == "Cantidad" ? "" : "display:none";
                    <tr class="gasto-row">
                        <td data-label="Ítem"><input name="GastoNombres" value="@Model.Gastos[i].Nombre" placeholder="Ej: Nafta" /></td>
                        <td class="num" data-label="Monto"><input name="GastoPrecios" type="number" step="0.01" min="0" value="@Num(Model.Gastos[i].Precio)" /></td>
                        <td data-label="Cómo se cuenta">
                            <select name="GastoTipos" class="sel-tipo">
                                @foreach (var t in Wamani.Reservas.Models.GastoExcursion.Tipos)
                                {
                                    <option value="@t" selected="@(gt == t)">@Wamani.Reservas.Models.GastoExcursion.Etiqueta(t)</option>
                                }
                            </select>
                        </td>
                        @* Sólo se usa en los costos de tipo "Cantidad": es con cuántos
                           arranca cada salida (después se ajusta con los botones + y −). *@
                        <td class="num" data-label="Cantidad">
                            <input name="GastoCantidades" type="number" step="1" min="0" class="in-cant-plantilla"
                                   value="@gcVal" style="@gcEstilo" />
                        </td>
                        <td data-label="¿Proveedor?">
                            <label class="check-linea" title="Guía, auto, hospedaje o restaurante: cuenta en la Rentabilidad pero NO aparece en la lista del operativo (se paga en Proveedores).">
                                <input type="checkbox" onchange="this.nextElementSibling.value = this.checked ? '1' : '0'" @(gp ? "checked" : "") />
                                <input type="hidden" name="GastoEsProveedor" value="@(gp ? "1" : "0")" />
                            </label>
                        </td>
                        @* La nota de este costo: el texto viaja escondido y se escribe en
                           la ventanita que abre el botón 📋. *@
                        <td data-label="Nota">
                            <input type="hidden" name="GastoComentarios" value="@Model.Gastos[i].Comentario" />
                            <button type="button" class="btn-mini btn-mini-ghost btn-nota" onclick="abrirNota(this)">📋</button>
                        </td>
                        <td><button type="button" class="btn-mini btn-mini-danger" title="Borrar" onclick="quitarGasto(this)">🗑</button></td>
                    </tr>
                }
            </tbody>
        </table>
        </div>

        <button type="button" class="btn btn-ghost" style="margin-top:12px" onclick="agregarGasto()">+ Agregar costo</button>
    </div>

    <!-- ---------- Dónde se duerme cada noche ---------- -->
    @* Sirve para cualquier salida que duerma fuera, sea travesía o no: en las travesías
       se abre sola, en el resto con el botón de acá abajo (ver el script al final). *@
    <button type="button" class="btn btn-ghost" id="btnVerNoches" style="@estiloBotonNoches">
        🏨 Esta salida duerme fuera — cargar dónde se duerme cada noche
    </button>

    <div class="card" id="cardEtapas" style="@estiloCardNoches">
        <h2>Qué lleva esta salida</h2>
        <p class="hint" style="margin:-8px 0 14px">
            Todo lo que se contrata <strong>para el grupo entero</strong>: dónde se duerme,
            los traslados, los arrieros y los caballos. Se carga una vez acá y en el operativo
            de cada salida aparece listo, con el total ya calculado.
            <br />
            <strong>¿Para qué, si el proveedor ya está en Proveedores?</strong> En Proveedores
            está <em>quién es y cuánto cobra</em>. Acá se dice <em>en qué momento de esta salida
            se usa</em>. Con eso el operativo sale armado —<strong>una fila por parada, con todo
            el grupo junto</strong>— en vez de tener que cargar a mano una fila por pasajero.
            <br />
            No hace falta que sea travesía: sirve para cualquier salida que duerma fuera.
            <strong>“Conociendo las Yungas”</strong> son 3 días y 2 noches y se carga acá igual,
            con una sola fila de 2 noches.
        </p>
        <div class="hint" style="margin:-6px 0 14px">
            <strong>Cómo se cuenta cada fila</strong> (siempre cantidad × precio × veces):
            <ul style="margin:6px 0 0 18px">
                <li>🏨 <strong>Hospedaje</strong> — personas × precio por persona × <em>noches</em>.
                    Si dormís 2 noches seguidas en el mismo lado, poné 2 en “Veces”: una sola fila.</li>
                <li>🚐 <strong>Traslado</strong> — vehículos × precio × <em>veces</em>. Si el traslado es
                    <strong>contratado y entra todo el grupo</strong> (una traffic, una camioneta),
                    poné <strong>1</strong> en “Cuántos” y se cobra una sola vez. Si lo dejás
                    <strong>vacío</strong> lo calcula solo: 1 auto cada 4, contando a los guías
                    —que es lo que corresponde cuando manejamos nosotros.</li>
                <li>🎟️ <strong>Pasajes</strong> — para el micro, donde se saca un boleto por cabeza:
                    pasajes × precio del boleto. También cuenta a los guías.</li>
                <li>🧑‍🏫 <strong>Guía</strong> — guías × precio por día × <em>días</em>. El precio va acá y
                    no en Proveedores, porque <strong>depende de la salida, no de la persona</strong>: el
                    mismo guía cobra $60.000 por día en una excursión de un día y $100.000 en una
                    travesía. En Proveedores va sólo quién es.</li>
                <li>🧑‍🌾 <strong>Arriero</strong> y 🐴 <strong>Caballo</strong> — cuántos × precio por día
                    × <em>días</em>. Cuántos van lo decidís en cada salida, no sale de ninguna fórmula.</li>
            </ul>
            El <strong>lugar/tramo</strong> es opcional: si lo dejás vacío se usa el nombre del
            proveedor. El <strong>precio</strong> también: si lo dejás en cero sale del catálogo de
            Proveedores, así lo actualizás en un solo lugar.
        </div>

        <div class="tabla-wrap">
        <table class="tabla" id="tablaEtapas">
            <thead>
                <tr>
                    <th style="width:70px">Nº</th>
                    <th style="width:130px">Qué es</th>
                    <th>Lugar / tramo</th>
                    <th style="width:200px">Proveedor habitual</th>
                    <th class="num" style="width:80px">Cuántos</th>
                    <th class="num" style="width:80px">Veces</th>
                    <th class="num" style="width:120px">Precio unitario</th>
                    <th>Notas / incluye</th>
                    <th style="width:60px"></th>
                </tr>
            </thead>
            <tbody id="etapasBody">
                @for (int i = 0; i < Model.Etapas.Count; i++)
                {
                    var et = Model.Etapas[i];
                    // Precalculado para no meter un ">" adentro de un atributo (rompe Razor).
                    // El número de noche real lo escribe el JS al cargar la página, porque
                    // una fila puede valer por varias noches.
                    var etNoches = et.Noches > 0 ? et.Noches : 1;
                    // "Cuántos" se usa en guías, arrieros y caballos… y ahora también en los
                    // TRASLADOS, para poder decir "entramos todos en una sola traffic".
                    // En el traslado se deja vacío si nadie lo tocó: vacío = que lo calcule
                    // el sistema (1 auto cada 4).
                    var etEsPorDia = Wamani.Reservas.Models.EtapaExcursion.EsPorDia(et.Tipo);
                    var etEsTraslado = et.Tipo == Wamani.Reservas.Models.EtapaExcursion.Traslado;
                    var etCant = etEsPorDia ? et.CantidadReferencia().ToString()
                               : etEsTraslado ? (et.Cantidad?.ToString() ?? "")
                               : "";
                    var etCantEstilo = (etEsPorDia || etEsTraslado) ? "" : "display:none";
                    <tr class="etapa-row" data-tipo="@et.Tipo">
                        <td data-label="Nº" class="etapa-nro">@(i + 1)</td>
                        <td data-label="Qué es">
                            <select name="EtapaTipos" class="sel-etapa-tipo">
                                @foreach (var t in Wamani.Reservas.Models.EtapaExcursion.Tipos)
                                {
                                    <option value="@t" selected="@(et.Tipo == t)">@Wamani.Reservas.Models.EtapaExcursion.Icono(t) @t</option>
                                }
                            </select>
                        </td>
                        <td data-label="Lugar / tramo"><input name="EtapaLugares" value="@et.Lugar" placeholder="(igual que el proveedor)" /></td>
                        <td data-label="Proveedor habitual">
                            @* Van todos los proveedores agrupados por tipo: una fila puede
                               ser un refugio, una agencia de autos o un arriero. *@
                            <select name="EtapaProveedorIds">
                                <option value="0">— sin asignar —</option>
                                @foreach (var grupo in Model.ProveedoresActivos.GroupBy(p => p.Tipo))
                                {
                                    <optgroup label="@grupo.Key">
                                        @foreach (var h in grupo)
                                        {
                                            <option value="@h.Id" selected="@(et.ProveedorId == h.Id)">@h.Nombre</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </td>
                        <td class="num" data-label="Cuántos"><input name="EtapaCantidades" type="number" step="1" min="0" value="@etCant" style="@etCantEstilo" class="in-cuantos" /></td>
                        <td class="num" data-label="Veces"><input name="EtapaNoches" type="number" step="1" min="1" value="@etNoches" class="in-noches" /></td>
                        <td class="num" data-label="Precio unitario"><input name="EtapaPrecios" type="number" step="0.01" min="0" value="@Num(et.PrecioPorPersona)" class="in-precio-etapa" /><div class="etapa-calc"></div></td>
                        <td data-label="Incluye"><input name="EtapaIncluye" value="@et.Incluye" placeholder="Ej: merienda + cena + desayuno" /></td>
                        <td><button type="button" class="btn-mini btn-mini-danger" title="Borrar" onclick="quitarEtapa(this)">🗑</button></td>
                    </tr>
                }
            </tbody>
        </table>
        </div>

        @* Se calcula solo mientras se escribe, con el mínimo de pasajeros de arriba.
           Es el número que dice si la excursión cierra o no. *@
        <div id="cuantoNosSale" class="costo-resumen"></div>

        <div class="acciones-fila" style="margin-top:12px">
            <button type="button" class="btn btn-ghost" onclick="agregarEtapa('Hospedaje')">🏨 + Noche</button>
            <button type="button" class="btn btn-ghost" onclick="agregarEtapa('Traslado')">🚐 + Traslado (por auto)</button>
            <button type="button" class="btn btn-ghost" onclick="agregarEtapa('Pasaje')">🎟️ + Pasajes (por persona)</button>
            <button type="button" class="btn btn-ghost" onclick="agregarEtapa('Guía')">🧑‍🏫 + Guías</button>
            <button type="button" class="btn btn-ghost" onclick="agregarEtapa('Arriero')">🧑‍🌾 + Arrieros</button>
            <button type="button" class="btn btn-ghost" onclick="agregarEtapa('Caballo')">🐴 + Caballos</button>
        </div>
    </div>

    <!-- ---------- Contenido para la Guía (PDF) ---------- -->
    <div class="card">
        <h2>Contenido para la Guía (PDF)</h2>
        <p class="hint" style="margin:-8px 0 14px">
            Esto se carga a mano por cada excursión y queda guardado. Después aparece en la Guía en PDF de cada salida.
        </p>
        <div class="form-grid">
            <div class="field full">
                <label asp-for="Excursion.GuiaBreve"></label>
                <textarea asp-for="Excursion.GuiaBreve" rows="4" placeholder="Contá brevemente de qué se trata la excursión / travesía…"></textarea>
            </div>
            <div class="field full">
                <label asp-for="Excursion.Recomendaciones"></label>
                <textarea asp-for="Excursion.Recomendaciones" rows="4" placeholder="Ej: calzado cómodo, protector solar, agua, abrigo, documento…"></textarea>
            </div>
            <div class="field full">
                <label asp-for="Excursion.LugaresVisitar"></label>
                <textarea asp-for="Excursion.LugaresVisitar" rows="4" placeholder="Ej: Salinas Grandes, Purmamarca, Cuesta de Lipán…"></textarea>
            </div>
        </div>
    </div>

    <div class="acciones-form">
        <button type="submit" class="btn btn-primary">💾 Guardar excursión</button>
        <a class="btn btn-ghost" asp-page="/Excursiones/Index">Cancelar</a>

        @if (!Model.EsNueva)
        {
            <button type="submit" class="btn btn-danger" style="margin-left:auto"
                    asp-page-handler="Eliminar" asp-route-id="@Model.Excursion.Id"
                    onclick="return confirm('¿Eliminar esta excursión? Si ya tiene reservas, se ocultará en vez de borrarse.');">
                🗑 Eliminar
            </button>
        }
    </div>
</form>

@* Ventanita para escribir la nota de un costo. Va FUERA del formulario a propósito: así
   el textarea no se manda como un campo más y no desacomoda las listas de la tabla. *@
<div id="modalNota" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(35,51,46,.55);z-index:999;align-items:center;justify-content:center;padding:16px">
    <div style="background:var(--surface);color:var(--ink);width:100%;max-width:520px;padding:22px;border-radius:14px;box-shadow:0 14px 44px rgba(0,0,0,.25)">
        <h2 id="notaTitulo" style="margin:0 0 4px">Nota del costo</h2>
        <p class="hint" style="margin:0 0 14px">
            Anotá lo que haga falta acordarse de este costo: qué incluye, con quién se
            arregló, por qué ese precio. No entra en ninguna cuenta.
        </p>
        <textarea id="notaTexto" rows="7" style="width:100%" placeholder="Ej: el precio es por los 3 almuerzos de marcha juntos, arreglado con Doña Rosa."></textarea>
        <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:16px">
            <button type="button" class="btn btn-ghost" onclick="cerrarNota()">Cancelar</button>
            <button type="button" class="btn btn-primary" onclick="guardarNota()">💾 Guardar</button>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @{
        // Opciones del desplegable de proveedores (agrupadas por tipo) para las filas que
        // se agregan desde el botón. Se arma acá para no meter C# adentro del JavaScript.
        var sbHosp = new System.Text.StringBuilder("<option value=\"0\">— sin asignar —</option>");
        foreach (var grupo in Model.ProveedoresActivos.GroupBy(p => p.Tipo))
        {
            sbHosp.Append("<optgroup label=\"")
                  .Append(System.Net.WebUtility.HtmlEncode(grupo.Key)).Append("\">");
            foreach (var h in grupo)
            {
                sbHosp.Append("<option value=\"").Append(h.Id).Append("\">")
                      .Append(System.Net.WebUtility.HtmlEncode(h.Nombre)).Append("</option>");
            }
            sbHosp.Append("</optgroup>");
        }
        var opcionesHospedaje = sbHosp.ToString();

        // Opciones del desplegable "qué es", para esas mismas filas nuevas
        var sbTipos = new System.Text.StringBuilder();
        foreach (var t in Wamani.Reservas.Models.EtapaExcursion.Tipos)
        {
            sbTipos.Append("<option value=\"").Append(t).Append("\">")
                   .Append(Wamani.Reservas.Models.EtapaExcursion.Icono(t)).Append(' ')
                   .Append(t).Append("</option>");
        }
        var opcionesTipoEtapa = sbTipos.ToString();
    }
    <script>
        function agregarGasto(nombre, precio) {
            var tr = document.createElement('tr');
            tr.className = 'gasto-row';
            tr.innerHTML =
                '<td data-label="Ítem"><input name="GastoNombres" placeholder="Ej: Nafta" value="' + (nombre || '') + '" /></td>' +
                '<td class="num" data-label="Monto"><input name="GastoPrecios" type="number" step="0.01" min="0" value="' + (precio || '') + '" /></td>' +
                '<td data-label="Cómo se cuenta"><select name="GastoTipos" class="sel-tipo">' +
                '<option value="Por persona">Por persona</option>' +
                '<option value="Por auto">Por auto (chofer-guía)</option>' +
                '<option value="Cantidad">Cantidad (se ajusta en cada salida)</option>' +
                '<option value="Fijo">Fijo</option>' +
                '</select></td>' +
                '<td class="num" data-label="Cantidad"><input name="GastoCantidades" type="number" step="1" min="0" class="in-cant-plantilla" value="" style="display:none" /></td>' +
                '<td data-label="¿Proveedor?"><label class="check-linea"><input type="checkbox" onchange="this.nextElementSibling.value = this.checked ? \'1\' : \'0\'" /><input type="hidden" name="GastoEsProveedor" value="0" /></label></td>' +
                '<td data-label="Nota"><input type="hidden" name="GastoComentarios" value="" /><button type="button" class="btn-mini btn-mini-ghost btn-nota" onclick="abrirNota(this)">📋</button></td>' +
                '<td><button type="button" class="btn-mini btn-mini-danger" title="Borrar" onclick="quitarGasto(this)">🗑</button></td>';
            document.getElementById('gastosBody').appendChild(tr);
            pintarNota(tr.querySelector('.btn-nota'));
            tr.querySelector('input').focus();
        }

        // ---- La nota de cada costo (el botón 📋) ----
        // El texto vive en un campo escondido de la fila; la ventanita lo lee y lo escribe.
        // Al tocar "Guardar" se guarda la excursión entera, así queda en la base al toque.
        var filaNota = null;

        function pintarNota(btn) {
            if (!btn) return;
            var esc = btn.closest('tr').querySelector('input[name=GastoComentarios]');
            var hay = esc && esc.value.trim() !== '';
            btn.style.opacity = hay ? '1' : '0.4';
            // Punto naranja abajo a la derecha: sin esto no se distinguía de una vacía
            btn.classList.toggle('con-nota', hay);
            btn.title = hay ? esc.value : 'Escribir una nota sobre este costo';
        }

        function abrirNota(btn) {
            filaNota = btn.closest('tr');
            var nombre = (filaNota.querySelector('input[name=GastoNombres]').value || '').trim();
            document.getElementById('notaTitulo').textContent = nombre ? ('Nota · ' + nombre) : 'Nota del costo';
            var texto = document.getElementById('notaTexto');
            texto.value = filaNota.querySelector('input[name=GastoComentarios]').value;
            document.getElementById('modalNota').style.display = 'flex';
            texto.focus();
        }

        function cerrarNota() {
            document.getElementById('modalNota').style.display = 'none';
            filaNota = null;
        }

        function guardarNota() {
            if (!filaNota) return;
            filaNota.querySelector('input[name=GastoComentarios]').value = document.getElementById('notaTexto').value;
            pintarNota(filaNota.querySelector('.btn-nota'));
            // OJO: tiene que ser el formulario DE LA FILA, no el primero de la página.
            // El menú de arriba tiene un formulario propio (el botón "Salir"), así que
            // buscar "el primer form" cerraba la sesión en vez de guardar la excursión.
            var form = filaNota.closest('form');
            // Guardando desde acá se vuelve a esta misma excursión, no al listado: el que
            // está anotando sigue trabajando en esta pantalla.
            var volver = document.getElementById('seguirAca');
            if (volver) volver.value = 'true';
            cerrarNota();
            if (form) form.submit();
        }

        document.querySelectorAll('.btn-nota').forEach(pintarNota);
        function quitarGasto(btn) {
            if (!confirm('¿Realmente lo querés borrar?')) return;
            btn.closest('tr').remove();
        }

        // La cantidad sólo tiene sentido en los costos de tipo "Cantidad" (arrieros,
        // caballos, guías, traslados): en los demás se esconde para no confundir.
        document.addEventListener('change', function (e) {
            if (!e.target.classList.contains('sel-tipo')) return;
            var fila = e.target.closest('tr');
            var cant = fila.querySelector('.in-cant-plantilla');
            if (!cant) return;
            var esCantidad = e.target.value === 'Cantidad';
            cant.style.display = esCantidad ? '' : 'none';
            if (esCantidad) { if (!cant.value) cant.value = '1'; cant.focus(); }
            else { cant.value = ''; }
        });

        // ---- Lo que lleva la salida: noches, traslados, arrieros y caballos ----
        var OPCIONES_HOSPEDAJE = '@Html.Raw(opcionesHospedaje)';
        var OPCIONES_TIPO_ETAPA = '@Html.Raw(opcionesTipoEtapa)';

        function agregarEtapa(tipo) {
            var tr = document.createElement('tr');
            tr.className = 'etapa-row';
            tr.innerHTML =
                '<td data-label="Nº" class="etapa-nro"></td>' +
                '<td data-label="Qué es"><select name="EtapaTipos" class="sel-etapa-tipo">' + OPCIONES_TIPO_ETAPA + '</select></td>' +
                '<td data-label="Lugar / tramo"><input name="EtapaLugares" placeholder="(igual que el proveedor)" /></td>' +
                '<td data-label="Proveedor habitual"><select name="EtapaProveedorIds">' + OPCIONES_HOSPEDAJE + '</select></td>' +
                '<td class="num" data-label="Cuántos"><input name="EtapaCantidades" type="number" step="1" min="0" value="" style="display:none" class="in-cuantos" /></td>' +
                '<td class="num" data-label="Veces"><input name="EtapaNoches" type="number" step="1" min="1" value="1" class="in-noches" /></td>' +
                '<td class="num" data-label="Precio unitario"><input name="EtapaPrecios" type="number" step="0.01" min="0" class="in-precio-etapa" /><div class="etapa-calc"></div></td>' +
                '<td data-label="Incluye"><input name="EtapaIncluye" placeholder="Ej: merienda + cena + desayuno" /></td>' +
                '<td><button type="button" class="btn-mini btn-mini-danger" title="Borrar" onclick="quitarEtapa(this)">🗑</button></td>';
            document.getElementById('etapasBody').appendChild(tr);
            if (tipo) {
                var sel = tr.querySelector('.sel-etapa-tipo');
                if (sel) sel.value = tipo;
                aplicarTipoEtapa(tr, tipo);
            }
            renumerarEtapas();
            pintarCalculoEtapa(tr);
            tr.querySelector("input[name=EtapaLugares]").focus();
        }
        function quitarEtapa(btn) {
            if (!confirm('¿Realmente lo querés borrar?')) return;
            btn.closest('tr').remove();
            renumerarEtapas();
        }
        // Sólo las filas de HOSPEDAJE llevan número de noche, y se numeran de corrido: si
        // una fila son 2 noches, la siguiente arranca dos más adelante. Los traslados, los
        // arrieros y los caballos no son noches, así que muestran su ícono.
        function renumerarEtapas() {
            var filas = document.querySelectorAll('#etapasBody .etapa-row');
            var n = 1;
            for (var i = 0; i < filas.length; i++) {
                var sel = filas[i].querySelector('.sel-etapa-tipo');
                var tipo = sel ? sel.value : 'Hospedaje';
                var celda = filas[i].querySelector('.etapa-nro');
                if (tipo !== 'Hospedaje') { celda.textContent = '·'; continue; }
                var inp = filas[i].querySelector('.in-noches');
                var cuantas = inp ? (parseInt(inp.value) || 1) : 1;
                if (cuantas < 1) cuantas = 1;
                celda.textContent = cuantas === 1 ? n : (n + ' a ' + (n + cuantas - 1));
                n += cuantas;
            }
        }
        // Debajo del precio unitario: lo que REALMENTE se termina pagando por una unidad.
        // Acá todavía no se sabe cuánta gente va (eso es de cada salida), así que se muestra
        // el total de UNO: un arriero los 4 días, una persona las 2 noches, un auto.
        function plata(n) { return "$ " + (isNaN(n) ? 0 : Math.round(n)).toLocaleString("es-AR"); }

        function pintarCalculoEtapa(fila) {
            var caja = fila.querySelector('.etapa-calc');
            if (!caja) return;
            var sel = fila.querySelector('.sel-etapa-tipo');
            var tipo = sel ? sel.value : 'Hospedaje';
            var precio = parseFloat(fila.querySelector('.in-precio-etapa').value) || 0;
            var vecesInp = fila.querySelector('.in-noches');
            var veces = vecesInp ? (parseInt(vecesInp.value) || 1) : 1;
            if (veces < 1) veces = 1;

            if (precio <= 0) {
                caja.innerHTML = '<span style="color:var(--muted)">sale del precio del proveedor</span>';
                return;
            }

            var unidad = tipo === 'Traslado' ? 'por auto'
                       : tipo === 'Pasaje'   ? 'por boleto'
                       : tipo === 'Guía'     ? 'por guía'
                       : tipo === 'Arriero'  ? 'por arriero'
                       : tipo === 'Caballo'  ? 'por caballo'
                       :                       'por persona';

            // Si no hay nada que multiplicar (una sola vez), el total es el mismo precio que
            // ya está arriba: repetirlo no aporta y ocupa lugar. Sólo se aclara la unidad.
            if (veces <= 1) { caja.textContent = unidad; return; }

            var palabra = (tipo === 'Guía' || tipo === 'Arriero' || tipo === 'Caballo') ? 'días' : 'noches';
            caja.innerHTML = '× ' + veces + ' ' + palabra + ' = <b>' + plata(precio * veces) + '</b> ' + unidad;
        }

        function pintarTodosLosCalculos() {
            document.querySelectorAll('#etapasBody .etapa-row').forEach(pintarCalculoEtapa);
            calcularCuantoNosSale();
        }

        // ---- Cuánto nos sale a NOSOTROS la salida, con el mínimo de pasajeros ----
        //
        // Suma las dos partes: los costos de arriba (que se cuentan según su tipo) y todo
        // lo que se contrata para el grupo (noches, traslados, guías, arrieros, caballos).
        // Se rehace en cada tecla, así se ve al toque si la excursión cierra o no.
        var PERSONAS_POR_AUTO = @Wamani.Reservas.Models.Excursion.PersonasPorAuto;

        function calcularCuantoNosSale() {
            var caja = document.getElementById('cuantoNosSale');
            if (!caja) return;

            var min = parseInt(document.getElementById('Excursion_MinimoPersonas').value) || 0;
            if (min <= 0) { caja.innerHTML = ''; return; }

            // Cuántos guías van: hace falta antes, porque viajan en los autos y sacan boleto
            var guias = 0;
            document.querySelectorAll('#etapasBody .etapa-row').forEach(function (f) {
                if (f.querySelector('.sel-etapa-tipo').value !== 'Guía') return;
                guias += parseInt(f.querySelector('.in-cuantos').value) || 0;
            });
            if (guias <= 0) guias = 1;

            var total = 0;

            // 1) Los costos sueltos de arriba
            document.querySelectorAll('#gastosBody .gasto-row').forEach(function (tr) {
                var precio = parseFloat(tr.querySelector('[name=GastoPrecios]').value) || 0;
                if (precio <= 0) return;
                var tipo = tr.querySelector('[name=GastoTipos]').value;
                if (tipo === 'Por persona')      total += precio * min;
                else if (tipo === 'Por auto')    total += precio * Math.ceil(min / PERSONAS_POR_AUTO);
                else if (tipo === 'Cantidad')    total += precio * (parseInt(tr.querySelector('[name=GastoCantidades]').value) || 0);
                else                             total += precio;   // Fijo
            });

            // 2) Lo que se contrata para el grupo
            document.querySelectorAll('#etapasBody .etapa-row').forEach(function (f) {
                var precio = parseFloat(f.querySelector('.in-precio-etapa').value) || 0;
                if (precio <= 0) return;   // sin precio cargado no se puede contar
                var tipo = f.querySelector('.sel-etapa-tipo').value;
                var veces = parseInt(f.querySelector('.in-noches').value) || 1;
                if (veces < 1) veces = 1;

                // "Veces" cuenta en todos: un traslado que se hace dos veces (ida y vuelta)
                // se paga dos veces. El operativo ya lo contaba así; acá faltaba.
                if (tipo === 'Traslado')      total += precio * vehiculos(f, min, guias) * veces;
                else if (tipo === 'Pasaje')   total += precio * (min + guias) * veces;
                else if (esPorDia(tipo))      total += precio * (parseInt(f.querySelector('.in-cuantos').value) || 0) * veces;
                else                          total += precio * min * veces;   // Hospedaje
            });

            var porPersona = total / min;
            var cobramos = parseFloat(document.getElementById('Excursion_PrecioPorPersona').value) || 0;

            var html = '<div class="costo-titulo">Cuánto nos sale a nosotros</div>'
              + '<div class="costo-grande">' + plata(total) + '</div>'
              + '<div class="costo-detalle">con el mínimo de <b>' + min + '</b> pasajero' + (min === 1 ? '' : 's')
              + ' y <b>' + guias + '</b> guía' + (guias === 1 ? '' : 's')
              + ' &nbsp;·&nbsp; ' + plata(porPersona) + ' por persona</div>';

            if (cobramos > 0) {
                var ganancia = (cobramos * min) - total;
                var margen = total > 0 ? Math.round(ganancia / total * 100) : 0;
                var color = ganancia >= 0 ? 'var(--ok)' : 'var(--warn)';
                html += '<div class="costo-detalle" style="margin-top:8px">'
                  + 'Cobrando ' + plata(cobramos) + ' por persona entran <b>' + plata(cobramos * min) + '</b>, '
                  + 'así que ' + (ganancia >= 0 ? 'ganamos' : '<b>perdemos</b>') + ' '
                  + '<b style="color:' + color + '">' + plata(Math.abs(ganancia)) + '</b>'
                  + (ganancia >= 0 ? ' (' + margen + '% sobre el costo)' : '')
                  + '</div>';
            }

            html += '<div class="costo-nota">Es una estimación con los precios cargados acá. '
              + 'Los que estén en cero no se cuentan, y lo que sale del catálogo de Proveedores tampoco.</div>';

            caja.innerHTML = html;
        }

        // Recalcular ante cualquier cambio de precios, cantidades o tipos
        document.addEventListener('input', calcularCuantoNosSale);
        document.addEventListener('change', calcularCuantoNosSale);

        // Al cambiar las noches o el tipo de una fila se recorren las de abajo
        document.addEventListener('input', function (e) {
            if (e.target.classList.contains('in-noches')) renumerarEtapas();
            if (e.target.classList.contains('in-noches') || e.target.classList.contains('in-precio-etapa')) {
                pintarCalculoEtapa(e.target.closest('.etapa-row'));
            }
        });
        // Deja la fila acorde al tipo: los que van por día se contratan varios días y
        // llevan "cuántos"; en el resto la cantidad sale de la gente, así que se esconde.
        function esPorDia(tipo) { return tipo === 'Guía' || tipo === 'Arriero' || tipo === 'Caballo'; }

        // Cuántos vehículos paga un traslado. Si la fila dice un número, manda ese
        // (traslado contratado donde entra todo el grupo). Vacío = 1 auto cada 4.
        // Es la misma cuenta que hace EtapaExcursion.VehiculosPara en el servidor.
        function vehiculos(fila, pax, guias) {
            var inp = fila.querySelector('.in-cuantos');
            var fijo = inp ? (parseInt(inp.value) || 0) : 0;
            if (fijo > 0) return fijo;
            var cabezas = pax + guias;
            return cabezas <= 0 ? 0 : Math.ceil(cabezas / PERSONAS_POR_AUTO);
        }

        function aplicarTipoEtapa(fila, tipo) {
            var veces = fila.querySelector('.in-noches');
            if (veces) {
                if (tipo === 'Traslado' || tipo === 'Pasaje') veces.value = '1';
                else if (esPorDia(tipo)) veces.value = '4';
            }
            var cuantos = fila.querySelector('.in-cuantos');
            if (cuantos) {
                if (esPorDia(tipo)) {
                    cuantos.style.display = '';
                    if (!cuantos.value) cuantos.value = (tipo === 'Guía') ? '1' : '0';
                } else if (tipo === 'Traslado') {
                    // Se muestra vacío: así se ve que, si no se toca, lo calcula el sistema.
                    cuantos.style.display = '';
                    cuantos.placeholder = 'auto';
                    cuantos.title = 'Cuántos vehículos se pagan. Vacío = lo calcula solo (1 cada 4 personas).';
                } else {
                    cuantos.style.display = 'none';
                    cuantos.value = '';
                }
            }
        }

        document.addEventListener('change', function (e) {
            if (!e.target.classList.contains('sel-etapa-tipo')) return;
            var fila = e.target.closest('tr');
            aplicarTipoEtapa(fila, e.target.value);
            pintarCalculoEtapa(fila);
            renumerarEtapas();
        });
        renumerarEtapas();
        pintarTodosLosCalculos();

        // La sección de noches se abre sola en las travesías, y en cualquier otra excursión
        // con el botón. Nunca se esconde si ya hay noches cargadas: se perderían de vista.
        (function () {
            var chk = document.getElementById('Excursion_EsTravesia');
            var card = document.getElementById('cardEtapas');
            var btn = document.getElementById('btnVerNoches');
            if (!card) return;

            function abrir() {
                card.style.display = '';
                if (btn) btn.style.display = 'none';
                card.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
            function hayEtapasCargadas() {
                return document.querySelectorAll('#etapasBody .etapa-row').length > 0;
            }

            if (btn) btn.addEventListener('click', abrir);
            if (chk) chk.addEventListener('change', function () {
                if (chk.checked) { abrir(); return; }
                // Destildar "es travesía" no borra las noches ya cargadas
                if (hayEtapasCargadas()) return;
                card.style.display = 'none';
                if (btn) btn.style.display = '';
            });
        })();
    </script>
}
