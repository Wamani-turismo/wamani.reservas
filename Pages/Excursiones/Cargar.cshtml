@page
@model Wamani.Reservas.Pages.Excursiones.CargarModel
@{
    ViewData["Title"] = Model.EsNueva ? "Nueva excursión" : "Editar excursión";
    string Num(decimal m) => m.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    // La sección "dónde se duerme cada noche" NO es sólo de las travesías: cualquier
    // excursión que duerma fuera la necesita. "Conociendo las Yungas" son 3 días y 2
    // noches y no es una travesía; antes, para poder cargar sus noches había que tildarla
    // como travesía, y eso cambia el negocio (el saldo se pasa a cobrar 7 días antes en
    // vez de 4). Ahora se muestra sola si la excursión es travesía o si ya tiene noches
    // cargadas, y si no, aparece un botón para abrirla. Las de un día siguen sin verla.
    var hayNoches = Model.Excursion.EsTravesia || Model.Etapas.Count > 0;
    var estiloCardNoches = hayNoches ? "" : "display:none";
    var estiloBotonNoches = hayNoches ? "display:none" : "";
}

<h1>@(Model.EsNueva ? "Nueva excursión" : "Editar excursión")</h1>
<p class="subtitle">Precio en pesos argentinos ($), por persona.</p>

<form method="post">
    <input type="hidden" asp-for="Excursion.Id" />

    <div class="card">
        <div class="form-grid">
            <div class="field full">
                <label asp-for="Excursion.Nombre"></label>
                <input asp-for="Excursion.Nombre" placeholder="Ej: Serranías del Hornocal" />
                <span asp-validation-for="Excursion.Nombre" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Excursion.PrecioPorPersona"></label>
                <input asp-for="Excursion.PrecioPorPersona" type="number" step="0.01" min="0" />
                <span asp-validation-for="Excursion.PrecioPorPersona" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Excursion.MinimoPersonas"></label>
                <input asp-for="Excursion.MinimoPersonas" type="number" min="1" />
                <div class="hint">Mínimo para que la salida se realice.</div>
                <span asp-validation-for="Excursion.MinimoPersonas" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Excursion.MaximoPersonas"></label>
                <input asp-for="Excursion.MaximoPersonas" type="number" min="1" />
                <div class="hint">Máximo de pasajeros (ej: 8, o 15 en travesías).</div>
            </div>
            <div class="field full">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
                    <input asp-for="Excursion.EsTravesia" type="checkbox" style="width:auto" />
                    Es travesía (varios días) — el saldo se cobra 7 días antes en vez de 4
                </label>
            </div>
            <div class="field full">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
                    <input asp-for="Excursion.Activa" type="checkbox" style="width:auto" />
                    Activa (aparece para cargar reservas nuevas)
                </label>
            </div>
        </div>
    </div>

    <!-- ---------- Costos de la excursión ---------- -->
    <div class="card">
        <h2>Costos de la excursión</h2>
        <p class="hint" style="margin:-8px 0 14px">
            Cargá cada costo con su monto y <strong>cómo se cuenta</strong>: <em>por persona</em> (× pasajeros),
            <em>por auto (chofer-guía)</em> (× cantidad de autos, 1 cada @Wamani.Reservas.Models.Excursion.PersonasPorAuto —
            incluye al guía porque es el mismo chofer) o <em>fijo</em> (una vez por salida).
            Con esto se calcula la <strong>Rentabilidad</strong> y estos costos aparecen en el <strong>Operativo</strong> para pagarlos.
        </p>

        <table class="tabla" id="tablaGastos">
            <thead>
                <tr>
                    <th>Ítem / costo</th>
                    <th class="num" style="width:150px">Monto</th>
                    <th style="width:190px">Cómo se cuenta</th>
                    <th class="num" style="width:90px">Cantidad</th>
                    <th style="width:110px">¿Proveedor?</th>
                    <th style="width:60px"></th>
                </tr>
            </thead>
            <tbody id="gastosBody">
                @for (int i = 0; i < Model.Gastos.Count; i++)
                {
                    var gt = Model.Gastos[i].TipoCalculo;
                    var gp = Model.Gastos[i].EsProveedor;
                    // Precalculado acá a propósito: dentro de un atributo, las expresiones
                    // de Razor con comillas adentro son un dolor de cabeza.
                    var gcVal = Model.Gastos[i].Cantidad?.ToString() ?? "";
                    var gcEstilo = gt == "Cantidad" ? "" : "display:none";
                    <tr class="gasto-row">
                        <td data-label="Ítem"><input name="GastoNombres" value="@Model.Gastos[i].Nombre" placeholder="Ej: Nafta" /></td>
                        <td class="num" data-label="Monto"><input name="GastoPrecios" type="number" step="0.01" min="0" value="@Num(Model.Gastos[i].Precio)" /></td>
                        <td data-label="Cómo se cuenta">
                            <select name="GastoTipos" class="sel-tipo">
                                @foreach (var t in Wamani.Reservas.Models.GastoExcursion.Tipos)
                                {
                                    <option value="@t" selected="@(gt == t)">@Wamani.Reservas.Models.GastoExcursion.Etiqueta(t)</option>
                                }
                            </select>
                        </td>
                        @* Sólo se usa en los costos de tipo "Cantidad": es con cuántos
                           arranca cada salida (después se ajusta con los botones + y −). *@
                        <td class="num" data-label="Cantidad">
                            <input name="GastoCantidades" type="number" step="1" min="0" class="in-cant-plantilla"
                                   value="@gcVal" style="@gcEstilo" />
                        </td>
                        <td data-label="¿Proveedor?">
                            <label class="check-linea" title="Guía, auto, hospedaje o restaurante: cuenta en la Rentabilidad pero NO aparece en la lista del operativo (se paga en Proveedores).">
                                <input type="checkbox" onchange="this.nextElementSibling.value = this.checked ? '1' : '0'" @(gp ? "checked" : "") />
                                <input type="hidden" name="GastoEsProveedor" value="@(gp ? "1" : "0")" />
                            </label>
                        </td>
                        <td><button type="button" class="btn-mini btn-mini-danger" onclick="quitarGasto(this)">Quitar</button></td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="button" class="btn btn-ghost" style="margin-top:12px" onclick="agregarGasto()">+ Agregar costo</button>
    </div>

    <!-- ---------- Dónde se duerme cada noche ---------- -->
    @* Sirve para cualquier salida que duerma fuera, sea travesía o no: en las travesías
       se abre sola, en el resto con el botón de acá abajo (ver el script al final). *@
    <button type="button" class="btn btn-ghost" id="btnVerNoches" style="@estiloBotonNoches">
        🏨 Esta salida duerme fuera — cargar dónde se duerme cada noche
    </button>

    <div class="card" id="cardEtapas" style="@estiloCardNoches">
        <h2>Qué lleva esta salida</h2>
        <p class="hint" style="margin:-8px 0 14px">
            Todo lo que se contrata <strong>para el grupo entero</strong>: dónde se duerme,
            los traslados, los arrieros y los caballos. Se carga una vez acá y en el operativo
            de cada salida aparece listo, con el total ya calculado.
            <br />
            <strong>¿Para qué, si el proveedor ya está en Proveedores?</strong> En Proveedores
            está <em>quién es y cuánto cobra</em>. Acá se dice <em>en qué momento de esta salida
            se usa</em>. Con eso el operativo sale armado —<strong>una fila por parada, con todo
            el grupo junto</strong>— en vez de tener que cargar a mano una fila por pasajero.
            <br />
            No hace falta que sea travesía: sirve para cualquier salida que duerma fuera.
            <strong>“Conociendo las Yungas”</strong> son 3 días y 2 noches y se carga acá igual,
            con una sola fila de 2 noches.
        </p>
        <div class="hint" style="margin:-6px 0 14px">
            <strong>Cómo se cuenta cada fila</strong> (siempre cantidad × precio × veces):
            <ul style="margin:6px 0 0 18px">
                <li>🏨 <strong>Hospedaje</strong> — personas × precio por persona × <em>noches</em>.
                    Si dormís 2 noches seguidas en el mismo lado, poné 2 en “Veces”: una sola fila.</li>
                <li>🚐 <strong>Traslado</strong> — autos × precio por auto. Entran 4 por auto
                    <em>contando a los guías</em>, así que el operativo te sugiere cuántos hacen falta.</li>
                <li>🎟️ <strong>Pasajes</strong> — para el micro, donde se saca un boleto por cabeza:
                    pasajes × precio del boleto. También cuenta a los guías.</li>
                <li>🧑‍🌾 <strong>Arriero</strong> y 🐴 <strong>Caballo</strong> — cuántos × precio por día
                    × <em>días</em>. Cuántos van lo decidís en cada salida, no sale de ninguna fórmula.</li>
            </ul>
            El <strong>lugar/tramo</strong> es opcional: si lo dejás vacío se usa el nombre del
            proveedor. El <strong>precio</strong> también: si lo dejás en cero sale del catálogo de
            Proveedores, así lo actualizás en un solo lugar.
        </div>

        <table class="tabla" id="tablaEtapas">
            <thead>
                <tr>
                    <th style="width:70px">Nº</th>
                    <th style="width:130px">Qué es</th>
                    <th>Lugar / tramo</th>
                    <th style="width:200px">Proveedor habitual</th>
                    <th class="num" style="width:90px">Veces</th>
                    <th class="num" style="width:150px">Precio unitario</th>
                    <th>Notas / incluye</th>
                    <th style="width:60px"></th>
                </tr>
            </thead>
            <tbody id="etapasBody">
                @for (int i = 0; i < Model.Etapas.Count; i++)
                {
                    var et = Model.Etapas[i];
                    // Precalculado para no meter un ">" adentro de un atributo (rompe Razor).
                    // El número de noche real lo escribe el JS al cargar la página, porque
                    // una fila puede valer por varias noches.
                    var etNoches = et.Noches > 0 ? et.Noches : 1;
                    <tr class="etapa-row" data-tipo="@et.Tipo">
                        <td data-label="Nº" class="etapa-nro">@(i + 1)</td>
                        <td data-label="Qué es">
                            <select name="EtapaTipos" class="sel-etapa-tipo">
                                @foreach (var t in Wamani.Reservas.Models.EtapaExcursion.Tipos)
                                {
                                    <option value="@t" selected="@(et.Tipo == t)">@Wamani.Reservas.Models.EtapaExcursion.Icono(t) @t</option>
                                }
                            </select>
                        </td>
                        <td data-label="Lugar / tramo"><input name="EtapaLugares" value="@et.Lugar" placeholder="(igual que el proveedor)" /></td>
                        <td data-label="Proveedor habitual">
                            @* Van todos los proveedores agrupados por tipo: una fila puede
                               ser un refugio, una agencia de autos o un arriero. *@
                            <select name="EtapaProveedorIds">
                                <option value="0">— sin asignar —</option>
                                @foreach (var grupo in Model.ProveedoresActivos.GroupBy(p => p.Tipo))
                                {
                                    <optgroup label="@grupo.Key">
                                        @foreach (var h in grupo)
                                        {
                                            <option value="@h.Id" selected="@(et.ProveedorId == h.Id)">@h.Nombre</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </td>
                        <td class="num" data-label="Veces"><input name="EtapaNoches" type="number" step="1" min="1" value="@etNoches" class="in-noches" /></td>
                        <td class="num" data-label="Precio unitario"><input name="EtapaPrecios" type="number" step="0.01" min="0" value="@Num(et.PrecioPorPersona)" /></td>
                        <td data-label="Incluye"><input name="EtapaIncluye" value="@et.Incluye" placeholder="Ej: merienda + cena + desayuno" /></td>
                        <td><button type="button" class="btn-mini btn-mini-danger" onclick="quitarEtapa(this)">Quitar</button></td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="acciones-fila" style="margin-top:12px">
            <button type="button" class="btn btn-ghost" onclick="agregarEtapa('Hospedaje')">🏨 + Noche</button>
            <button type="button" class="btn btn-ghost" onclick="agregarEtapa('Traslado')">🚐 + Traslado (por auto)</button>
            <button type="button" class="btn btn-ghost" onclick="agregarEtapa('Pasaje')">🎟️ + Pasajes (por persona)</button>
            <button type="button" class="btn btn-ghost" onclick="agregarEtapa('Arriero')">🧑‍🌾 + Arrieros</button>
            <button type="button" class="btn btn-ghost" onclick="agregarEtapa('Caballo')">🐴 + Caballos</button>
        </div>
    </div>

    <!-- ---------- Contenido para la Guía (PDF) ---------- -->
    <div class="card">
        <h2>Contenido para la Guía (PDF)</h2>
        <p class="hint" style="margin:-8px 0 14px">
            Esto se carga a mano por cada excursión y queda guardado. Después aparece en la Guía en PDF de cada salida.
        </p>
        <div class="form-grid">
            <div class="field full">
                <label asp-for="Excursion.GuiaBreve"></label>
                <textarea asp-for="Excursion.GuiaBreve" rows="4" placeholder="Contá brevemente de qué se trata la excursión / travesía…"></textarea>
            </div>
            <div class="field full">
                <label asp-for="Excursion.Recomendaciones"></label>
                <textarea asp-for="Excursion.Recomendaciones" rows="4" placeholder="Ej: calzado cómodo, protector solar, agua, abrigo, documento…"></textarea>
            </div>
            <div class="field full">
                <label asp-for="Excursion.LugaresVisitar"></label>
                <textarea asp-for="Excursion.LugaresVisitar" rows="4" placeholder="Ej: Salinas Grandes, Purmamarca, Cuesta de Lipán…"></textarea>
            </div>
        </div>
    </div>

    <div class="acciones-form">
        <button type="submit" class="btn btn-primary">💾 Guardar excursión</button>
        <a class="btn btn-ghost" asp-page="/Excursiones/Index">Cancelar</a>

        @if (!Model.EsNueva)
        {
            <button type="submit" class="btn btn-danger" style="margin-left:auto"
                    asp-page-handler="Eliminar" asp-route-id="@Model.Excursion.Id"
                    onclick="return confirm('¿Eliminar esta excursión? Si ya tiene reservas, se ocultará en vez de borrarse.');">
                🗑 Eliminar
            </button>
        }
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @{
        // Opciones del desplegable de proveedores (agrupadas por tipo) para las filas que
        // se agregan desde el botón. Se arma acá para no meter C# adentro del JavaScript.
        var sbHosp = new System.Text.StringBuilder("<option value=\"0\">— sin asignar —</option>");
        foreach (var grupo in Model.ProveedoresActivos.GroupBy(p => p.Tipo))
        {
            sbHosp.Append("<optgroup label=\"")
                  .Append(System.Net.WebUtility.HtmlEncode(grupo.Key)).Append("\">");
            foreach (var h in grupo)
            {
                sbHosp.Append("<option value=\"").Append(h.Id).Append("\">")
                      .Append(System.Net.WebUtility.HtmlEncode(h.Nombre)).Append("</option>");
            }
            sbHosp.Append("</optgroup>");
        }
        var opcionesHospedaje = sbHosp.ToString();

        // Opciones del desplegable "qué es", para esas mismas filas nuevas
        var sbTipos = new System.Text.StringBuilder();
        foreach (var t in Wamani.Reservas.Models.EtapaExcursion.Tipos)
        {
            sbTipos.Append("<option value=\"").Append(t).Append("\">")
                   .Append(Wamani.Reservas.Models.EtapaExcursion.Icono(t)).Append(' ')
                   .Append(t).Append("</option>");
        }
        var opcionesTipoEtapa = sbTipos.ToString();
    }
    <script>
        function agregarGasto(nombre, precio) {
            var tr = document.createElement('tr');
            tr.className = 'gasto-row';
            tr.innerHTML =
                '<td data-label="Ítem"><input name="GastoNombres" placeholder="Ej: Nafta" value="' + (nombre || '') + '" /></td>' +
                '<td class="num" data-label="Monto"><input name="GastoPrecios" type="number" step="0.01" min="0" value="' + (precio || '') + '" /></td>' +
                '<td data-label="Cómo se cuenta"><select name="GastoTipos" class="sel-tipo">' +
                '<option value="Por persona">Por persona</option>' +
                '<option value="Por auto">Por auto (chofer-guía)</option>' +
                '<option value="Cantidad">Cantidad (se ajusta en cada salida)</option>' +
                '<option value="Fijo">Fijo</option>' +
                '</select></td>' +
                '<td class="num" data-label="Cantidad"><input name="GastoCantidades" type="number" step="1" min="0" class="in-cant-plantilla" value="" style="display:none" /></td>' +
                '<td data-label="¿Proveedor?"><label class="check-linea"><input type="checkbox" onchange="this.nextElementSibling.value = this.checked ? \'1\' : \'0\'" /><input type="hidden" name="GastoEsProveedor" value="0" /></label></td>' +
                '<td><button type="button" class="btn-mini btn-mini-danger" onclick="quitarGasto(this)">Quitar</button></td>';
            document.getElementById('gastosBody').appendChild(tr);
            tr.querySelector('input').focus();
        }
        function quitarGasto(btn) {
            btn.closest('tr').remove();
        }

        // La cantidad sólo tiene sentido en los costos de tipo "Cantidad" (arrieros,
        // caballos, guías, traslados): en los demás se esconde para no confundir.
        document.addEventListener('change', function (e) {
            if (!e.target.classList.contains('sel-tipo')) return;
            var fila = e.target.closest('tr');
            var cant = fila.querySelector('.in-cant-plantilla');
            if (!cant) return;
            var esCantidad = e.target.value === 'Cantidad';
            cant.style.display = esCantidad ? '' : 'none';
            if (esCantidad) { if (!cant.value) cant.value = '1'; cant.focus(); }
            else { cant.value = ''; }
        });

        // ---- Lo que lleva la salida: noches, traslados, arrieros y caballos ----
        var OPCIONES_HOSPEDAJE = '@Html.Raw(opcionesHospedaje)';
        var OPCIONES_TIPO_ETAPA = '@Html.Raw(opcionesTipoEtapa)';

        function agregarEtapa(tipo) {
            var tr = document.createElement('tr');
            tr.className = 'etapa-row';
            tr.innerHTML =
                '<td data-label="Nº" class="etapa-nro"></td>' +
                '<td data-label="Qué es"><select name="EtapaTipos" class="sel-etapa-tipo">' + OPCIONES_TIPO_ETAPA + '</select></td>' +
                '<td data-label="Lugar / tramo"><input name="EtapaLugares" placeholder="(igual que el proveedor)" /></td>' +
                '<td data-label="Proveedor habitual"><select name="EtapaProveedorIds">' + OPCIONES_HOSPEDAJE + '</select></td>' +
                '<td class="num" data-label="Veces"><input name="EtapaNoches" type="number" step="1" min="1" value="1" class="in-noches" /></td>' +
                '<td class="num" data-label="Precio unitario"><input name="EtapaPrecios" type="number" step="0.01" min="0" /></td>' +
                '<td data-label="Incluye"><input name="EtapaIncluye" placeholder="Ej: merienda + cena + desayuno" /></td>' +
                '<td><button type="button" class="btn-mini btn-mini-danger" onclick="quitarEtapa(this)">Quitar</button></td>';
            document.getElementById('etapasBody').appendChild(tr);
            if (tipo) {
                var sel = tr.querySelector('.sel-etapa-tipo');
                if (sel) sel.value = tipo;
                var veces = tr.querySelector('.in-noches');
                // Arrieros y caballos nos acompañan toda la travesía (4 días); el resto, 1
                if (veces && (tipo === 'Arriero' || tipo === 'Caballo')) veces.value = '4';
            }
            renumerarEtapas();
            tr.querySelector('input[name=EtapaLugares]').focus();
        }
        function quitarEtapa(btn) {
            btn.closest('tr').remove();
            renumerarEtapas();
        }
        // Sólo las filas de HOSPEDAJE llevan número de noche, y se numeran de corrido: si
        // una fila son 2 noches, la siguiente arranca dos más adelante. Los traslados, los
        // arrieros y los caballos no son noches, así que muestran su ícono.
        function renumerarEtapas() {
            var filas = document.querySelectorAll('#etapasBody .etapa-row');
            var n = 1;
            for (var i = 0; i < filas.length; i++) {
                var sel = filas[i].querySelector('.sel-etapa-tipo');
                var tipo = sel ? sel.value : 'Hospedaje';
                var celda = filas[i].querySelector('.etapa-nro');
                if (tipo !== 'Hospedaje') { celda.textContent = '·'; continue; }
                var inp = filas[i].querySelector('.in-noches');
                var cuantas = inp ? (parseInt(inp.value) || 1) : 1;
                if (cuantas < 1) cuantas = 1;
                celda.textContent = cuantas === 1 ? n : (n + ' a ' + (n + cuantas - 1));
                n += cuantas;
            }
        }
        // Al cambiar las noches o el tipo de una fila se recorren las de abajo
        document.addEventListener('input', function (e) {
            if (e.target.classList.contains('in-noches')) renumerarEtapas();
        });
        document.addEventListener('change', function (e) {
            if (!e.target.classList.contains('sel-etapa-tipo')) return;
            // Los arrieros y los caballos se contratan por días (4 en estas travesías);
            // un traslado es una sola vez.
            var fila = e.target.closest('tr');
            var veces = fila.querySelector('.in-noches');
            if (veces) {
                if (e.target.value === 'Traslado' || e.target.value === 'Pasaje') veces.value = '1';
                else if (e.target.value === 'Arriero' || e.target.value === 'Caballo') veces.value = '4';
            }
            renumerarEtapas();
        });
        renumerarEtapas();

        // La sección de noches se abre sola en las travesías, y en cualquier otra excursión
        // con el botón. Nunca se esconde si ya hay noches cargadas: se perderían de vista.
        (function () {
            var chk = document.getElementById('Excursion_EsTravesia');
            var card = document.getElementById('cardEtapas');
            var btn = document.getElementById('btnVerNoches');
            if (!card) return;

            function abrir() {
                card.style.display = '';
                if (btn) btn.style.display = 'none';
                card.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
            function hayEtapasCargadas() {
                return document.querySelectorAll('#etapasBody .etapa-row').length > 0;
            }

            if (btn) btn.addEventListener('click', abrir);
            if (chk) chk.addEventListener('change', function () {
                if (chk.checked) { abrir(); return; }
                // Destildar "es travesía" no borra las noches ya cargadas
                if (hayEtapasCargadas()) return;
                card.style.display = 'none';
                if (btn) btn.style.display = '';
            });
        })();
    </script>
}
