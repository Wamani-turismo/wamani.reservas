@page
@model Wamani.Reservas.Pages.Excursiones.IndexModel
@{
    ViewData["Title"] = "Excursiones";
    var ci = System.Globalization.CultureInfo.GetCultureInfo("es-AR");
    string Money(decimal m) => "$ " + m.ToString("N0", ci);
}

<h1>Excursiones y precios</h1>
<p class="subtitle">Acá administrás las excursiones, sus precios por persona y el mínimo de pasajeros.</p>

@if (!string.IsNullOrEmpty(Model.Aviso))
{
    <div class="aviso-ok">@Model.Aviso</div>
}

@* Un colaborador con acceso limitado ve sólo sus excursiones y no puede crear ninguna *@
@{ var soloLoSuyo = Wamani.Reservas.Services.Permisos.EsLimitado(User); }

<div class="toolbar">
    @if (!soloLoSuyo)
    {
        <a href="/">← Volver a reservas</a>
        <a class="btn-nueva" asp-page="/Excursiones/Cargar">+ Nueva excursión</a>
        <button type="button" class="btn-nueva" onclick="verMedida()">✨ A medida</button>
    }
    else
    {
        <a asp-page="/Operativo/Index">← Volver al operativo</a>
    }
</div>

@* Armar un viaje a medida: se copia una excursión que ya existe y se le suman días. *@
<div class="card" id="caja-medida" style="display:none" hidden="@soloLoSuyo">
    <h2>Armar un viaje a medida</h2>
    <p class="hint" style="margin:-6px 0 16px">
        Elegí la excursión que van a hacer de base y cuántos días se agregan. El sistema copia
        todos sus costos y proveedores a una excursión nueva, y suma los renglones de cada día
        extra en cero para que sólo les pongas el precio. La excursión de base no se toca.
    </p>
    <form method="post" asp-page-handler="AMedida" class="form-grid">
        <div class="field">
            <label for="BaseId">Excursión de base</label>
            <select id="BaseId" name="BaseId" required>
                <option value="">— elegí una —</option>
                <optgroup label="Excursiones y travesías">
                    @foreach (var e in Model.DelCatalogo.Where(x => x.Activa))
                    {
                        <option value="@e.Id">@e.Nombre</option>
                    }
                </optgroup>
                @* Repetir un viaje a medida que ya se armó: se elige de base y se copia entero *@
                @if (Model.AMedida.Any(x => x.Activa))
                {
                    <optgroup label="Repetir un viaje a medida">
                        @foreach (var e in Model.AMedida.Where(x => x.Activa))
                        {
                            <option value="@e.Id">@e.Nombre</option>
                        }
                    </optgroup>
                }
            </select>
        </div>
        <div class="field">
            <label for="NombreMedida">Nombre del viaje</label>
            <input id="NombreMedida" name="NombreMedida" maxlength="120" required
                   placeholder="Ej: Yungas + Quebrada — familia Canella" />
            <div class="hint">Se guarda como «A medida · …» para reconocerlo en la lista.</div>
        </div>
        <div class="field">
            <label for="DiasExtra">Días que se agregan</label>
            <input id="DiasExtra" name="DiasExtra" type="number" min="0" max="15" value="1" />
            <div class="hint">Por cada día se agregan 5 renglones: hospedaje, comidas, entradas, chofer y guía, y nafta.</div>
        </div>
        <div class="field" style="align-self:end">
            <button type="submit" class="btn btn-primary">Crear el viaje a medida</button>
        </div>
    </form>
</div>

<script>
    function verMedida() {
        var c = document.getElementById('caja-medida');
        c.style.display = c.style.display === 'none' ? '' : 'none';
        if (c.style.display === '') c.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
</script>

@if (Model.Excursiones.Count == 0)
{
    <div class="table-wrap">
        <div class="empty">
            <div class="big">🧭</div>
            <p>Todavía no hay excursiones cargadas.</p>
            <a class="btn btn-primary" asp-page="/Excursiones/Cargar">Cargar la primera</a>
        </div>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="tabla">
            <thead>
                <tr>
                    <th>Excursión / Travesía</th>
                    <th class="num">Precio por persona</th>
                    <th class="num">Mínimo</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var e in Model.DelCatalogo)
            {
                <tr>
                    <td data-label="Excursión"><strong>@e.Nombre</strong></td>
                    <td class="num" data-label="Precio por persona">@Money(e.PrecioPorPersona)</td>
                    <td class="num" data-label="Mínimo">@e.MinimoPersonas</td>
                    <td data-label="Estado">
                        @if (e.Activa)
                        {
                            <span class="pill pill-ok">Activa</span>
                        }
                        else
                        {
                            <span class="pill pill-muted">Oculta</span>
                        }
                    </td>
                    <td class="acciones" data-label="">
                        <a asp-page="/Excursiones/Cargar" asp-route-id="@e.Id">Editar</a>
                        @* Entrada a las reservas que no depende de que haya una salida próxima *@
                        <a asp-page="/Operativo/Reservas" asp-route-excursionId="@e.Id">👥 Reservas</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @* ── LA COMBI DE WAMANI ──────────────────────────────────────────────
       Va aparte porque se lee distinto: acá no importa el margen por persona sino
       CUÁNTAS BUTACAS hay que vender, que es lo único que mueve la aguja cuando el
       costo es casi todo fijo. *@
    @if (Model.Combis.Count > 0)
    {
        <h2 style="margin-top:36px">🚐 La Combi de Wamani</h2>
        <p class="subtitle" style="margin-top:-6px">
            Salidas regulares desde San Salvador en traffic alquilada, vendidas <strong>por butaca</strong>.
            La traffic y la guía se pagan igual vayan 4 personas o 19, así que lo que decide si
            ganás o perdés es cuántas butacas vendés.
        </p>
        <div class="table-wrap">
            <table class="tabla">
                <thead>
                    <tr>
                        <th>Salida</th>
                        <th class="num">Precio por butaca</th>
                        <th class="num">Sale vacía</th>
                        <th class="num">Cada butaca</th>
                        <th class="num">Butacas para empatar</th>
                        @* Probar una ocupación floja sin hacer cuentas a mano: "¿y si sólo
                           vienen 6?". Es la pregunta que se hace antes de decidir si una
                           salida sale o se cancela. *@
                        <th class="num" style="white-space:nowrap">
                            Si vendés
                            <input id="combiN" type="number" min="1" max="40" value="6"
                                   style="width:56px;padding:2px 4px;border:1px solid var(--linea,#d8d3c6);border-radius:6px;font:inherit;text-align:center" />
                        </th>
                        <th class="num">Si va llena</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var e in Model.Combis)
                {
                    var n = Model.Numeros.GetValueOrDefault(e.Id);
                    var lleno = e.MaximoPersonas > 0 ? e.MaximoPersonas : 19;
                    <tr>
                        <td data-label="Salida">
                            <strong>@e.Nombre</strong>
                            @if (!e.Activa)
                            {
                                <span class="pill pill-muted" style="margin-left:6px">Oculta</span>
                            }
                        </td>
                        <td class="num" data-label="Precio por butaca">
                            @if (e.PrecioPorPersona > 0)
                            {
                                @Money(e.PrecioPorPersona)
                            }
                            else
                            {
                                <span class="pill pill-muted">sin precio</span>
                            }
                        </td>
                        <td class="num" data-label="Sale vacía">@(n is null ? "—" : Money(n.CostoSalidaVacia))</td>
                        <td class="num" data-label="Cada butaca">@(n is null ? "—" : Money(n.CostoPorButaca))</td>
                        <td class="num" data-label="Butacas para empatar">
                            @if (n is null || e.PrecioPorPersona <= 0)
                            {
                                <span class="cliente-sub">falta el precio</span>
                            }
                            else if (n.ButacasParaEmpatar == 0)
                            {
                                <strong style="color:var(--warn)">no cierra ni llena</strong>
                            }
                            else
                            {
                                <strong style="font-size:1.15rem">@n.ButacasParaEmpatar</strong>
                                <span class="cliente-sub"> de @lleno</span>
                            }
                        </td>
                        <td class="num" data-label="Si vendés esas butacas">
                            @* En invariante a propósito: el JS los lee con parseFloat, que
                               no entiende la coma decimal del formato argentino. *@
                            <span class="combi-res"
                                  data-fijo="@((n?.CostoSalidaVacia ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                  data-butaca="@((n?.CostoPorButaca ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                  data-precio="@e.PrecioPorPersona.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                  data-max="@lleno">—</span>
                        </td>
                        <td class="num" data-label="Si va llena">
                            @if (n is null || e.PrecioPorPersona <= 0)
                            {
                                <text>—</text>
                            }
                            else
                            {
                                var color = n.GananciaLlena < 0 ? "var(--warn)" : "var(--accent)";
                                <strong style="color:@color">@Money(n.GananciaLlena)</strong>
                            }
                        </td>
                        <td class="acciones" data-label="">
                            <a asp-page="/Excursiones/Cargar" asp-route-id="@e.Id">Editar</a>
                            <a asp-page="/Rentabilidad/Detalle" asp-route-id="@e.Id">📊 Números</a>
                            <a asp-page="/Operativo/Reservas" asp-route-excursionId="@e.Id">👥 Butacas</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <p class="hint" style="margin-top:8px">
            <strong>Sale vacía</strong> es lo que pagás aunque no vendas una sola butaca (la traffic,
            la guía y sus viáticos). <strong>Cada butaca</strong> es lo que suma un pasajero más
            (snacks y su seguro). De ahí sale cuántas hacen falta para empatar.
            Cambiá el número de arriba para ver <strong>cuánto ganás o perdés con la ocupación
            que quieras</strong>: sirve para decidir si una salida floja sale igual o se cancela.
        </p>

        <script>
        // Cuánto deja cada combi con la ocupación que se pruebe.
        //
        // Se calcula acá y no en el servidor para que cambie al toque mientras se mueve el
        // número. La cuenta es exacta porque en una combi todo costo es de una de dos clases:
        // o se paga igual vaya quien vaya (la traffic, la guía) o va por butaca (snacks,
        // seguro). No hay saltos como el "otro auto cada 4 personas" de las excursiones
        // comunes, así que alcanza con: precio × butacas − (fijo + porButaca × butacas).
        (function () {
            var inp = document.getElementById('combiN');
            if (!inp) return;

            function plata(v) {
                var s = Math.round(Math.abs(v)).toLocaleString('es-AR');
                return (v < 0 ? '−$ ' : '$ ') + s;
            }

            function pintar() {
                var n = parseInt(inp.value, 10) || 0;
                document.querySelectorAll('.combi-res').forEach(function (el) {
                    var fijo = parseFloat(el.dataset.fijo) || 0;
                    var porButaca = parseFloat(el.dataset.butaca) || 0;
                    var precio = parseFloat(el.dataset.precio) || 0;
                    var tope = parseInt(el.dataset.max, 10) || 0;

                    if (precio <= 0 || n <= 0) { el.textContent = '—'; el.removeAttribute('style'); return; }
                    if (tope > 0 && n > tope) {
                        el.textContent = 'no entran';
                        el.style.color = 'var(--muted)';
                        return;
                    }
                    var ganancia = precio * n - (fijo + porButaca * n);
                    el.textContent = plata(ganancia);
                    el.style.color = ganancia < 0 ? 'var(--warn)' : 'var(--accent)';
                    el.style.fontWeight = '700';
                });
                // Queda elegido el número que se usó la última vez, en esta computadora.
                try { localStorage.setItem('wamani-combi-butacas', String(n)); } catch (e) { }
            }

            try {
                var guardado = localStorage.getItem('wamani-combi-butacas');
                if (guardado) inp.value = guardado;
            } catch (e) { }

            inp.addEventListener('input', pintar);
            pintar();
        })();
        </script>
    }

    @* Los viajes a medida, aparte y al final: no son parte del catálogo de siempre. *@
    @if (Model.AMedida.Count > 0)
    {
        <h2 style="margin-top:36px">Viajes a medida</h2>
        <p class="subtitle" style="margin-top:-6px">
            Armados para un grupo puntual. Si mañana otro grupo quiere hacer el mismo viaje,
            no hace falta cargarlo de nuevo: tocá <strong>✨ A medida</strong> y elegí este mismo
            como base. Se copia entero y sólo cambiás fechas, precio y lo que haga falta.
        </p>
        <div class="table-wrap">
            <table class="tabla">
                <thead>
                    <tr>
                        <th>Viaje a medida</th>
                        <th class="num">Precio por persona</th>
                        <th class="num">Mínimo</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var e in Model.AMedida)
                {
                    <tr>
                        <td data-label="Viaje"><strong>@e.Nombre</strong></td>
                        <td class="num" data-label="Precio por persona">@Money(e.PrecioPorPersona)</td>
                        <td class="num" data-label="Mínimo">@e.MinimoPersonas</td>
                        <td data-label="Estado">
                            @if (e.Activa)
                            {
                                <span class="pill pill-ok">Activa</span>
                            }
                            else
                            {
                                <span class="pill pill-muted">Oculta</span>
                            }
                        </td>
                        <td class="acciones" data-label="">
                            <a asp-page="/Excursiones/Cargar" asp-route-id="@e.Id">Editar</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}
