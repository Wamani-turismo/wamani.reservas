@page
@model Wamani.Reservas.Pages.Extras.IndexModel
@{
    ViewData["Title"] = "Ingresos extra";
    var ci = System.Globalization.CultureInfo.GetCultureInfo("es-AR");
    string Money(decimal m) => "$ " + m.ToString("N0", ci);
    var mesPrev = Model.MesActual.AddMonths(-1).ToString("yyyy-MM");
    var mesNext = Model.MesActual.AddMonths(1).ToString("yyyy-MM");
}

<div class="toolbar">
    <div>
        <h1>Ingresos extra</h1>
        <p class="subtitle" style="margin:0">
            Plata que entra por fuera de las reservas: comisiones por alquilar un auto o
            conseguir un hospedaje, servicios sueltos, lo que sea. Suma como ingreso en
            Finanzas y en la Caja, por su fecha.
        </p>
    </div>
    <a class="btn btn-ghost" asp-page="/Financiera/Index" asp-route-mes="@Model.MesActual.ToString("yyyy-MM")">💰 Ver en Finanzas</a>
</div>

@if (!string.IsNullOrEmpty(Model.Aviso))
{
    <div class="aviso-ok">@Model.Aviso</div>
}

<div class="mes-nav">
    <a class="btn-mini btn-mini-ghost" asp-page="/Extras/Index" asp-route-mes="@mesPrev">← Mes anterior</a>
    <span class="mes-titulo">@Model.MesTexto</span>
    <a class="btn-mini btn-mini-ghost" asp-page="/Extras/Index" asp-route-mes="@mesNext">Mes siguiente →</a>
    <form method="get" style="margin-left:auto">
        <input class="search" type="month" name="Mes" value="@Model.MesActual.ToString("yyyy-MM")" onchange="this.form.submit()" style="min-width:0" />
    </form>
</div>

<div class="fin-cards">
    <div class="fin-card">
        <div class="fin-label">Extra de @Model.MesTexto</div>
        <div class="fin-val" style="color:var(--ok)">@Money(Model.Total)</div>
        <div class="fin-label" style="margin-top:4px">@Model.Lista.Count movimiento(s)</div>
    </div>
    <div class="fin-card">
        <div class="fin-label">Extra histórico</div>
        <div class="fin-val">@Money(Model.TotalHistorico)</div>
        <div class="fin-label" style="margin-top:4px">todo lo cargado hasta hoy</div>
    </div>
</div>

<!-- Cargar un ingreso extra -->
<div class="card" style="margin-top:12px">
    <h2>Agregar un ingreso extra</h2>
    <form method="post" enctype="multipart/form-data" asp-page-handler="Agregar">
        <div class="form-grid">
            <div class="field"><label>Fecha</label><input asp-for="NuevoFecha" type="date" /></div>
            <div class="field">
                <label>Motivo</label>
                <select asp-for="NuevoMotivo">
                    @foreach (var m in Wamani.Reservas.Models.IngresoExtra.Motivos) { <option value="@m">@m</option> }
                </select>
            </div>
            <div class="field full">
                <label>Descripción</label>
                <input asp-for="NuevoDescripcion" placeholder="Ej: Comisión por alquiler de auto 3 días" />
            </div>
            <div class="field">
                <label>De quién (opcional)</label>
                <input asp-for="NuevoDeQuien" placeholder="Ej: Ser Rent Car / cliente Ana" />
            </div>
            <div class="field"><label>Monto</label><input asp-for="NuevoMonto" type="number" step="0.01" min="0" /></div>
            <div class="field"><label>Comprobante (opcional)</label><input asp-for="NuevoComprobante" type="file" accept="image/*,.pdf" multiple /></div>
        </div>
        <div class="acciones-form" style="margin-top:12px">
            <button type="submit" class="btn btn-primary">+ Agregar ingreso extra</button>
        </div>
    </form>
</div>

<!-- Lista del mes -->
<div class="table-wrap" style="margin-top:18px">
    <table class="tabla">
        <thead>
            <tr><th>Fecha</th><th>Motivo</th><th>Descripción</th><th>De quién</th><th class="num">Monto</th><th>Comprobante</th><th></th></tr>
        </thead>
        <tbody>
        @if (Model.Lista.Count == 0)
        {
            <tr><td colspan="7" style="text-align:center;color:var(--muted);padding:30px">No hay ingresos extra cargados este mes.</td></tr>
        }
        @foreach (var e in Model.Lista)
        {
            <tr>
                <td data-label="Fecha">@e.Fecha.ToString("dd/MM/yy")</td>
                <td data-label="Motivo">@e.Motivo</td>
                <td data-label="Descripción">@e.Descripcion</td>
                <td data-label="De quién">@(string.IsNullOrWhiteSpace(e.DeQuien) ? "—" : e.DeQuien)</td>
                <td class="num" data-label="Monto" style="color:var(--ok)">@Money(e.Monto)</td>
                <td data-label="Comprobante">
                    @if (!string.IsNullOrEmpty(e.Comprobante))
                    {
                        <partial name="_Adjuntos" model="@e.Comprobante" />
                    }
                    else
                    {
                        <span class="cliente-sub">—</span>
                    }
                </td>
                <td>
                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@e.Id" style="display:inline"
                          onsubmit="return confirm('¿Borrar este ingreso extra?');">
                        <input type="hidden" asp-for="Mes" />
                        <button type="submit" class="btn-mini btn-mini-danger" title="Borrar"
                                onclick="return confirm('¿Realmente lo querés borrar?');">🗑</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
        @if (Model.Lista.Count > 0)
        {
            <tfoot>
                <tr>
                    <td colspan="4"><strong>Total del mes</strong></td>
                    <td class="num"><strong style="color:var(--ok)">@Money(Model.Total)</strong></td>
                    <td colspan="2"></td>
                </tr>
            </tfoot>
        }
    </table>
</div>
