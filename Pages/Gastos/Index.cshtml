@page
@model Wamani.Reservas.Pages.Gastos.IndexModel
@{
    ViewData["Title"] = "Gastos";
    var ci = System.Globalization.CultureInfo.GetCultureInfo("es-AR");
    string Money(decimal m) => "$ " + m.ToString("N0", ci);
    var mesPrev = Model.MesActual.AddMonths(-1).ToString("yyyy-MM");
    var mesNext = Model.MesActual.AddMonths(1).ToString("yyyy-MM");
}

<div class="toolbar">
    <div>
        <h1>Gastos de la empresa</h1>
        <p class="subtitle" style="margin:0">Publicidad, botiquín, etc. Se descuentan del neto del mes en Finanzas.</p>
    </div>
    <a class="btn btn-ghost" asp-page="/Financiera/Index" asp-route-mes="@Model.MesActual.ToString("yyyy-MM")">💰 Ver en Finanzas</a>
</div>

@if (!string.IsNullOrEmpty(Model.Aviso))
{
    <div class="aviso-ok">@Model.Aviso</div>
}

<div class="mes-nav">
    <a class="btn-mini btn-mini-ghost" asp-page="/Gastos/Index" asp-route-mes="@mesPrev">← Mes anterior</a>
    <span class="mes-titulo">@Model.MesTexto</span>
    <a class="btn-mini btn-mini-ghost" asp-page="/Gastos/Index" asp-route-mes="@mesNext">Mes siguiente →</a>
    <form method="get" style="margin-left:auto">
        <input class="search" type="month" name="Mes" value="@Model.MesActual.ToString("yyyy-MM")" onchange="this.form.submit()" style="min-width:0" />
    </form>
</div>

<!-- Cargar un gasto -->
<div class="card" style="margin-top:12px">
    <h2>Agregar un gasto</h2>
    <form method="post" enctype="multipart/form-data" asp-page-handler="Agregar">
        <div class="form-grid">
            <div class="field"><label>Fecha</label><input asp-for="NuevoFecha" type="date" /></div>
            <div class="field">
                <label>Fijo / Variable</label>
                <select asp-for="NuevoTipo">
                    @foreach (var t in Wamani.Reservas.Models.GastoEmpresa.Tipos) { <option value="@t">@t</option> }
                </select>
            </div>
            <div class="field full"><label>Descripción</label><input asp-for="NuevoDescripcion" placeholder="Ej: Publicidad en Instagram" /></div>
            <div class="field"><label>Monto</label><input asp-for="NuevoMonto" type="number" step="0.01" min="0" /></div>
            <div class="field"><label>Comprobante (opcional)</label><input asp-for="NuevoComprobante" type="file" accept="image/*,.pdf" multiple /></div>
            <div class="field full">
                <label>Detalle (opcional)</label>
                <textarea asp-for="NuevoComentario" rows="3"
                          placeholder="Para desglosar un gasto cargado en general. Ej: Instagram $18.000 + Google $12.000 + impresión de folletos $5.000"></textarea>
            </div>
        </div>
        <div class="acciones-form" style="margin-top:12px">
            <button type="submit" class="btn btn-primary">+ Agregar gasto</button>
        </div>
    </form>
</div>

<!-- Lista del mes -->
<div class="table-wrap" style="margin-top:18px">
    <table class="tabla">
        <thead>
            <tr><th>Fecha</th><th>Tipo</th><th>Descripción</th><th class="num">Monto</th><th>Comprobante</th><th></th></tr>
        </thead>
        <tbody>
        @if (Model.Lista.Count == 0)
        {
            <tr><td colspan="6" style="text-align:center;color:var(--muted);padding:30px">No hay gastos cargados este mes.</td></tr>
        }
        @foreach (var g in Model.Lista)
        {
            var hayNota = !string.IsNullOrWhiteSpace(g.Comentario);
            var notaCls = hayNota ? "btn-mini btn-mini-ghost btn-nota con-nota" : "btn-mini btn-mini-ghost btn-nota";
            var notaTit = hayNota ? g.Comentario : "Escribir el detalle de este gasto";
            <tr>
                <td data-label="Fecha">
                    <form method="post" asp-page-handler="Fecha" asp-route-id="@g.Id" class="fecha-gasto">
                        <input type="hidden" asp-for="Mes" />
                        <input type="date" name="fecha" value="@g.Fecha.ToString("yyyy-MM-dd")" />
                        <button type="submit" class="btn-mini" title="Mover el gasto a esta fecha">💾</button>
                    </form>
                </td>
                <td data-label="Tipo">@g.Tipo</td>
                <td data-label="Descripción">
                    @g.Descripcion
                    @if (!string.IsNullOrWhiteSpace(g.Comentario))
                    {
                        <div class="nota-desglose">@g.Comentario</div>
                    }
                </td>
                <td class="num" data-label="Monto" style="color:var(--warn)">@Money(g.Monto)</td>
                <td data-label="Comprobante">
                    @if (!string.IsNullOrEmpty(g.Comprobante))
                    {
                        <partial name="_Adjuntos" model="@g.Comprobante" />
                    }
                    else
                    {
                        <span class="cliente-sub">—</span>
                    }
                </td>
                <td>
                    @* El desglose: qué había adentro de este gasto *@
                    <button type="button" class="@notaCls" title="@notaTit"
                            onclick="abrirDetalle(@g.Id)">📋</button>
                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@g.Id" style="display:inline"
                          onsubmit="return confirm('¿Borrar este gasto?');">
                        <input type="hidden" asp-for="Mes" />
                        <button type="submit" class="btn-mini btn-mini-danger" title="Borrar"
                                onclick="return confirm('¿Realmente lo querés borrar?');">🗑</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
        @if (Model.Lista.Count > 0)
        {
            <tfoot>
                <tr>
                    <td colspan="3"><strong>Total del mes</strong></td>
                    <td class="num"><strong style="color:var(--warn)">@Money(Model.Total)</strong></td>
                    <td colspan="2"></td>
                </tr>
            </tfoot>
        }
    </table>
</div>

@* Una ventanita por gasto para escribir el desglose. Se guarda sola: no toca el monto,
   la fecha ni el comprobante. *@
@foreach (var g in Model.Lista)
{
    <div class="modal-overlay gasto-modal" id="detalle-@g.Id" onclick="if(event.target===this) cerrarDetalle(@g.Id)">
        <div class="modal-box" style="max-width:520px">
            <h2 style="margin:0 0 4px">📋 Detalle del gasto</h2>
            <p class="hint" style="margin:0 0 14px">
                @g.Descripcion · @Money(g.Monto) · @g.Fecha.ToString("dd/MM/yyyy")<br />
                Para desglosar lo que cargaste en general. No entra en ninguna cuenta.
            </p>
            <form method="post" asp-page-handler="Nota" asp-route-id="@g.Id">
                <input type="hidden" asp-for="Mes" />
                <textarea name="nota" rows="7" style="width:100%"
                          placeholder="Ej: Instagram $18.000 + Google $12.000 + folletos $5.000">@g.Comentario</textarea>
                <div class="acciones-form" style="margin-top:16px">
                    <button type="submit" class="btn btn-primary">💾 Guardar detalle</button>
                    <button type="button" class="btn btn-ghost" onclick="cerrarDetalle(@g.Id)">Cancelar</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        function abrirDetalle(id) {
            var m = document.getElementById("detalle-" + id);
            if (m) { m.style.display = "flex"; m.querySelector("textarea").focus(); }
        }
        function cerrarDetalle(id) {
            var m = document.getElementById("detalle-" + id);
            if (m) { m.style.display = "none"; }
        }
    </script>
}

<style>
/* La fecha se puede corregir sin borrar el gasto: lo que vale es el día del CONSUMO,
   no el del pago (la tarjeta se paga al mes siguiente). */
.fecha-gasto{display:flex;gap:4px;align-items:center}
.fecha-gasto input[type=date]{padding:3px 6px;border:1px solid var(--linea,#d8d3c6);border-radius:7px;font:inherit;font-size:.82rem;background:#fff}
/* El desglose se muestra tal como se escribió, respetando los renglones */
.nota-desglose{margin-top:4px;font-size:.82rem;color:var(--muted);white-space:pre-line;line-height:1.45}
</style>
