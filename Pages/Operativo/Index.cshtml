@page
@model Wamani.Reservas.Pages.Operativo.IndexModel
@{
    ViewData["Title"] = "Operativo";
    var ci = System.Globalization.CultureInfo.GetCultureInfo("es-AR");
    string Money(decimal m) => "$ " + m.ToString("N0", ci);
}

<h1>Operativo</h1>
<p class="subtitle">Qué tenés que preparar/comprar para cada salida próxima.</p>

@if (Model.Salidas.Count == 0)
{
    <div class="table-wrap">
        <div class="empty">
            <div class="big">🎒</div>
            <p>No hay salidas próximas para preparar.</p>
        </div>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="tabla">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Excursión</th>
                    <th>Pers.</th>
                    <th>Gastos listos</th>
                    <th class="num">Presupuesto</th>
                    <th>Proveedores</th>
                    <th>Comprobantes</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var s in Model.Salidas)
            {
                <tr>
                    <td data-label="Fecha"><strong>@s.Fecha.ToString("dd/MM/yy")</strong></td>
                    <td data-label="Excursión">@s.Excursion</td>
                    <td data-label="Personas">@s.Pasajeros</td>
                    <td data-label="Gastos listos">
                        @if (s.GastosTotal == 0)
                        {
                            <span class="cliente-sub">— sin gastos cargados —</span>
                        }
                        else if (s.Completo)
                        {
                            <span class="pill pill-ok">✔ Todo listo</span>
                        }
                        else
                        {
                            <span class="pill pill-warn">@s.GastosListos / @s.GastosTotal listos</span>
                        }
                    </td>
                    <td class="num" data-label="Presupuesto">@Money(s.Presupuesto)</td>
                    <td data-label="Proveedores">
                        @if (s.DeudaProveedores > 0)
                        {
                            <span class="pill pill-warn">Falta pagar @Money(s.DeudaProveedores)</span>
                        }
                        else
                        {
                            <span class="cliente-sub">—</span>
                        }
                    </td>
                    <td data-label="Comprobantes">
                        @if (s.Comprobantes > 0)
                        {
                            <span class="pill pill-ok">📎 @s.Comprobantes</span>
                        }
                        else
                        {
                            <span class="cliente-sub">— sin comprobantes —</span>
                        }
                    </td>
                    <td class="acciones" data-label="">
                        <a class="btn-mini btn-mini-ghost" asp-page="/Operativo/Salida"
                           asp-route-excursionId="@s.ExcursionId" asp-route-fecha="@s.Fecha.ToString("yyyy-MM-dd")">
                            🎒 Preparar
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
