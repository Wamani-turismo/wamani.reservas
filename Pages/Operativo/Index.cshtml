@page
@model Wamani.Reservas.Pages.Operativo.IndexModel
@{
    ViewData["Title"] = "Operativo";
    var ci = System.Globalization.CultureInfo.GetCultureInfo("es-AR");
    string Money(decimal m) => "$ " + m.ToString("N0", ci);
}

<h1>Operativo</h1>
<p class="subtitle">Qué tenés que preparar/comprar para cada salida próxima.</p>

@if (Model.Salidas.Count == 0)
{
    <div class="table-wrap">
        <div class="empty">
            <div class="big">🎒</div>
            <p>No hay salidas próximas para preparar.</p>
        </div>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="tabla">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Excursión</th>
                    <th>Pers.</th>
                    <th>Gastos listos</th>
                    <th class="num">Gastos</th>
                    <th class="num">Proveedores</th>
                    <th class="num">Cuánto sale</th>
                    <th>Comprobantes</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var s in Model.Salidas)
            {
                <tr>
                    <td data-label="Fecha"><strong>@s.Fecha.ToString("dd/MM/yy")</strong></td>
                    <td data-label="Excursión">@s.Excursion</td>
                    <td data-label="Personas">@s.Pasajeros</td>
                    <td data-label="Gastos listos">
                        @if (s.GastosTotal == 0)
                        {
                            <span class="cliente-sub">— sin gastos cargados —</span>
                        }
                        else if (s.Completo)
                        {
                            <span class="pill pill-ok">✔ Todo listo</span>
                        }
                        else
                        {
                            <span class="pill pill-warn">@s.GastosListos / @s.GastosTotal listos</span>
                        }
                    </td>
                    <td class="num" data-label="Gastos">@Money(s.Presupuesto)</td>
                    <td class="num" data-label="Proveedores">
                        @if (s.ProveedoresTotal > 0)
                        {
                            <div>@Money(s.ProveedoresTotal)</div>
                            @if (s.DeudaProveedores > 0)
                            {
                                <span class="pill pill-warn" style="margin-top:4px">Falta @Money(s.DeudaProveedores)</span>
                            }
                            else
                            {
                                <span class="pill pill-ok" style="margin-top:4px">Pagado ✓</span>
                            }
                        }
                        else
                        {
                            <span class="cliente-sub">—</span>
                        }
                    </td>
                    @* Cuánto sale la salida según la excursión, y cuánto de eso está cargado.
                       El previsto NO se suma a los totales de plata a pagar: es para saber de
                       antemano cuánto va a salir y qué proveedor falta designar. *@
                    <td class="num" data-label="Cuánto sale">
                        @if (s.Previsto > 0)
                        {
                            <div>@Money(s.Previsto) <span class="cliente-sub">previsto</span></div>
                            <div class="cliente-sub">cargado @Money(s.Cargado)</div>
                            @if (s.SinCargar > 0)
                            {
                                <span class="pill" style="margin-top:4px;background:#fdeaea;color:#b91c1c;border-color:#f3c9c9">
                                    🔴 sin cargar @Money(s.SinCargar)
                                </span>
                            }
                            else if (s.CargadoDeMas > 0)
                            {
                                <span class="pill pill-warn" style="margin-top:4px">+@Money(s.CargadoDeMas) de más</span>
                            }
                            else
                            {
                                <span class="pill pill-ok" style="margin-top:4px">✔ todo cargado</span>
                            }
                        }
                        else
                        {
                            <span class="cliente-sub">— sin costos en la excursión —</span>
                        }
                    </td>
                    <td data-label="Comprobantes">
                        @if (s.Comprobantes > 0)
                        {
                            <span class="pill pill-ok">📎 @s.Comprobantes</span>
                        }
                        else
                        {
                            <span class="cliente-sub">— sin comprobantes —</span>
                        }
                    </td>
                    <td class="acciones" data-label="">
                        <a class="btn-mini btn-mini-ghost" asp-page="/Operativo/Salida"
                           asp-route-excursionId="@s.ExcursionId" asp-route-fecha="@s.Fecha.ToString("yyyy-MM-dd")">
                            🎒 Preparar
                        </a>
                        <a class="btn-mini btn-mini-ghost" asp-page="/Operativo/Pagar"
                           asp-route-excursionId="@s.ExcursionId" asp-route-fecha="@s.Fecha.ToString("yyyy-MM-dd")">
                            💸 Detalle a pagar
                        </a>
                        <a class="btn-mini btn-mini-ghost" asp-page="/Rentabilidad/Comparar"
                           asp-route-excursionId="@s.ExcursionId" asp-route-fecha="@s.Fecha.ToString("yyyy-MM-dd")">
                            📊 Teórica vs real
                        </a>
                        @* Toda la gente anotada en esta excursión, salida por salida *@
                        <a class="btn-mini btn-mini-ghost" asp-page="/Operativo/Reservas"
                           asp-route-excursionId="@s.ExcursionId">
                            👥 Reservas
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
