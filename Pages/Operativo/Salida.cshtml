@page
@model Wamani.Reservas.Pages.Operativo.SalidaModel
@{
    ViewData["Title"] = "Preparar salida";
    var ci = System.Globalization.CultureInfo.GetCultureInfo("es-AR");
    string Money(decimal m) => "$ " + m.ToString("N0", ci);
    string Num(decimal m) => m.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    var total = Model.Gastos.Sum(g => g.Precio);
    var listos = Model.Gastos.Count(g => g.Comprado);
}

<h1>Preparar salida</h1>
<p class="subtitle">@Model.ExcursionNombre · @Model.Fecha.ToString("dd/MM/yyyy")</p>

@if (Model.Guardado)
{
    <div class="aviso-ok">Operativo guardado ✔</div>
}

<div class="toolbar">
    <a asp-page="/Operativo/Index">← Volver al operativo</a>
</div>

@if (Model.Reservas.Count > 0)
{
    <div class="card">
        <h2>Pasajeros de esta salida (@Model.Reservas.Sum(r => r.CantidadPersonas))</h2>
        <div>
            @string.Join(" · ", Model.Reservas.Select(r => $"{r.NombreCliente} ({r.CantidadPersonas})"))
        </div>
    </div>
}

<form method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="ExcursionId" />
    <input type="hidden" asp-for="Fecha" />

    <!-- ---------- Proveedores (van primero: llevan seña + saldo) ---------- -->
    <div class="card">
        <h2>Proveedores <span class="hint" style="font-weight:400">(guía, hospedaje, restaurante, auto)</span></h2>
        <p class="hint" style="margin:-8px 0 14px">
            Elegí el proveedor de cada uno y registrá el total y lo que ya pagaste (seña). El sistema te avisa lo que falta.
            ¿Falta uno en la lista? <a asp-page="/Proveedores/Cargar" target="_blank">Agregar proveedor</a>.
        </p>
        @{
            List<Wamani.Reservas.Pages.Operativo.ProvRowVm> RowsDe(string tipo, bool conPasajero)
            {
                var cat = Model.CatalogoPorTipo.GetValueOrDefault(tipo) ?? new();
                var asigs = Model.ProvPorTipo.GetValueOrDefault(tipo) ?? new();
                var rows = asigs.Select(a => new Wamani.Reservas.Pages.Operativo.ProvRowVm { Tipo = tipo, Asig = a, Cat = cat, ConPasajero = conPasajero, Key = a.Id.ToString(), Reservas = Model.Reservas }).ToList();
                if (rows.Count == 0) rows.Add(new Wamani.Reservas.Pages.Operativo.ProvRowVm { Tipo = tipo, Asig = null, Cat = cat, ConPasajero = conPasajero, Key = "new-" + tipo, Reservas = Model.Reservas });
                return rows;
            }
        }

        <div class="prov-lista">
            @* Guía y Auto: una sola fila (uno por salida) *@
            @foreach (var vm in RowsDe("Guía", false)) { <partial name="_ProvRow" model="vm" /> }

            @if (Model.EsTravesia)
            {
                @* Travesía: una fila por LUGAR de la ruta, con todo el grupo junto *@
                <p class="hint" style="margin:6px 0 10px">
                    Es una travesía, así que el hospedaje va <strong>una fila por lugar</strong> con todo el grupo junto.
                    El total sale solo (personas × precio por persona) y lo podés pisar a mano si el refugio cobró otra cosa.
                    Los lugares y los refugios habituales se editan en
                    <a asp-page="/Excursiones/Cargar" asp-route-id="@Model.ExcursionId" target="_blank">la travesía</a>.
                </p>
                <div class="prov-group" data-tipo="Hospedaje">
                    @foreach (var et in Model.Etapas) { <partial name="_EtapaRow" model="et" /> }
                </div>

                @* Hospedajes cargados antes de tener etapas, o que no coinciden con ningún lugar *@
                @{ var sueltos = Model.ProvPorTipo.GetValueOrDefault("Hospedaje") ?? new(); }
                @if (sueltos.Count > 0)
                {
                    <p class="hint" style="margin:14px 0 8px">
                        <strong>Hospedajes sueltos:</strong> estos se cargaron sin lugar de la ruta (son de antes,
                        o el lugar no coincide con ninguna noche). Pasá la plata a la fila del lugar que corresponda
                        y borrá estos, o dejalos si son un extra aparte.
                    </p>
                    <div class="prov-group" data-tipo="HospedajeSuelto">
                        @foreach (var a in sueltos)
                        {
                            var vmSuelto = new Wamani.Reservas.Pages.Operativo.ProvRowVm
                            {
                                Tipo = "Hospedaje",
                                Asig = a,
                                Cat = Model.CatalogoPorTipo.GetValueOrDefault("Hospedaje") ?? new(),
                                ConPasajero = true,
                                Key = a.Id.ToString(),
                                Reservas = Model.Reservas
                            };
                            <partial name="_ProvRow" model="vmSuelto" />
                        }
                    </div>
                }
            }
            else
            {
                @* Excursión de un día: uno o varios hospedajes (por pasajero), como siempre *@
                <div class="prov-group" data-tipo="Hospedaje">
                    @foreach (var vm in RowsDe("Hospedaje", true)) { <partial name="_ProvRow" model="vm" /> }
                </div>
                <button type="button" class="btn btn-ghost prov-add-btn" onclick="agregarProv('Hospedaje')">+ Agregar hospedaje (otra persona)</button>
            }

            @* Restaurante: uno o varios (por pasajero) *@
            <div class="prov-group" data-tipo="Restaurante">
                @foreach (var vm in RowsDe("Restaurante", true)) { <partial name="_ProvRow" model="vm" /> }
            </div>
            <button type="button" class="btn btn-ghost prov-add-btn" onclick="agregarProv('Restaurante')">+ Agregar restaurante (otra persona)</button>

            @foreach (var vm in RowsDe("Auto", false)) { <partial name="_ProvRow" model="vm" /> }
        </div>
    </div>

    <!-- ---------- Gastos a preparar / comprar (van abajo) ---------- -->
    <div class="card">
        <h2>Gastos a preparar / comprar</h2>

        @if (Model.Gastos.Count == 0)
        {
            <p class="hint">Esta excursión todavía no tiene gastos cargados. Podés agregarlos acá, o cargarlos en la excursión para que aparezcan solos en todas sus salidas.</p>
        }

        <p class="hint" style="margin:-6px 0 14px">
            Cargá el precio <strong>por persona</strong> (o por auto) y el sistema lo multiplica
            por la gente de la salida. Si alguna vez pagaste un monto distinto, tocá <em>“a mano”</em>.
        </p>
        <table class="tabla" id="tablaGastos">
            <thead>
                <tr>
                    <th style="width:70px">Listo</th>
                    <th>Ítem / gasto</th>
                    <th class="num" style="width:210px">Precio y total</th>
                    <th style="width:210px">Comprobante</th>
                    <th style="width:60px"></th>
                </tr>
            </thead>
            <tbody id="gastosBody">
            @{
                var gComp = Model.Gastos.Where(x => x.ReservaId == null).ToList();
            }
            @if (gComp.Count > 0)
            {
                <tr class="grupo-head"><td colspan="5">🚐 Compartidos de la salida (nafta, etc.)</td></tr>
                foreach (var g in gComp)
                {
                    var m = Wamani.Reservas.Models.OperativoGasto.Multiplicador(
                        string.IsNullOrWhiteSpace(g.TipoCalculo) ? "Por persona" : g.TipoCalculo, Model.PasajerosSalida);
                    <partial name="_GastoRow" model="new Wamani.Reservas.Pages.Operativo.GastoRowVm { G = g, Mult = m, ReservaId = 0 }" />
                }
            }
            @foreach (var r in Model.Reservas)
            {
                var lista = Model.Gastos.Where(x => x.ReservaId == r.Id).ToList();
                <tr class="grupo-head"><td colspan="5">🧑 @r.NombreCliente — @r.CantidadPersonas pers.</td></tr>
                @if (lista.Count == 0)
                {
                    <tr class="gasto-vacio"><td colspan="5" class="cliente-sub">Sin gastos por persona cargados para esta reserva.</td></tr>
                }
                foreach (var g in lista)
                {
                    <partial name="_GastoRow" model="new Wamani.Reservas.Pages.Operativo.GastoRowVm { G = g, Mult = r.CantidadPersonas, ReservaId = r.Id }" />
                }
                <tr class="gasto-add"><td colspan="5"><button type="button" class="btn-mini btn-mini-ghost" onclick="agregarGasto(@r.Id, @r.CantidadPersonas)">+ Agregar gasto a @r.NombreCliente</button></td></tr>
            }
            </tbody>
        </table>

        <button type="button" class="btn btn-ghost" style="margin-top:12px" onclick="agregarGasto(0, @Model.PasajerosSalida)">+ Agregar gasto compartido</button>

        <div class="resumen" style="margin-top:18px">
            <div class="item">
                <div class="label">Gastos listos</div>
                <div class="val" id="outListos">@listos / @Model.Gastos.Count</div>
            </div>
            <div class="item">
                <div class="label">Total de la salida (gastos + proveedores)</div>
                <div class="val" id="outTotal">@Money(total)</div>
            </div>
        </div>
    </div>

    <!-- ---------- Compartidos (guía / auto) pagados ---------- -->
    <div class="card">
        <h2>Compartidos de la salida (guía / auto)</h2>
        <label class="check-linea">
            <input type="checkbox" asp-for="ServiciosPagados" class="chk-listo" />
            <span>Ya pagué lo compartido de esta salida (guía y auto). Aparece <strong>"🚐 Compartidos pagados ✓"</strong> en las reservas.</span>
        </label>
        <p class="hint" style="margin:8px 0 0">El hospedaje y las comidas de cada pasajero se cargan arriba (en Proveedores), eligiendo <strong>de qué reserva</strong> es cada uno.</p>
    </div>

    <div class="acciones-form">
        <button type="submit" class="btn btn-primary">💾 Guardar operativo</button>
        <a class="btn btn-ghost" asp-page="/Operativo/Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <script>
        function money(n) { return "$ " + (isNaN(n) ? 0 : Math.round(n)).toLocaleString("es-AR"); }
        function totalProveedores() {
            var t = 0;
            document.querySelectorAll('.prov-row').forEach(function (tr) {
                t += parseFloat(tr.querySelector('.prov-total')?.value) || 0;
            });
            return t;
        }
        // Calcula y muestra el total de una fila (precio unitario × cantidad, o total a mano)
        function pintarFila(tr) {
            var linea = tr.querySelector('.calc-linea');
            var manual = tr.querySelector('.es-manual').value === '1';
            var mult = parseInt(tr.dataset.mult) || 0;
            var tipo = tr.dataset.tipo || 'Por persona';
            var uni = tr.dataset.uni || 'personas';
            var val = parseFloat(tr.querySelector('.in-precio').value) || 0;
            var total = manual ? val : val * mult;
            tr._total = total;
            if (linea) {
                if (manual) {
                    linea.innerHTML = '<span class="cliente-sub">total a mano</span> · <button type="button" class="link-mini" onclick="modoAuto(this)">volver al cálculo</button>';
                } else if (tipo === 'Fijo') {
                    linea.innerHTML = 'monto fijo = <b>' + money(total) + '</b> · <button type="button" class="link-mini" onclick="modoManual(this)">a mano</button>';
                } else {
                    linea.innerHTML = '× ' + mult + ' ' + uni + ' = <b>' + money(total) + '</b> · <button type="button" class="link-mini" onclick="modoManual(this)">a mano</button>';
                }
            }
            return total;
        }
        function modoManual(btn) {
            var tr = btn.closest('.gasto-row');
            tr.querySelector('.es-manual').value = '1';
            tr.querySelector('.in-precio').value = Math.round(tr._total || 0);
            pintarFila(tr); recalcular();
        }
        function modoAuto(btn) {
            var tr = btn.closest('.gasto-row');
            tr.querySelector('.es-manual').value = '0';
            var inp = tr.querySelector('.in-precio'); inp.value = '';
            pintarFila(tr); recalcular(); inp.focus();
        }
        function recalcular() {
            var total = 0, listos = 0, filas = document.querySelectorAll('#gastosBody .gasto-row');
            filas.forEach(function (tr) {
                total += (typeof tr._total === 'number') ? tr._total : (parseFloat(tr.querySelector('.in-precio')?.value) || 0);
                var c = tr.querySelector('.chk-listo');
                if (c && c.checked) listos++;
            });
            // El total de la salida incluye gastos + proveedores
            document.getElementById('outTotal').textContent = money(total + totalProveedores());
            document.getElementById('outListos').textContent = listos + " / " + filas.length;
        }
        var nuevoGastoSeq = 1;
        function agregarGasto(resId, mult) {
            // Clave temporal para poder subir el comprobante de una fila nueva en el mismo guardado
            var key = 'n' + (nuevoGastoSeq++);
            var tr = document.createElement('tr');
            tr.className = 'gasto-row';
            tr.dataset.tipo = 'Manual'; tr.dataset.mult = (mult || 1); tr.dataset.uni = '';
            tr.innerHTML =
                '<td data-label="Listo"><span class="cliente-sub">guardá primero</span></td>' +
                '<td data-label="Ítem"><input type="hidden" name="Ids" value="0" /><input type="hidden" name="Keys" value="' + key + '" /><input type="hidden" name="GastoReservaIds" value="' + (resId || 0) + '" /><input name="Nombres" placeholder="Ej: Peaje" /></td>' +
                '<td class="num" data-label="Precio y total"><input type="hidden" name="EsManual" value="1" class="es-manual" /><input name="Precios" type="number" step="0.01" min="0" value="" class="in-precio" /><div class="calc-linea"><span class="cliente-sub">total a mano</span></div></td>' +
                '<td data-label="Comprobante"><input type="file" name="comp_' + key + '" accept="image/*,.pdf" class="in-comp" multiple /></td>' +
                '<td><button type="button" class="btn-mini btn-mini-danger" onclick="quitarGasto(this)">Quitar</button></td>';
            document.getElementById('gastosBody').appendChild(tr);
            tr.querySelector('input[name=Nombres]').focus();
        }
        function quitarGasto(btn) { btn.closest('tr').remove(); recalcular(); }

        // Proveedores: "lo que falta" (total - seña - saldo) por bloque
        function recalcularProv() {
            document.querySelectorAll('.prov-row').forEach(function (tr) {
                var total = parseFloat(tr.querySelector('.prov-total')?.value) || 0;
                var sena = parseFloat(tr.querySelector('.prov-sena')?.value) || 0;
                var saldo = parseFloat(tr.querySelector('.prov-saldo')?.value) || 0;
                var falta = Math.max(0, total - sena - saldo);
                var demas = (sena + saldo) - total;
                var cel = tr.querySelector('.prov-pend');
                if (!cel) return;
                if (total <= 0) { cel.textContent = '—'; cel.style.color = 'var(--muted)'; }
                else if (demas > 0.01) { cel.textContent = '⚠ Cargaste ' + money(demas) + ' de más'; cel.style.color = 'var(--warn)'; }
                else if (falta <= 0.01) { cel.textContent = 'Pagado ✔'; cel.style.color = 'var(--ok)'; }
                else { cel.textContent = money(falta); cel.style.color = 'var(--warn)'; }
            });
            recalcular();  // el total de la salida cambia si cambia un total de proveedor
        }
        document.addEventListener('input', function (e) {
            if (e.target.classList.contains('in-precio')) { pintarFila(e.target.closest('.gasto-row')); recalcular(); }
            else if (e.target.classList.contains('chk-listo')) recalcular();
            if (e.target.classList.contains('prov-total') || e.target.classList.contains('prov-sena') || e.target.classList.contains('prov-saldo')) recalcularProv();
        });
        // Pintar los totales de todas las filas al abrir
        document.querySelectorAll('#gastosBody .gasto-row').forEach(pintarFila);
        recalcularProv();

        // Agregar / quitar filas de hospedaje o restaurante (por pasajero)
        var nuevoProvSeq = 1;
        function agregarProv(tipo) {
            var group = document.querySelector('.prov-group[data-tipo="' + tipo + '"]');
            var base = group.querySelector('.prov-row');
            var clone = base.cloneNode(true);
            var key = 'pnew' + (nuevoProvSeq++);   // clave única para poder subir el comprobante de la fila nueva
            clone.querySelector('input[name=ProvIds]').value = '0';
            var pk = clone.querySelector('input[name=ProvKeys]'); if (pk) pk.value = key;
            var sel = clone.querySelector('select[name=ProvProveedorIds]'); if (sel) sel.value = '0';
            clone.querySelectorAll('.prov-total,.prov-sena,.prov-saldo').forEach(function (i) { i.value = ''; i.readOnly = false; i.style.background = ''; });
            var pq = clone.querySelector('.prov-para'); if (pq) pq.value = '0';   // desplegable de reserva
            // renombrar los campos de comprobante con la clave nueva y limpiarlos
            var fSena = clone.querySelector('input[name^="provcompsena_"]'); if (fSena) { fSena.name = 'provcompsena_' + key; fSena.value = ''; }
            var fSaldo = clone.querySelector('input[name^="provcompsaldo_"]'); if (fSaldo) { fSaldo.name = 'provcompsaldo_' + key; fSaldo.value = ''; }
            clone.querySelectorAll('.adjuntos').forEach(function (d) { d.remove(); });  // sacar los comprobantes heredados
            var pend = clone.querySelector('.prov-pend'); if (pend) pend.textContent = '';
            group.appendChild(clone);
            recalcularProv();
        }
        function quitarProv(btn) { btn.closest('.prov-row').remove(); recalcularProv(); }

        // Al elegir un proveedor, el Total se completa solo con "lo que cobra" y queda bloqueado.
        // En una travesía (fila por lugar) lo que se completa es el PRECIO POR PERSONA, y el
        // total sale de multiplicarlo por la cantidad de gente.
        document.addEventListener('change', function (e) {
            if (!e.target.classList.contains('prov-select')) return;
            var fila = e.target.closest('.prov-row');
            var opt = e.target.options[e.target.selectedIndex];
            var precio = parseFloat(opt.getAttribute('data-precio')) || 0;
            if (fila.classList.contains('etapa-bloque')) {
                if (precio > 0) fila.querySelector('.etapa-precio').value = precio;
                recalcularEtapa(fila);
            } else {
                var tot = fila.querySelector('.prov-total');
                if (precio > 0) { tot.value = precio; tot.readOnly = true; }
            }
            recalcularProv();
        });

        // Travesía: total = personas × precio por persona (salvo que se haya puesto a mano)
        function recalcularEtapa(fila) {
            var tot = fila.querySelector('.prov-total');
            if (!tot || tot.dataset.manual === '1') return;
            var pers = parseFloat(fila.querySelector('.etapa-personas').value) || 0;
            var pp = parseFloat(fila.querySelector('.etapa-precio').value) || 0;
            tot.value = (pers > 0 && pp > 0) ? (pers * pp) : '';
        }
        document.addEventListener('input', function (e) {
            if (!e.target.classList.contains('etapa-personas') && !e.target.classList.contains('etapa-precio')) return;
            recalcularEtapa(e.target.closest('.prov-row'));
            recalcularProv();
        });

        // Botón "a mano": desbloquea el total para cambiarlo y deja de recalcularse solo
        function editarTotal(btn) {
            var tot = btn.closest('.field').querySelector('.prov-total');
            tot.readOnly = false;
            tot.dataset.manual = '1';
            tot.focus();
            tot.select();
        }
    </script>
}
