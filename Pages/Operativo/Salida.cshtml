@page
@model Wamani.Reservas.Pages.Operativo.SalidaModel
@{
    ViewData["Title"] = "Preparar salida";
    var ci = System.Globalization.CultureInfo.GetCultureInfo("es-AR");
    string Money(decimal m) => "$ " + m.ToString("N0", ci);
    string Num(decimal m) => m.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    var total = Model.Gastos.Sum(g => g.Precio);
    var listos = Model.Gastos.Count(g => g.Comprado);
}

<h1>Preparar salida</h1>
<p class="subtitle">@Model.ExcursionNombre · @Model.Fecha.ToString("dd/MM/yyyy")</p>

@if (Model.Guardado)
{
    <div class="aviso-ok">Operativo guardado ✔</div>
}

@if (Model.Rehechos is int cuantosRehechos)
{
    <div class="aviso-ok">Se limpiaron @cuantosRehechos gasto(s) sin usar y se volvieron a copiar de la excursión ✔</div>
}

<div class="toolbar">
    <a asp-page="/Operativo/Index">← Volver al operativo</a>
</div>

@if (Model.Reservas.Count > 0)
{
    <div class="card">
        <h2>Pasajeros de esta salida (@Model.Reservas.Sum(r => r.CantidadPersonas))</h2>
        <div>
            @string.Join(" · ", Model.Reservas.Select(r => $"{r.NombreCliente} ({r.CantidadPersonas})"))
        </div>
    </div>
}

<form method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="ExcursionId" />
    <input type="hidden" asp-for="Fecha" />

    <!-- ---------- Proveedores (van primero: llevan seña + saldo) ---------- -->
    <div class="card">
        <h2>Proveedores <span class="hint" style="font-weight:400">(guía, hospedaje, restaurante, auto)</span></h2>
        <p class="hint" style="margin:-8px 0 14px">
            Elegí el proveedor de cada uno y registrá el total y lo que ya pagaste (seña). El sistema te avisa lo que falta.
            ¿Falta uno en la lista? <a asp-page="/Proveedores/Cargar" target="_blank">Agregar proveedor</a>.
        </p>
        @{
            List<Wamani.Reservas.Pages.Operativo.ProvRowVm> RowsDe(string tipo, bool conPasajero, bool conCantidad = false)
            {
                var cat = Model.CatalogoPorTipo.GetValueOrDefault(tipo) ?? new();
                var asigs = Model.ProvPorTipo.GetValueOrDefault(tipo) ?? new();

                decimal PrecioCat(Wamani.Reservas.Models.OperativoProveedor? a)
                    => cat.FirstOrDefault(p => p.Id == a?.ProveedorId)?.Precio ?? 0;

                var rows = asigs.Select(a => new Wamani.Reservas.Pages.Operativo.ProvRowVm
                {
                    Tipo = tipo, Asig = a, Cat = cat, ConPasajero = conPasajero, ConCantidad = conCantidad,
                    Key = a.Id.ToString(), Reservas = Model.Reservas, PrecioCatalogo = PrecioCat(a)
                }).ToList();

                if (rows.Count == 0)
                {
                    rows.Add(new Wamani.Reservas.Pages.Operativo.ProvRowVm
                    {
                        Tipo = tipo, Asig = null, Cat = cat, ConPasajero = conPasajero, ConCantidad = conCantidad,
                        Key = "new-" + tipo, Reservas = Model.Reservas
                    });
                }
                return rows;
            }
        }

        <div class="prov-lista">
            @* Guía suelto: sólo cuando la excursión NO dice cuánto cobra el guía por día.
               Si lo dice, la fila sale abajo con el precio de la salida (no el del catálogo,
               que es siempre el mismo y por eso daba mal). *@
            @if (!Model.TieneGuias)
            {
                <div class="prov-group" data-tipo="Guía">
                    @foreach (var vm in RowsDe("Guía", false, true)) { <partial name="_ProvRow" model="vm" /> }
                </div>
                <button type="button" class="btn btn-ghost prov-add-btn" onclick="agregarProv('Guía')">+ Agregar guía</button>
            }

            @if (Model.EsTravesia)
            {
                @* Todo lo que se contrata para el GRUPO: noches, traslados, arrieros y
                   caballos. Una fila por parada, con el total ya calculado. *@
                <p class="hint" style="margin:6px 0 10px">
                    Esto va <strong>por el grupo entero</strong>, no por pasajero: el total sale solo
                    (cantidad × precio × veces) y lo podés pisar a mano si esta vez te cobraron otra cosa.
                    Los lugares, tramos y proveedores habituales se editan en
                    <a asp-page="/Excursiones/Cargar" asp-route-id="@Model.ExcursionId" target="_blank">la travesía</a>.
                </p>
                @foreach (var grupoEtapa in Model.Etapas.GroupBy(x => x.Tipo))
                {
                    <h3 class="prov-sub">@Wamani.Reservas.Models.EtapaExcursion.Icono(grupoEtapa.Key) @Wamani.Reservas.Models.EtapaExcursion.Seccion(grupoEtapa.Key)</h3>
                    <div class="prov-group" data-tipo="@grupoEtapa.Key">
                        @foreach (var et in grupoEtapa) { <partial name="_EtapaRow" model="et" /> }
                    </div>
                }

                @* Hospedajes cargados antes de tener etapas, o que no coinciden con ningún lugar *@
                var sueltos = Model.ProvPorTipo.GetValueOrDefault("Hospedaje") ?? new List<Wamani.Reservas.Models.OperativoProveedor>();
                @if (sueltos.Count > 0)
                {
                    <p class="hint" style="margin:14px 0 8px">
                        <strong>Hospedajes sueltos:</strong> estos se cargaron sin lugar de la ruta (son de antes,
                        o el lugar no coincide con ninguna noche). Pasá la plata a la fila del lugar que corresponda
                        y borrá estos, o dejalos si son un extra aparte.
                    </p>
                    <div class="prov-group" data-tipo="HospedajeSuelto">
                        @foreach (var a in sueltos)
                        {
                            var vmSuelto = new Wamani.Reservas.Pages.Operativo.ProvRowVm
                            {
                                Tipo = "Hospedaje",
                                Asig = a,
                                Cat = Model.CatalogoPorTipo.GetValueOrDefault("Hospedaje") ?? new(),
                                ConPasajero = true,
                                Key = a.Id.ToString(),
                                Reservas = Model.Reservas
                            };
                            <partial name="_ProvRow" model="vmSuelto" />
                        }
                    </div>
                }
            }
            else if (Model.DuermeFuera)
            {
                @* Duerme fuera pero sin noches cargadas (ej. "Conociendo las Yungas"): uno
                   o varios hospedajes por pasajero, como siempre. En las salidas de un día
                   esta sección no aparece: no hay nada que dormir. *@
                <div class="prov-group" data-tipo="Hospedaje">
                    @foreach (var vm in RowsDe("Hospedaje", true)) { <partial name="_ProvRow" model="vm" /> }
                </div>
                <button type="button" class="btn btn-ghost prov-add-btn" onclick="agregarProv('Hospedaje')">+ Agregar hospedaje (otra persona)</button>
            }

            @* Restaurante: uno o varios (por pasajero). En las travesías no va: se come en
               el refugio (ya viene en el precio de la noche) o la comida la ponemos nosotros
               como un gasto más, así que la sección sólo confundía. *@
            @if (!Model.EsTravesia)
            {
                <div class="prov-group" data-tipo="Restaurante">
                    @foreach (var vm in RowsDe("Restaurante", true)) { <partial name="_ProvRow" model="vm" /> }
                </div>
                <button type="button" class="btn btn-ghost prov-add-btn" onclick="agregarProv('Restaurante')">+ Agregar restaurante (otra persona)</button>
            }

            @* Auto suelto: sólo cuando la salida NO tiene los traslados cargados arriba.
               Si los tiene, repetirlo acá sería cargar dos veces la misma plata. *@
            @if (!Model.TieneTraslados)
            {
                <div class="prov-group" data-tipo="Auto">
                    @foreach (var vm in RowsDe("Auto", false, true)) { <partial name="_ProvRow" model="vm" /> }
                </div>
                <button type="button" class="btn btn-ghost prov-add-btn" onclick="agregarProv('Auto')">+ Agregar vehículo</button>
            }
        </div>
    </div>

    <!-- ---------- Gastos a preparar / comprar (van abajo) ---------- -->
    <div class="card">
        <h2>Gastos a preparar / comprar</h2>

        @* El operativo sólo agrega los ítems que faltan, nunca borra los que ya no están en
           la plantilla. Este botón limpia esa basura sin tocar nada que tenga plata. *@
        <p class="hint" style="margin:-6px 0 12px">
            ¿Ves ítems repetidos o que ya no van (por ejemplo el guía, que ahora se paga en
            Proveedores)? Son restos de una plantilla vieja.
            <button type="submit" class="btn-mini btn-mini-ghost" asp-page-handler="RehacerGastos"
                    onclick="return confirm('Se borran los gastos que NO estén tildados, sin fecha de pago y sin comprobante, y se vuelven a copiar de la excursión.\n\nLo que ya está pagado no se toca.\n\n¿Seguimos?');">
                🔄 Rehacer desde la plantilla
            </button>
        </p>

        @if (Model.Gastos.Count == 0)
        {
            <p class="hint">Esta excursión todavía no tiene gastos cargados. Podés agregarlos acá, o cargarlos en la excursión para que aparezcan solos en todas sus salidas.</p>
        }

        <p class="hint" style="margin:-6px 0 14px">
            Cargá el precio <strong>por persona</strong> (o por auto) y el sistema lo multiplica
            por la gente de la salida. Si alguna vez pagaste un monto distinto, tocá <em>“a mano”</em>.
        </p>
        <table class="tabla" id="tablaGastos">
            <thead>
                <tr>
                    <th style="width:70px">Listo</th>
                    <th>Ítem / gasto</th>
                    <th class="num" style="width:210px">Precio y total</th>
                    <th style="width:210px">Comprobante</th>
                    <th style="width:60px"></th>
                </tr>
            </thead>
            <tbody id="gastosBody">
            @{
                var gComp = Model.Gastos.Where(x => x.ReservaId == null).ToList();
            }
            @if (gComp.Count > 0)
            {
                <tr class="grupo-head"><td colspan="5">🚐 Compartidos de la salida (nafta, etc.)</td></tr>
                foreach (var g in gComp)
                {
                    var m = g.MultiplicadorPropio(Model.PasajerosSalida);
                    <partial name="_GastoRow" model="new Wamani.Reservas.Pages.Operativo.GastoRowVm { G = g, Mult = m, ReservaId = 0 }" />
                }
            }
            @foreach (var r in Model.Reservas)
            {
                var lista = Model.Gastos.Where(x => x.ReservaId == r.Id).ToList();
                <tr class="grupo-head"><td colspan="5">🧑 @r.NombreCliente — @r.CantidadPersonas pers.</td></tr>
                @if (lista.Count == 0)
                {
                    <tr class="gasto-vacio"><td colspan="5" class="cliente-sub">Sin gastos por persona cargados para esta reserva.</td></tr>
                }
                foreach (var g in lista)
                {
                    <partial name="_GastoRow" model="new Wamani.Reservas.Pages.Operativo.GastoRowVm { G = g, Mult = r.CantidadPersonas, ReservaId = r.Id }" />
                }
                <tr class="gasto-add"><td colspan="5"><button type="button" class="btn-mini btn-mini-ghost" onclick="agregarGasto(@r.Id, @r.CantidadPersonas)">+ Agregar gasto a @r.NombreCliente</button></td></tr>
            }
            </tbody>
        </table>

        <button type="button" class="btn btn-ghost" style="margin-top:12px" onclick="agregarGasto(0, @Model.PasajerosSalida)">+ Agregar gasto compartido</button>

        <div class="resumen" style="margin-top:18px">
            <div class="item">
                <div class="label">Gastos listos</div>
                <div class="val" id="outListos">@listos / @Model.Gastos.Count</div>
            </div>
            <div class="item">
                <div class="label">Total de la salida (gastos + proveedores)</div>
                <div class="val" id="outTotal">@Money(total)</div>
            </div>
        </div>
    </div>

    <!-- ---------- Compartidos (guía / auto) pagados ---------- -->
    <div class="card">
        <h2>Compartidos de la salida (guía / auto)</h2>
        <label class="check-linea">
            <input type="checkbox" asp-for="ServiciosPagados" class="chk-listo" />
            <span>Ya pagué lo compartido de esta salida (guía y auto). Aparece <strong>"🚐 Compartidos pagados ✓"</strong> en las reservas.</span>
        </label>
        <p class="hint" style="margin:8px 0 0">El hospedaje y las comidas de cada pasajero se cargan arriba (en Proveedores), eligiendo <strong>de qué reserva</strong> es cada uno.</p>
    </div>

    <div class="acciones-form">
        <button type="submit" class="btn btn-primary">💾 Guardar operativo</button>
        <a class="btn btn-ghost" asp-page="/Operativo/Index">Cancelar</a>
    </div>
</form>

@* Ventanita para escribir la nota de un gasto o de un proveedor. Va FUERA del formulario a
   propósito: así el textarea no se manda como un campo más y no desacomoda las listas. *@
<div id="modalNota" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(35,51,46,.55);z-index:999;align-items:center;justify-content:center;padding:16px">
    <div style="background:var(--surface);color:var(--ink);width:100%;max-width:520px;padding:22px;border-radius:14px;box-shadow:0 14px 44px rgba(0,0,0,.25)">
        <h2 id="notaTitulo" style="margin:0 0 4px">Nota</h2>
        <p class="hint" style="margin:0 0 14px">
            Lo que haga falta acordarse de esto <strong>en esta salida</strong>: con quién se
            arregló, qué incluye, por qué salió distinto. No entra en ninguna cuenta.
        </p>
        <textarea id="notaTexto" rows="7" style="width:100%" placeholder="Ej: se pagó en efectivo a Don Ramón, incluye la cena de los dos guías."></textarea>
        <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:16px">
            <button type="button" class="btn btn-ghost" onclick="cerrarNota()">Cancelar</button>
            <button type="button" class="btn btn-primary" onclick="guardarNota()">💾 Guardar</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function money(n) { return "$ " + (isNaN(n) ? 0 : Math.round(n)).toLocaleString("es-AR"); }
        function totalProveedores() {
            var t = 0;
            document.querySelectorAll('.prov-row').forEach(function (tr) {
                t += parseFloat(tr.querySelector('.prov-total')?.value) || 0;
            });
            return t;
        }
        // Calcula y muestra el total de una fila (precio unitario × cantidad, o total a mano)
        function pintarFila(tr) {
            var linea = tr.querySelector('.calc-linea');
            var manual = tr.querySelector('.es-manual').value === '1';
            var mult = parseInt(tr.dataset.mult) || 0;
            var tipo = tr.dataset.tipo || 'Por persona';
            var uni = tr.dataset.uni || 'personas';
            var val = parseFloat(tr.querySelector('.in-precio').value) || 0;
            var total = manual ? val : val * mult;
            tr._total = total;
            if (linea) {
                if (manual) {
                    linea.innerHTML = '<span class="cliente-sub">total a mano</span> · <button type="button" class="link-mini" onclick="modoAuto(this)">volver al cálculo</button>';
                } else if (tipo === 'Fijo') {
                    linea.innerHTML = 'monto fijo = <b>' + money(total) + '</b> · <button type="button" class="link-mini" onclick="modoManual(this)">a mano</button>';
                } else if (tipo === 'Cantidad') {
                    linea.innerHTML = '× ' + mult + ' = <b>' + money(total) + '</b> · <button type="button" class="link-mini" onclick="modoManual(this)">a mano</button>';
                } else {
                    linea.innerHTML = '× ' + mult + ' ' + uni + ' = <b>' + money(total) + '</b> · <button type="button" class="link-mini" onclick="modoManual(this)">a mano</button>';
                }
            }
            return total;
        }
        function modoManual(btn) {
            var tr = btn.closest('.gasto-row');
            tr.querySelector('.es-manual').value = '1';
            tr.querySelector('.in-precio').value = Math.round(tr._total || 0);
            pintarFila(tr); recalcular();
        }
        function modoAuto(btn) {
            var tr = btn.closest('.gasto-row');
            tr.querySelector('.es-manual').value = '0';
            var inp = tr.querySelector('.in-precio'); inp.value = '';
            pintarFila(tr); recalcular(); inp.focus();
        }
        function recalcular() {
            var total = 0, listos = 0, filas = document.querySelectorAll('#gastosBody .gasto-row');
            filas.forEach(function (tr) {
                total += (typeof tr._total === 'number') ? tr._total : (parseFloat(tr.querySelector('.in-precio')?.value) || 0);
                var c = tr.querySelector('.chk-listo');
                if (c && c.checked) listos++;
            });
            // El total de la salida incluye gastos + proveedores
            document.getElementById('outTotal').textContent = money(total + totalProveedores());
            document.getElementById('outListos').textContent = listos + " / " + filas.length;
        }
        // Qué día es hoy en Jujuy (lo dice el servidor: si lo calculara el navegador y
        // alguien abre el sistema de viaje, podría poner otro día).
        var HOY = '@Wamani.Reservas.Services.Reloj.HoyJujuy().ToString("yyyy-MM-dd")';

        // El día del pago sólo tiene sentido si el gasto está tildado como listo: se
        // muestra al tildarlo y se esconde al destildarlo. El campo NO se saca del
        // formulario, sólo se oculta, así la fila sigue aportando su valor a la lista.
        function pintarFechaPago(chk) {
            var fila = chk.closest('.gasto-row');
            var caja = fila.querySelector('.fecha-pago-wrap');
            if (!caja) return;
            var campo = caja.querySelector('.in-fecha-pago');
            if (chk.checked) {
                if (campo && !campo.value) campo.value = HOY;
                caja.style.display = '';
            } else {
                caja.style.display = 'none';
            }
        }

        var nuevoGastoSeq = 1;
        function agregarGasto(resId, mult) {
            // Clave temporal para poder subir el comprobante de una fila nueva en el mismo guardado
            var key = 'n' + (nuevoGastoSeq++);
            var tr = document.createElement('tr');
            tr.className = 'gasto-row';
            tr.dataset.tipo = 'Manual'; tr.dataset.mult = (mult || 1); tr.dataset.uni = '';
            tr.innerHTML =
                // Un gasto agregado a mano es plata que ya se gastó: nace con la fecha de
                // hoy puesta y se puede cambiar por el día en que se pagó de verdad.
                '<td data-label="Listo"><span class="cliente-sub">guardá primero</span>' +
                '<div class="fecha-pago-wrap"><input type="date" name="FechasPago" value="' + HOY + '" class="in-fecha-pago" title="El día en que se pagó de verdad" /></div></td>' +
                '<td data-label="Ítem"><input type="hidden" name="Ids" value="0" /><input type="hidden" name="Keys" value="' + key + '" /><input type="hidden" name="GastoReservaIds" value="' + (resId || 0) + '" /><input name="Nombres" placeholder="Ej: Peaje" /></td>' +
                // El campo de cantidad va vacío pero TIENE que estar: al guardar, las listas
                // del formulario se emparejan por posición, así que cada fila debe aportar
                // exactamente un valor a cada lista.
                '<td class="num" data-label="Precio y total"><input type="hidden" name="EsManual" value="1" class="es-manual" /><input type="hidden" name="Cantidades" value="" /><input name="Precios" type="number" step="0.01" min="0" value="" class="in-precio" /><div class="calc-linea"><span class="cliente-sub">total a mano</span></div></td>' +
                '<td data-label="Comprobante"><input type="file" name="comp_' + key + '" accept="image/*,.pdf" class="in-comp" multiple /></td>' +
                '<td><input type="hidden" name="Comentarios" value="" />' +
                '<button type="button" class="btn-mini btn-mini-ghost btn-nota" onclick="abrirNota(this)">📋</button>' +
                '<button type="button" class="btn-mini btn-mini-danger" title="Borrar" onclick="quitarGasto(this)">🗑</button></td>';
            document.getElementById('gastosBody').appendChild(tr);
            pintarNota(tr.querySelector('.btn-nota'));
            tr.querySelector('input[name=Nombres]').focus();
        }
        function quitarGasto(btn) {
            if (!confirm('¿Realmente lo querés borrar?')) return;
            btn.closest('tr').remove(); recalcular();
        }

        // Botones + y − de los ítems que se cuentan por cantidad (arrieros, caballos,
        // guías, traslados). Cambian el multiplicador de la fila y recalculan el total.
        function cambiarCantidad(btn, paso) {
            var tr = btn.closest('.gasto-row');
            var inp = tr.querySelector('.in-cantidad');
            var n = (parseInt(inp.value) || 0) + paso;
            if (n < 0) n = 0;
            inp.value = n;
            tr.dataset.mult = n;
            pintarFila(tr); recalcular();
        }
        // Si escriben la cantidad a mano en vez de usar los botones
        document.addEventListener('input', function (e) {
            if (!e.target.classList.contains('in-cantidad')) return;
            var tr = e.target.closest('.gasto-row');
            tr.dataset.mult = parseInt(e.target.value) || 0;
            pintarFila(tr); recalcular();
        });

        // ---- La nota de cada gasto y de cada proveedor (el botón 📋) ----
        // Funciona igual que en la excursión: el texto vive en un campo escondido de la
        // fila y la ventanita lo lee y lo escribe. Al tocar "Guardar" se guarda el
        // operativo entero, así queda en la base al toque.
        var filaNota = null;

        // Qué campo escondido usa esta fila: los gastos y los proveedores tienen el suyo.
        function campoNota(fila) {
            return fila.querySelector('input[name=Comentarios]') ||
                   fila.querySelector('input[name=ProvComentarios]');
        }

        // De qué es la nota, para ponerlo de título.
        function tituloNota(fila) {
            var g = fila.querySelector('input[name=Nombres]');
            if (g) return (g.value || '').trim();
            var p = fila.querySelector('.prov-tipo');
            return p ? p.textContent.trim().replace(/\s+/g, ' ') : '';
        }

        function pintarNota(btn) {
            if (!btn) return;
            var esc = campoNota(btn.closest('.gasto-row, .prov-row'));
            var hay = esc && esc.value.trim() !== '';
            btn.style.opacity = hay ? '1' : '0.4';
            btn.title = hay ? esc.value : 'Escribir una nota sobre esto';
        }

        function abrirNota(btn) {
            filaNota = btn.closest('.gasto-row, .prov-row');
            var nombre = tituloNota(filaNota);
            document.getElementById('notaTitulo').textContent = nombre ? ('Nota · ' + nombre) : 'Nota';
            var texto = document.getElementById('notaTexto');
            texto.value = campoNota(filaNota).value;
            document.getElementById('modalNota').style.display = 'flex';
            texto.focus();
        }

        function cerrarNota() {
            document.getElementById('modalNota').style.display = 'none';
            filaNota = null;
        }

        function guardarNota() {
            if (!filaNota) return;
            campoNota(filaNota).value = document.getElementById('notaTexto').value;
            pintarNota(filaNota.querySelector('.btn-nota'));
            // El formulario DE LA FILA, no el primero de la página: el menú de arriba tiene
            // el suyo (el botón "Salir") y mandar ése cerraría la sesión sin guardar nada.
            var form = filaNota.closest('form');
            cerrarNota();
            if (form) form.submit();
        }

        document.querySelectorAll('.btn-nota').forEach(pintarNota);

        // Aviso de los traslados y los pasajes: cuando lo cargado no coincide con la gente
        // que viaja (pasajeros + guías; el chofer va aparte porque es contratado). No se
        // toca el número: el que decide es el que está cargando la salida.
        function pintarAvisoCantidad(inp) {
            var caja = inp.parentElement.querySelector('.aviso-cantidad');
            if (!caja) return;
            var sugerida = parseInt(inp.getAttribute('data-sugerida'));
            var cargada = parseInt(inp.value);
            if (isNaN(sugerida) || sugerida < 0 || isNaN(cargada) || cargada === sugerida) {
                caja.textContent = '';
                caja.style.display = 'none';
                return;
            }
            caja.textContent = (cargada < sugerida ? '⚠️ ' : 'ℹ️ ') + caja.getAttribute('data-texto');
            caja.style.color = cargada < sugerida ? 'var(--warn)' : 'var(--muted)';
            caja.style.display = '';
        }
        document.querySelectorAll('.etapa-personas[data-sugerida]').forEach(pintarAvisoCantidad);
        document.addEventListener('input', function (e) {
            if (e.target.classList.contains('etapa-personas')) pintarAvisoCantidad(e.target);
        });

        // Proveedores: "lo que falta" (total - seña - saldo) por bloque
        function recalcularProv() {
            document.querySelectorAll('.prov-row').forEach(function (tr) {
                var total = parseFloat(tr.querySelector('.prov-total')?.value) || 0;
                var sena = parseFloat(tr.querySelector('.prov-sena')?.value) || 0;
                var saldo = parseFloat(tr.querySelector('.prov-saldo')?.value) || 0;
                var falta = Math.max(0, total - sena - saldo);
                var demas = (sena + saldo) - total;
                var cel = tr.querySelector('.prov-pend');
                if (!cel) return;
                if (total <= 0) { cel.textContent = '—'; cel.style.color = 'var(--muted)'; }
                else if (demas > 0.01) { cel.textContent = '⚠ Cargaste ' + money(demas) + ' de más'; cel.style.color = 'var(--warn)'; }
                else if (falta <= 0.01) { cel.textContent = 'Pagado ✔'; cel.style.color = 'var(--ok)'; }
                else { cel.textContent = money(falta); cel.style.color = 'var(--warn)'; }
            });
            recalcular();  // el total de la salida cambia si cambia un total de proveedor
        }
        document.addEventListener('input', function (e) {
            if (e.target.classList.contains('in-precio')) { pintarFila(e.target.closest('.gasto-row')); recalcular(); }
            else if (e.target.classList.contains('chk-listo')) { pintarFechaPago(e.target); recalcular(); }
            // Al cargar una seña o un saldo, si no hay día puesto se propone el de hoy.
            // Si el monto se borra, la fecha se va con él.
            if (e.target.classList.contains('prov-sena') || e.target.classList.contains('prov-saldo')) {
                var esSena = e.target.classList.contains('prov-sena');
                var campoF = e.target.closest('.field').querySelector(esSena ? '.in-fecha-sena' : '.in-fecha-saldo');
                if (campoF) {
                    if ((parseFloat(e.target.value) || 0) > 0) { if (!campoF.value) campoF.value = HOY; }
                    else campoF.value = '';
                }
            }
            if (e.target.classList.contains('prov-total') || e.target.classList.contains('prov-sena') || e.target.classList.contains('prov-saldo')) recalcularProv();
        });
        // Pintar los totales de todas las filas al abrir
        document.querySelectorAll('#gastosBody .gasto-row').forEach(pintarFila);
        recalcularProv();

        // Agregar / quitar filas de hospedaje o restaurante (por pasajero)
        var nuevoProvSeq = 1;
        function agregarProv(tipo) {
            var group = document.querySelector('.prov-group[data-tipo="' + tipo + '"]');
            var base = group.querySelector('.prov-row');
            var clone = base.cloneNode(true);
            var key = 'pnew' + (nuevoProvSeq++);   // clave única para poder subir el comprobante de la fila nueva
            clone.querySelector('input[name=ProvIds]').value = '0';
            var pk = clone.querySelector('input[name=ProvKeys]'); if (pk) pk.value = key;
            var sel = clone.querySelector('select[name=ProvProveedorIds]'); if (sel) sel.value = '0';
            var nue = clone.querySelector('.prov-nuevo'); if (nue) { nue.value = ''; nue.style.display = 'none'; }
            clone.querySelectorAll('.prov-total,.prov-sena,.prov-saldo').forEach(function (i) { i.value = ''; i.readOnly = false; i.style.background = ''; i.dataset.manual = ''; });
            // Las fechas de pago heredadas no valen para la fila nueva: se vacían.
            clone.querySelectorAll('.prov-fecha').forEach(function (i) { i.value = ''; });
            // La nota tampoco se hereda: es de la fila de la que se copió, no de la nueva.
            var notaClon = clone.querySelector('input[name=ProvComentarios]');
            if (notaClon) notaClon.value = '';
            pintarNota(clone.querySelector('.btn-nota'));
            // Filas con cantidad (guía / vehículo): la nueva arranca en 1 y sin precio,
            // para que se complete sola al elegir el proveedor.
            var cPers = clone.querySelector('.etapa-personas'); if (cPers) cPers.value = '1';
            var cPrec = clone.querySelector('.etapa-precio'); if (cPrec) cPrec.value = '';
            var pq = clone.querySelector('.prov-para'); if (pq) pq.value = '0';   // desplegable de reserva
            // renombrar los campos de comprobante con la clave nueva y limpiarlos
            var fSena = clone.querySelector('input[name^="provcompsena_"]'); if (fSena) { fSena.name = 'provcompsena_' + key; fSena.value = ''; }
            var fSaldo = clone.querySelector('input[name^="provcompsaldo_"]'); if (fSaldo) { fSaldo.name = 'provcompsaldo_' + key; fSaldo.value = ''; }
            clone.querySelectorAll('.adjuntos').forEach(function (d) { d.remove(); });  // sacar los comprobantes heredados
            var pend = clone.querySelector('.prov-pend'); if (pend) pend.textContent = '';
            group.appendChild(clone);
            recalcularProv();
        }
        function quitarProv(btn) {
            if (!confirm('¿Realmente lo querés borrar?')) return;
            btn.closest('.prov-row').remove(); recalcularProv();
        }

        // Al elegir un proveedor, el Total se completa solo con "lo que cobra" y queda bloqueado.
        // En una travesía (fila por lugar) lo que se completa es el PRECIO POR PERSONA, y el
        // total sale de multiplicarlo por la cantidad de gente.
        document.addEventListener('change', function (e) {
            if (!e.target.classList.contains('prov-select')) return;
            var fila = e.target.closest('.prov-row');
            var opt = e.target.options[e.target.selectedIndex];
            var precio = parseFloat(opt.getAttribute('data-precio')) || 0;

            // "Otro": aparece el campo para escribir un proveedor que no está en el catálogo.
            // Se da de alta solo al guardar, así queda disponible para la próxima vez.
            var nuevo = fila.querySelector('.prov-nuevo');
            if (nuevo) {
                var esOtro = e.target.value === '-1';
                nuevo.style.display = esOtro ? '' : 'none';
                if (esOtro) { nuevo.focus(); } else { nuevo.value = ''; }
            }

            // Si la fila lleva cantidad (hospedaje de travesía, guía, vehículo), lo que se
            // completa es el precio de CADA UNO y el total sale de multiplicar. Si no,
            // se completa el total directo, como siempre.
            var inPrec = fila.querySelector('.etapa-precio');
            if (inPrec) {
                // El precio del catálogo SÓLO completa el campo si está vacío. Si ya hay un
                // precio cargado (el del tramo, que sale de la travesía) no se toca: elegir
                // quién maneja no cambia lo que sale el viaje, y pisarlo borraba el número
                // que habían puesto a mano.
                var yaTienePrecio = (parseFloat(inPrec.value) || 0) > 0;
                if (precio > 0 && !yaTienePrecio) inPrec.value = precio;
                recalcularEtapa(fila);
            } else {
                var tot = fila.querySelector('.prov-total');
                if (precio > 0) { tot.value = precio; tot.readOnly = true; }
            }
            recalcularProv();
        });

        // Total de una fila "de grupo" = cantidad × precio de cada uno × noches.
        // Sirve igual para el hospedaje de una travesía (personas × precio × noches) y para
        // guías o vehículos (cuántos × lo que cobra cada uno, con noches = 1).
        // Si el total se puso a mano, no se toca.
        function recalcularEtapa(fila) {
            if (!fila) return;
            var tot = fila.querySelector('.prov-total');
            var inPers = fila.querySelector('.etapa-personas');
            var inPrec = fila.querySelector('.etapa-precio');
            if (!tot || !inPers || !inPrec || tot.dataset.manual === '1') return;
            var pers = parseFloat(inPers.value) || 0;
            var pp = parseFloat(inPrec.value) || 0;
            var inNoches = fila.querySelector('.etapa-noches');
            var noches = inNoches ? (parseInt(inNoches.value) || 1) : 1;
            if (noches < 1) noches = 1;
            tot.value = (pers > 0 && pp > 0) ? (pers * pp * noches) : '';
        }
        document.addEventListener('input', function (e) {
            if (!e.target.classList.contains('etapa-personas')
                && !e.target.classList.contains('etapa-precio')
                && !e.target.classList.contains('etapa-noches')) return;
            recalcularEtapa(e.target.closest('.prov-row'));
            recalcularProv();
        });

        // Botón "a mano": desbloquea el total para cambiarlo y deja de recalcularse solo
        function editarTotal(btn) {
            var tot = btn.closest('.field').querySelector('.prov-total');
            tot.readOnly = false;
            tot.dataset.manual = '1';
            tot.focus();
            tot.select();
        }
    </script>
}
