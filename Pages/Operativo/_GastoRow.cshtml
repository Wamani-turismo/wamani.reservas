@model Wamani.Reservas.Pages.Operativo.GastoRowVm
@{
    var g = Model.G;
    var esManual = g.PrecioUnitario is null;
    var tipo = string.IsNullOrWhiteSpace(g.TipoCalculo) ? "Por persona" : g.TipoCalculo;
    var esCantidad = tipo == "Cantidad";
    var uni = tipo == "Por auto" ? "autos" : esCantidad ? "" : "personas";
    var tipoLabel = tipo == "Fijo" ? "Fijo"
        : tipo == "Por auto" ? "Por auto (chofer-guía)"
        : esCantidad ? "Se ajusta con los botones + y −"
        : "Por persona";
    var valorInput = esManual ? g.Precio : (g.PrecioUnitario ?? 0);
    // En los de tipo "Cantidad" el multiplicador es la cantidad cargada, no la gente.
    var mult = esCantidad ? g.CantidadReal() : Model.Mult;
    string Num(decimal m) => m.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    // El día en que se pagó de verdad. Si el gasto ya está tildado y no tiene fecha
    // (los que se cargaron antes de que esto existiera), se propone la de hoy.
    var fechaPago = g.FechaPago?.ToString("yyyy-MM-dd")
        ?? (g.Comprado ? Wamani.Reservas.Services.Reloj.HoyJujuy().ToString("yyyy-MM-dd") : "");
    var estiloFecha = g.Comprado ? "" : "display:none";
}
<tr class="gasto-row" data-tipo="@tipo" data-mult="@mult" data-uni="@uni">
    <td data-label="Listo">
        <input type="checkbox" name="Comprados" value="@g.Id" class="chk-listo" style="width:20px;height:20px" @(g.Comprado ? "checked" : "") />
        @* El día del pago. Va SIEMPRE en el formulario (aunque esté escondido) para que
           todas las filas aporten un valor a la lista y no se desacomoden al guardar. *@
        <div class="fecha-pago-wrap" style="@estiloFecha">
            <input type="date" name="FechasPago" value="@fechaPago" class="in-fecha-pago"
                   title="El día en que se pagó de verdad" />
        </div>
    </td>
    <td data-label="Ítem">
        <input type="hidden" name="Ids" value="@g.Id" />
        <input type="hidden" name="Keys" value="@g.Id" />
        <input type="hidden" name="GastoReservaIds" value="@Model.ReservaId" />
        <input name="Nombres" value="@g.Nombre" />
        <div class="cliente-sub">@tipoLabel</div>
    </td>
    <td class="num" data-label="Precio y total">
        <input type="hidden" name="EsManual" value="@(esManual ? "1" : "0")" class="es-manual" />
        @if (esCantidad)
        {
            @* Arrieros, caballos, guías, traslados: la cantidad la deciden los chicos en
               cada salida, así que se sube y se baja con estos dos botones. *@
            <div class="cant-wrap">
                <button type="button" class="btn-cant" onclick="cambiarCantidad(this,-1)" title="Uno menos">−</button>
                <input name="Cantidades" type="number" step="1" min="0" value="@g.CantidadReal()" class="in-cantidad" />
                <button type="button" class="btn-cant" onclick="cambiarCantidad(this,1)" title="Uno más">+</button>
            </div>
        }
        else
        {
            <input type="hidden" name="Cantidades" value="" />
        }
        <input name="Precios" type="number" step="0.01" min="0" value="@Num(valorInput)" class="in-precio" />
        <div class="calc-linea"></div>
    </td>
    <td data-label="Comprobante">
        <input type="file" name="comp_@g.Id" accept="image/*,.pdf" class="in-comp" multiple />
        <partial name="_Adjuntos" model="@(g.Comprobante ?? "")" />
    </td>
    <td><button type="button" class="btn-mini btn-mini-danger" title="Borrar" onclick="quitarGasto(this)">🗑</button></td>
</tr>
