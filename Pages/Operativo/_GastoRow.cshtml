@model Wamani.Reservas.Pages.Operativo.GastoRowVm
@{
    var g = Model.G;
    var esManual = g.PrecioUnitario is null;
    var tipo = string.IsNullOrWhiteSpace(g.TipoCalculo) ? "Por persona" : g.TipoCalculo;
    var esCantidad = tipo == "Cantidad";
    var uni = tipo == "Por auto" ? "autos" : esCantidad ? "" : "personas";
    var tipoLabel = tipo == "Fijo" ? "Fijo"
        : tipo == "Por auto" ? "Por auto (chofer-guía)"
        : esCantidad ? "Se ajusta con los botones + y −"
        : "Por persona";
    var valorInput = esManual ? g.Precio : (g.PrecioUnitario ?? 0);
    // En los de tipo "Cantidad" el multiplicador es la cantidad cargada, no la gente.
    var mult = esCantidad ? g.CantidadReal() : Model.Mult;
    string Num(decimal m) => m.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    // El día en que se pagó de verdad. Si el gasto ya está tildado y no tiene fecha
    // (los que se cargaron antes de que esto existiera), se propone la de hoy.
    var fechaPago = g.FechaPago?.ToString("yyyy-MM-dd")
        ?? (g.Comprado ? Wamani.Reservas.Services.Reloj.HoyJujuy().ToString("yyyy-MM-dd") : "");
    var estiloFecha = g.Comprado ? "" : "display:none";

    // Gastos que se pagan en dos partes (seña + saldo). No hay nada que tildar: con
    // sólo cargar plata en la seña o en el saldo, el gasto pasa a pagarse en dos veces.
    var conSena = g.ConSena;
    var permiteSena = Model.PermiteSena || conSena;
    var hoyTxt = Wamani.Reservas.Services.Reloj.HoyJujuy().ToString("yyyy-MM-dd");
    var senaPaga = g.Sena > 0;
    var saldoPago = g.Saldo > 0;
    var fSena = g.FechaSena?.ToString("yyyy-MM-dd") ?? (senaPaga ? hoyTxt : "");
    var fSaldo = g.FechaSaldo?.ToString("yyyy-MM-dd") ?? (saldoPago ? hoyTxt : "");
}
<tr class="gasto-row" data-tipo="@tipo" data-mult="@mult" data-uni="@uni">
    <td data-label="Listo">
        @* Pago de una sola vez: se tilda y listo. Si el gasto tiene plata cargada en la
           seña o en el saldo, este tilde se pinta solo y no se puede tocar: lo que manda
           ahí es la plata, igual que en Proveedores. *@
        <input type="checkbox" name="Comprados" value="@g.Id" class="chk-listo" style="width:20px;height:20px" @(g.Comprado ? "checked" : "") />
        @* El día del pago. Va SIEMPRE en el formulario (aunque esté escondido) para que
           todas las filas aporten un valor a la lista y no se desacomoden al guardar. *@
        <div class="fecha-pago-wrap" style="@estiloFecha">
            <input type="date" name="FechasPago" value="@fechaPago" class="in-fecha-pago"
                   title="El día en que se pagó de verdad" />
        </div>
    </td>
    <td data-label="Ítem">
        <input type="hidden" name="Ids" value="@g.Id" />
        <input type="hidden" name="Keys" value="@g.Id" />
        <input type="hidden" name="GastoReservaIds" value="@Model.ReservaId" />
        <input name="Nombres" value="@g.Nombre" />
        <div class="cliente-sub">@tipoLabel</div>
    </td>
    <td class="num" data-label="Precio y total">
        <input type="hidden" name="EsManual" value="@(esManual ? "1" : "0")" class="es-manual" />
        @if (esCantidad)
        {
            @* Arrieros, caballos, guías, traslados: la cantidad la deciden los chicos en
               cada salida, así que se sube y se baja con estos dos botones. *@
            <div class="cant-wrap">
                <button type="button" class="btn-cant" onclick="cambiarCantidad(this,-1)" title="Uno menos">−</button>
                <input name="Cantidades" type="number" step="1" min="0" value="@g.CantidadReal()" class="in-cantidad" />
                <button type="button" class="btn-cant" onclick="cambiarCantidad(this,1)" title="Uno más">+</button>
            </div>
        }
        else
        {
            <input type="hidden" name="Cantidades" value="" />
        }
        <input name="Precios" type="number" step="0.01" min="0" value="@Num(valorInput)" class="in-precio" />
        <div class="calc-linea"></div>
        @* Lo que falta, o el "Pagado" en verde, igual que en Proveedores. Queda vacío
           mientras no haya plata cargada, así la fila no crece de gusto. *@
        <div class="dgl-falta"></div>
    </td>
    @* Seña y saldo, una línea cada uno. Los cuatro campos viajan SIEMPRE (escondidos si
       esta salida no los usa): las listas del formulario se emparejan por posición, así
       que cada fila tiene que aportar un valor a cada una.
       Los cuadraditos no se tildan a mano: se marcan solos cuando hay plata cargada. *@
    <td data-label="Seña y saldo" class="celda-sena">
        @if (permiteSena)
        {
            <div class="dgl">
                <input type="checkbox" class="chk-pago chk-pago-sena" disabled @(senaPaga ? "checked" : "") title="Pagado" />
                <span class="dgl-lbl">Seña</span>
                <input name="GastoSenas" type="number" step="0.01" min="0" value="@Num(g.Sena)" class="in-sena" />
                <input type="date" name="GastoFechasSena" value="@fSena" class="dgl-fecha in-fsena"
                       title="El día en que se pagó la seña" />
            </div>
            <div class="dgl">
                <input type="checkbox" class="chk-pago chk-pago-saldo" disabled @(saldoPago ? "checked" : "") title="Pagado" />
                <span class="dgl-lbl">Saldo</span>
                <input name="GastoSaldos" type="number" step="0.01" min="0" value="@Num(g.Saldo)" class="in-saldo" />
                <input type="date" name="GastoFechasSaldo" value="@fSaldo" class="dgl-fecha in-fsaldo"
                       title="El día en que se pagó el saldo" />
            </div>
        }
        else
        {
            <input type="hidden" name="GastoSenas" value="0" />
            <input type="hidden" name="GastoSaldos" value="0" />
            <input type="hidden" name="GastoFechasSena" value="" />
            <input type="hidden" name="GastoFechasSaldo" value="" />
        }
    </td>
    <td data-label="Comprobante">
        <input type="file" name="comp_@g.Id" accept="image/*,.pdf" class="in-comp" multiple />
        <partial name="_Adjuntos" model="@(g.Comprobante ?? "")" />
    </td>
    <td>
        @* La nota de este gasto en esta salida. El texto viaja escondido y se escribe en
           la ventanita del botón 📋; va SIEMPRE, para no desacomodar las listas del form. *@
        <input type="hidden" name="Comentarios" value="@g.Comentario" />
        <button type="button" class="btn-mini btn-mini-ghost btn-nota" onclick="abrirNota(this)">📋</button>
        <button type="button" class="btn-mini btn-mini-danger" title="Borrar" onclick="quitarGasto(this)">🗑</button>
    </td>
</tr>
