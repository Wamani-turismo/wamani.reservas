@model Wamani.Reservas.Pages.Operativo.ProvRowVm
@{
    var a = Model.Asig;
    var id = a?.Id ?? 0;
    string Num(decimal m) => m.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    string Ico(string t) => t switch { "Guía" => "🧑‍🏫", "Hospedaje" => "🏨", "Restaurante" => "🍽️", "Auto" => "🚐", _ => "•" };

    // Los días en que se pagó de verdad la seña y el saldo. Si ya hay plata cargada y no
    // tienen fecha (lo de antes), se propone la de hoy.
    var hoy = Wamani.Reservas.Services.Reloj.HoyJujuy().ToString("yyyy-MM-dd");
    var fechaSena = a?.FechaSena?.ToString("yyyy-MM-dd") ?? ((a?.Sena ?? 0) > 0 ? hoy : "");
    var fechaSaldo = a?.FechaSaldo?.ToString("yyyy-MM-dd") ?? ((a?.Saldo ?? 0) > 0 ? hoy : "");
}
<div class="prov-row prov-bloque">
    <input type="hidden" name="ProvIds" value="@id" />
    <input type="hidden" name="ProvKeys" value="@Model.Key" />
    <input type="hidden" name="ProvTipos" value="@Model.Tipo" />
    @* El lugar y las noches son de las travesías (fila por lugar): acá van vacíos. Tienen
       que estar igual para que todas las listas del form queden alineadas por posición al
       guardar: cada fila aporta exactamente un valor a cada lista. *@
    <input type="hidden" name="ProvLugares" value="" />
    <input type="hidden" name="ProvNoches" value="" />
    @if (!Model.ConCantidad)
    {
        <input type="hidden" name="ProvPersonas" value="" />
        <input type="hidden" name="ProvPreciosPorPersona" value="" />
    }
    <div class="prov-head">
        <span class="prov-tipo">@Ico(Model.Tipo) @Model.Tipo</span>
        <select name="ProvProveedorIds" class="prov-select">
            <option value="0" data-precio="0">— sin asignar —</option>
            @foreach (var p in Model.Cat)
            {
                <option value="@p.Id" data-precio="@Num(p.Precio)" selected="@(a?.ProveedorId == p.Id)">@p.Nombre</option>
            }
            @* Para cuando el cliente pide algo fuera de lo habitual y el proveedor no está cargado *@
            <option value="-1" data-precio="0">➕ Otro (escribir el nombre)</option>
        </select>
        <input name="ProvNombresNuevos" class="prov-nuevo" type="text" value=""
               placeholder="Nombre del proveedor nuevo" style="display:none" />
        @if (Model.ConPasajero)
        {
            <select name="ProvReservaIds" class="prov-para" title="¿De qué reserva es este servicio?">
                <option value="0">— reserva… —</option>
                @foreach (var res in Model.Reservas)
                {
                    <option value="@res.Id" selected="@(a?.ReservaId == res.Id)">@res.NombreCliente</option>
                }
            </select>
            <input type="hidden" name="ProvParaQuien" value="@a?.ParaQuien" />
        }
        else
        {
            <input type="hidden" name="ProvReservaIds" value="0" />
            <input type="hidden" name="ProvParaQuien" value="@a?.ParaQuien" />
        }
        <span class="prov-falta-wrap">Falta: <strong class="prov-pend"></strong></span>
        @if (Model.ConPasajero || Model.ConCantidad)
        {
            <button type="button" class="btn-mini btn-mini-danger" title="Borrar" onclick="quitarProv(this)">🗑</button>
        }
    </div>
    <div class="prov-grid">
        @if (Model.ConCantidad)
        {
            <div class="field">
                <label>Cuántos</label>
                <input name="ProvPersonas" type="number" step="1" min="0" value="@Model.Cuantos" class="etapa-personas" />
            </div>
            <div class="field">
                <label>Precio de cada uno</label>
                <input name="ProvPreciosPorPersona" type="number" step="0.01" min="0" value="@Num(Model.PrecioCadaUno)" class="etapa-precio" />
            </div>
        }
        <div class="field">
            <label>Total <button type="button" class="prov-edit-total" onclick="editarTotal(this)" title="Cambiar el total a mano">✏️ a mano</button></label>
            <input name="ProvTotales" type="number" step="0.01" min="0" value="@Num(a?.Total ?? 0)" class="prov-total" />
        </div>
        <div class="field">
            <label>Seña ($)</label>
            <input name="ProvSenas" type="number" step="0.01" min="0" value="@Num(a?.Sena ?? 0)" class="prov-sena" />
            @* El día del pago. Va siempre, aunque esté escondido: cada fila tiene que
               aportar un valor a la lista o se mezclan los datos al guardar. *@
            <input type="date" name="ProvFechasSena" value="@fechaSena" class="prov-fecha in-fecha-sena"
                   title="El día en que se pagó la seña" />
        </div>
        <div class="field">
            <label>Comprobante seña</label>
            <input type="file" name="provcompsena_@Model.Key" accept="image/*,.pdf" multiple />
            <partial name="_Adjuntos" model="@(a?.ComprobanteSena ?? "")" />
        </div>
        <div class="field">
            <label>Saldo ($)</label>
            <input name="ProvSaldos" type="number" step="0.01" min="0" value="@Num(a?.Saldo ?? 0)" class="prov-saldo" />
            <input type="date" name="ProvFechasSaldo" value="@fechaSaldo" class="prov-fecha in-fecha-saldo"
                   title="El día en que se pagó el saldo" />
        </div>
        <div class="field">
            <label>Comprobante saldo</label>
            <input type="file" name="provcompsaldo_@Model.Key" accept="image/*,.pdf" multiple />
            <partial name="_Adjuntos" model="@(a?.ComprobanteSaldo ?? "")" />
        </div>
    </div>
</div>
