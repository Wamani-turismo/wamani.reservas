@{
    var pg = (ViewContext.RouteData.Values["page"]?.ToString() ?? "").ToLower();
    string Activo(params string[] bases) =>
        bases.Any(b => pg == b || pg.StartsWith(b + "/")) ? "active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] · Wamani Reservas</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/logo/wamani-icono-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="~/logo/wamani-icono-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/logo/wamani-icono-180.png" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#22332f" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Wamani" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        // Aplicar el estado guardado del menú (colapsado o no) antes de pintar, sin parpadeo
        try { if (localStorage.getItem('sbColapsado') === '1') document.documentElement.classList.add('sb-collapsed'); } catch (e) { }
    </script>
</head>
<body>
    <!-- Íconos del menú (línea, monocromáticos) definidos una sola vez -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
        <symbol id="ic-home" viewBox="0 0 24 24"><path d="M4 12l8-7 8 7"/><path d="M6 10.5V20h12v-9.5"/></symbol>
        <symbol id="ic-reservas" viewBox="0 0 24 24"><rect x="5" y="3.5" width="14" height="17" rx="2"/><path d="M8.5 8h7M8.5 12h7M8.5 16h4.5"/></symbol>
        <symbol id="ic-operativo" viewBox="0 0 24 24"><path d="M7 21V10a5 5 0 0 1 10 0v11z"/><path d="M9.5 6.6a2.5 2.5 0 0 1 5 0"/><path d="M10 21v-4a2 2 0 0 1 4 0v4"/></symbol>
        <symbol id="ic-finanzas" viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="2.5"/><path d="M15.5 11H20v3h-4.5a1.5 1.5 0 0 1 0-3z"/></symbol>
        <symbol id="ic-rentabilidad" viewBox="0 0 24 24"><path d="M4 5v14h16"/><path d="M7 15l3.5-4 3 2L21 6"/></symbol>
        <symbol id="ic-excursiones" viewBox="0 0 24 24"><path d="M3 19h18"/><path d="M3.5 19l5.5-10 3.5 6"/><path d="M11.5 19l4-7 5 7"/></symbol>
        <symbol id="ic-proveedores" viewBox="0 0 24 24"><rect x="2.5" y="7" width="11" height="9" rx="1.5"/><path d="M13.5 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.7"/><circle cx="17.5" cy="18" r="1.7"/></symbol>
        <symbol id="ic-historial" viewBox="0 0 24 24"><path d="M3.5 12a8.5 8.5 0 1 0 2.6-6.1"/><path d="M3.5 4.5V9h4.5"/><path d="M12 8v4.2l3 1.8"/></symbol>
        <symbol id="ic-salidas" viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="16" rx="2.5"/><path d="M4 9.5h16M8.5 3v4M15.5 3v4"/></symbol>
        <symbol id="ic-usuarios" viewBox="0 0 24 24"><circle cx="12" cy="8.5" r="3.7"/><path d="M5 20a7 7 0 0 1 14 0"/></symbol>
        <symbol id="ic-gastos" viewBox="0 0 24 24"><path d="M6 3h12v18l-2.2-1.5-2 1.5-2-1.5-2 1.5-2-1.5L6 21z"/><path d="M9 8.5h6M9 12.5h6"/></symbol>
        <symbol id="ic-caja" viewBox="0 0 24 24"><rect x="3.5" y="7" width="17" height="12.5" rx="2"/><path d="M8 7V4.8h8V7"/><circle cx="12" cy="13.2" r="2.4"/></symbol>
        <symbol id="ic-extra" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M12 8v8M8 12h8"/></symbol>
        <symbol id="ic-compromisos" viewBox="0 0 24 24"><path d="M3 8h13"/><path d="M12.5 4.5 16 8l-3.5 3.5"/><path d="M21 16H8"/><path d="M11.5 12.5 8 16l3.5 3.5"/></symbol>
    </svg>
    <div class="app-shell">
        <!-- ── Menú lateral ─────────────────────────────── -->
        <aside class="sidebar" id="sidebar">
            <div class="sb-top">
                <a class="sb-brand" asp-page="/Index" aria-label="Wamani - Inicio">
                    <img class="brand-logo-full" src="~/logo/logo-completo.webp" alt="Wamani" />
                    <img class="brand-logo-mini" src="~/logo/montana.png" alt="Wamani" />
                </a>
                <button class="sb-toggle" type="button" onclick="toggleColapsar()" title="Achicar / agrandar menú" aria-label="Achicar o agrandar el menú"></button>
            </div>

            <nav class="sb-nav">
                <div class="sb-section">Principal</div>
                <a class="sb-item @Activo("/index")" asp-page="/Index" title="Inicio">
                    <span class="sb-ico"><svg class="ic"><use href="#ic-home"/></svg></span> <span>Inicio</span>
                </a>
                <a class="sb-item @Activo("/reservas")" asp-page="/Reservas/Index" title="Reservas">
                    <span class="sb-ico"><svg class="ic"><use href="#ic-reservas"/></svg></span> <span>Reservas</span>
                </a>
                <a class="sb-item @Activo("/operativo")" asp-page="/Operativo/Index" title="Operativo">
                    <span class="sb-ico"><svg class="ic"><use href="#ic-operativo"/></svg></span> <span>Operativo</span>
                </a>
                <a class="sb-item @Activo("/financiera")" asp-page="/Financiera/Index" title="Finanzas">
                    <span class="sb-ico"><svg class="ic"><use href="#ic-finanzas"/></svg></span> <span>Finanzas</span>
                </a>
                <a class="sb-item @Activo("/gastos")" asp-page="/Gastos/Index" title="Gastos">
                    <span class="sb-ico"><svg class="ic"><use href="#ic-gastos"/></svg></span> <span>Gastos</span>
                </a>
                <a class="sb-item @Activo("/extras")" asp-page="/Extras/Index" title="Ingresos extra">
                    <span class="sb-ico"><svg class="ic"><use href="#ic-extra"/></svg></span> <span>Extra</span>
                </a>
                <a class="sb-item @Activo("/caja")" asp-page="/Caja/Index" title="Caja">
                    <span class="sb-ico"><svg class="ic"><use href="#ic-caja"/></svg></span> <span>Caja</span>
                </a>
                <a class="sb-item @Activo("/compromisos")" asp-page="/Compromisos/Index" title="Compromisos">
                    <span class="sb-ico"><svg class="ic"><use href="#ic-compromisos"/></svg></span> <span>Compromisos</span>
                </a>
                <a class="sb-item @Activo("/rentabilidad")" asp-page="/Rentabilidad/Index" title="Rentabilidad">
                    <span class="sb-ico"><svg class="ic"><use href="#ic-rentabilidad"/></svg></span> <span>Rentabilidad</span>
                </a>
                <a class="sb-item @Activo("/excursiones")" asp-page="/Excursiones/Index" title="Excursiones">
                    <span class="sb-ico"><svg class="ic"><use href="#ic-excursiones"/></svg></span> <span>Excursiones</span>
                </a>
                <a class="sb-item @Activo("/proveedores")" asp-page="/Proveedores/Index" title="Proveedores">
                    <span class="sb-ico"><svg class="ic"><use href="#ic-proveedores"/></svg></span> <span>Proveedores</span>
                </a>
                <a class="sb-item @Activo("/historial")" asp-page="/Historial/Index" title="Historial">
                    <span class="sb-ico"><svg class="ic"><use href="#ic-historial"/></svg></span> <span>Historial</span>
                </a>
                <a class="sb-item @Activo("/salidas")" asp-page="/Salidas" title="Salidas">
                    <span class="sb-ico"><svg class="ic"><use href="#ic-salidas"/></svg></span> <span>Salidas</span>
                </a>
                <a class="sb-item @Activo("/web")" asp-page="/Web/Index" title="Web (página pública)">
                    <span class="sb-ico">🌐</span> <span>Web</span>
                </a>
            </nav>

            <div class="sb-foot">
                <a class="sb-item sb-item-foot @Activo("/usuarios")" asp-page="/Usuarios/Index" title="Usuarios">
                    <span class="sb-ico"><svg class="ic"><use href="#ic-usuarios"/></svg></span> <span>Usuarios</span>
                </a>
            </div>
        </aside>

        <div class="sb-overlay" id="sbOverlay" onclick="toggleSidebar()"></div>

        <!-- ── Área principal ───────────────────────────── -->
        <div class="main-area">
            <header class="topbar2">
                <button class="hamb" type="button" onclick="toggleSidebar()" aria-label="Abrir menú">☰</button>
                <a class="topbar-brand-mobile" asp-page="/Index">Wamani</a>
                <div class="topbar-right">
                    @await Component.InvokeAsync("Recordatorios")
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="user-box">
                            <span class="user-nombre">@User.Identity.Name</span>
                            <form method="post" asp-page="/Logout" style="display:inline">
                                <button type="submit" class="btn-mini btn-mini-ghost" title="Cerrar sesión">Salir</button>
                            </form>
                        </div>
                    }
                </div>
            </header>

            <main class="container">
                @RenderBody()
            </main>

            <footer class="footer">
                <div class="container">Wamani · Sistema de reservas de excursiones</div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        // Menú lateral (abrir/cerrar en celular)
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('abierto');
            document.getElementById('sbOverlay').classList.toggle('abierto');
        }

        // Achicar / agrandar el menú (vista solo íconos) y recordar la elección
        function toggleColapsar() {
            var colapsado = document.documentElement.classList.toggle('sb-collapsed');
            try { localStorage.setItem('sbColapsado', colapsado ? '1' : '0'); } catch (e) { }
        }

        // Panel de recordatorios de cobro (la campanita)
        function toggleRecordatorios(e) {
            if (e) e.stopPropagation();
            var p = document.getElementById('recPanel');
            if (p) p.classList.toggle('abierto');
        }
        document.addEventListener('click', function (e) {
            var panel = document.getElementById('recPanel');
            var cont = e.target.closest('.recordatorios');
            var enModal = e.target.closest('.rec-modal');
            if (panel && !cont && !enModal) panel.classList.remove('abierto');
        });
        function abrirRecModal(id) {
            var m = document.getElementById('recModal-' + id);
            if (m) m.style.display = 'flex';
            var p = document.getElementById('recPanel');
            if (p) p.classList.remove('abierto');
        }
        function cerrarRecModal(id) {
            var m = document.getElementById('recModal-' + id);
            if (m) m.style.display = 'none';
        }
        function cerrarRecModalFondo(e, id) {
            if (e.target === e.currentTarget) cerrarRecModal(id);
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        // Al elegir archivos en cualquier campo de comprobante, mostrar sus nombres
        document.addEventListener('change', function (e) {
            var inp = e.target;
            if (!inp || inp.type !== 'file') return;
            var previo = inp.parentNode ? inp.parentNode.querySelector('.elegidos') : null;
            if (previo) previo.remove();
            if (!inp.files || inp.files.length === 0) return;
            var nombres = Array.prototype.map.call(inp.files, function (f) { return f.name; });
            var div = document.createElement('div');
            div.className = 'elegidos';
            div.textContent = '📎 ' + nombres.length + ' archivo(s): ' + nombres.join(' · ');
            inp.insertAdjacentElement('afterend', div);
        });
    </script>
    <script>
        // Registrar el service worker (hace que la app sea instalable en el celular)
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/sw.js').catch(function () { });
            });
        }
    </script>
</body>
</html>
