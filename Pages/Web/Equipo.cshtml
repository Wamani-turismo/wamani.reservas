@page "/panel-web/equipo"
@model Wamani.Reservas.Pages.Web.EquipoModel
@{
    ViewData["Title"] = "Equipo";
    var editando = Model.Item.Id != 0;
}

<div class="toolbar">
    <div>
        <h1>👥 Equipo</h1>
        <p class="subtitle" style="margin:0">Los integrantes de Wamani que se ven en la web.</p>
    </div>
    <a class="btn btn-ghost" asp-page="/Web/Index">← Volver</a>
</div>

@if (!string.IsNullOrEmpty(Model.Aviso))
{
    <div class="aviso-ok">@Model.Aviso</div>
}

<form method="post" asp-page-handler="Guardar" enctype="multipart/form-data" class="form-card" style="margin-bottom:20px">
    <input type="hidden" asp-for="Item.Id" />
    <h2 class="form-sec">@(editando ? "Editar integrante" : "Agregar integrante")</h2>
    <div class="grid2">
        <div class="campo"><label asp-for="Item.Nombre">Nombre</label><input class="input" asp-for="Item.Nombre" /></div>
        <div class="campo"><label asp-for="Item.Rol">Rol</label><input class="input" asp-for="Item.Rol" placeholder="Guía y fundador" /></div>
    </div>
    <div class="campo">
        <label asp-for="Item.Bio">Descripción</label>
        <textarea class="input" asp-for="Item.Bio" rows="2"></textarea>
    </div>
    <div class="campo">
        <label>Foto</label>
        @if (!string.IsNullOrEmpty(Model.Item.Foto))
        {
            <div style="margin-bottom:8px"><img src="/web/img/@Model.Item.Foto" style="height:90px;border-radius:10px;object-fit:cover" onerror="this.style.display='none'" /></div>
        }
        <input class="input" asp-for="FotoArchivo" type="file" accept="image/*" />
        <small>Ideal una foto donde se vea la cara y el paisaje atrás. Si no subís nada, se mantiene la actual.</small>
    </div>
    <div class="campo" style="max-width:180px"><label asp-for="Item.Orden">Orden</label><input class="input" asp-for="Item.Orden" type="number" /></div>
    <button type="submit" class="btn-nueva">💾 Guardar</button>
    @if (editando)
    {
        <a class="btn btn-ghost" asp-page="/Web/Equipo">Cancelar</a>
    }
</form>

<div class="table-wrap">
    <table class="tabla">
        <thead><tr><th>Foto</th><th>Nombre</th><th>Rol</th><th></th></tr></thead>
        <tbody>
        @foreach (var i in Model.Lista)
        {
            <tr>
                <td data-label="Foto"><img src="/web/img/@i.Foto" style="height:46px;width:46px;border-radius:50%;object-fit:cover" onerror="this.style.display='none'" /></td>
                <td data-label="Nombre"><strong>@i.Nombre</strong></td>
                <td data-label="Rol">@i.Rol</td>
                <td class="acciones" data-label="">
                    <div class="acciones-fila">
                        <a class="btn-mini btn-mini-ghost" asp-page="/Web/Equipo" asp-route-editar="@i.Id">✏️</a>
                        <form method="post" asp-page-handler="Eliminar" asp-route-id="@i.Id" style="display:inline"
                              onsubmit="return confirm('¿Eliminar a @i.Nombre?');">
                            <button type="submit" class="btn-mini btn-mini-danger">🗑</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<style>
.form-card{background:#fff;border:1px solid var(--line,#e6e2d8);border-radius:16px;padding:22px;max-width:760px}
.form-sec{font-size:1.05rem;margin:0 0 12px;padding-bottom:6px;border-bottom:1px solid #eee}
.campo{margin-bottom:14px}
.campo label{display:block;font-weight:600;font-size:.9rem;margin-bottom:5px}
.campo small{display:block;color:#888;font-size:.8rem;margin-top:4px}
.input{width:100%;padding:10px 12px;border:1px solid #d8d3c6;border-radius:10px;font:inherit;background:#fff}
.input:focus{outline:none;border-color:var(--accent,#d2673a)}
.grid2{display:grid;gap:14px;grid-template-columns:1fr 1fr}
@@media(max-width:640px){.grid2{grid-template-columns:1fr}}
</style>
