@page "/panel-web/testimonios"
@model Wamani.Reservas.Pages.Web.TestimoniosModel
@{
    ViewData["Title"] = "Testimonios";
    var editando = Model.Item.Id != 0;
}

<div class="toolbar">
    <div>
        <h1>💬 Testimonios</h1>
        <p class="subtitle" style="margin:0">Los comentarios de viajeros que se ven en la web.</p>
    </div>
    <a class="btn btn-ghost" asp-page="/Web/Index">← Volver</a>
</div>

@if (!string.IsNullOrEmpty(Model.Aviso))
{
    <div class="aviso-ok">@Model.Aviso</div>
}

<form method="post" asp-page-handler="Guardar" class="form-card" style="margin-bottom:20px">
    <input type="hidden" asp-for="Item.Id" />
    <h2 class="form-sec">@(editando ? "Editar testimonio" : "Agregar testimonio")</h2>
    <div class="campo">
        <label asp-for="Item.Texto">Comentario</label>
        <textarea class="input" asp-for="Item.Texto" rows="2" placeholder="Lo que dijo el viajero..."></textarea>
    </div>
    <div class="grid2">
        <div class="campo"><label asp-for="Item.Nombre">Nombre</label><input class="input" asp-for="Item.Nombre" /></div>
        <div class="campo"><label asp-for="Item.Lugar">De dónde / qué hizo</label><input class="input" asp-for="Item.Lugar" placeholder="Buenos Aires · Termas de Jordán" /></div>
    </div>
    <div class="grid2">
        <div class="campo"><label asp-for="Item.Orden">Orden</label><input class="input" asp-for="Item.Orden" type="number" /></div>
        <div class="campo campo-check"><label><input type="checkbox" asp-for="Item.Activo" /> Mostrar en la web</label></div>
    </div>
    <button type="submit" class="btn-nueva">💾 Guardar</button>
    @if (editando)
    {
        <a class="btn btn-ghost" asp-page="/Web/Testimonios">Cancelar</a>
    }
</form>

<div class="table-wrap">
    <table class="tabla">
        <thead><tr><th>Comentario</th><th>Nombre</th><th>Estado</th><th></th></tr></thead>
        <tbody>
        @foreach (var t in Model.Lista)
        {
            <tr style="@(t.Activo ? "" : "opacity:.5")">
                <td data-label="Comentario">@t.Texto</td>
                <td data-label="Nombre"><strong>@t.Nombre</strong><br><small style="color:#999">@t.Lugar</small></td>
                <td data-label="Estado">@(t.Activo ? "✅" : "⛔")</td>
                <td class="acciones" data-label="">
                    <div class="acciones-fila">
                        <a class="btn-mini btn-mini-ghost" asp-page="/Web/Testimonios" asp-route-editar="@t.Id">✏️</a>
                        <form method="post" asp-page-handler="Eliminar" asp-route-id="@t.Id" style="display:inline"
                              onsubmit="return confirm('¿Eliminar este testimonio?');">
                            <button type="submit" class="btn-mini btn-mini-danger">🗑</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<style>
.form-card{background:#fff;border:1px solid var(--line,#e6e2d8);border-radius:16px;padding:22px;max-width:760px}
.form-sec{font-size:1.05rem;margin:0 0 12px;padding-bottom:6px;border-bottom:1px solid #eee}
.campo{margin-bottom:14px}
.campo label{display:block;font-weight:600;font-size:.9rem;margin-bottom:5px}
.campo-check label{font-weight:500;display:flex;gap:8px;align-items:center;cursor:pointer}
.input{width:100%;padding:10px 12px;border:1px solid #d8d3c6;border-radius:10px;font:inherit;background:#fff}
.input:focus{outline:none;border-color:var(--accent,#d2673a)}
.grid2{display:grid;gap:14px;grid-template-columns:1fr 1fr}
@@media(max-width:640px){.grid2{grid-template-columns:1fr}}
</style>
